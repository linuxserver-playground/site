---
/**
 * A past moment, as the visitor's browser sees it: "3 minutes ago", kept current by the layout's script, with the
 * date as its title. The static page carries the date itself, so without the script (or before it runs) the reader
 * sees when, never a relative time frozen at the site's build.
 */
import { formatDate } from '@/lib/format';

interface Props {
  date: Date | string;
  class?: string;
}
const { date, class: className } = Astro.props;
const d = typeof date === 'string' ? new Date(date) : date;
---

<time datetime={d.toISOString()} title={formatDate(d)} data-ago class={className}>{formatDate(d)}</time>
