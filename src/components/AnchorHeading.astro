---
/**
 * A section heading with a stable, human id and a "#" link beside it that appears on hover or focus and
 * copies the section's URL (Layout.astro wires the copy). The ids are a public contract: release notes,
 * Discord embeds and the docs link to them (README, "Anchors").
 */
interface Props {
  id: string;
  as?: 'h2' | 'h3';
  class?: string;
}
const { id, as: Tag = 'h2', class: className = 'text-xl font-semibold tracking-tight' } = Astro.props;
---

<Tag id={id} class:list={['group/anchor', className]}>
  <slot />
  <a href={`#${id}`} class="heading-anchor" aria-label="Copy link to this section" data-anchor>#</a>
</Tag>
