---
/**
 * The docs sidebar: every section, then the current section's pages in their `order`, under their `group`
 * sub-headings. Rendered twice by DocsShell (a collapsed <details> on small screens, a sticky rail on large).
 */
import { docUrl, type SectionView } from '@/lib/docs';
import { getSections } from '@/lib/docs';

interface Props {
  section: SectionView;
  /** Id of the page being read; undefined on the section's own page. */
  currentId?: string;
  /** Suffix for element ids, so two copies on one page stay unique. */
  idSuffix: string;
}
const { section, currentId, idSuffix } = Astro.props;
const sections = await getSections();
const onIndex = !currentId || currentId === section.intro?.id;
const link = 'block rounded-md px-2.5 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:font-medium aria-[current=page]:text-accent-foreground';
---

<nav aria-label="Documentation sections" class="space-y-6">
  <div>
    <h2 class="raft-eyebrow px-2.5" id={`docs-sections-${idSuffix}`}>Sections</h2>
    <ul class="mt-2 space-y-0.5" aria-labelledby={`docs-sections-${idSuffix}`}>
      {
        sections.map((s) => (
          <li>
            <a href={s.url} class={link} aria-current={s.id === section.id ? 'location' : undefined}>
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <h2 class="raft-eyebrow px-2.5" id={`docs-pages-${idSuffix}`}>{section.title}</h2>
    <ul class="mt-2 space-y-0.5" aria-labelledby={`docs-pages-${idSuffix}`}>
      <li>
        <a href={section.url} class={link} aria-current={onIndex ? 'page' : undefined}>Overview</a>
      </li>
      {
        section.groups.map((g) => (
          <li>
            {g.name && <h3 class="mt-4 mb-1.5 px-2.5 font-mono text-[0.6875rem] tracking-wide text-muted-foreground uppercase">{g.name}</h3>}
            <ul class="space-y-0.5">
              {g.pages.map((p) => (
                <li>
                  <a href={docUrl(p)} class={link} aria-current={p.id === currentId ? 'page' : undefined}>
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
