---
/**
 * The frame every documentation page shares, rendered by `article/DocsLayout` (the same component the editor's
 * preview uses): breadcrumbs, the section sidebar, the article with its editing bar and edit link, the
 * previous/next pair and the table of contents. The body is the default slot; `after` renders between the
 * article and previous/next.
 */
import type { MarkdownHeading } from 'astro';
import { Pencil } from 'lucide-react';
import DocsLayout from '@/components/article/DocsLayout';
import EntryBar from '@/components/islands/editor/EntryBar';
import PostBody from '@/components/PostBody.astro';
import { docEditUrl, docNav, docUrl, sectionNav, type Doc, type SectionView } from '@/lib/docs';
import type { Crumb } from '@/lib/seo';

interface Props {
  section: SectionView;
  /** The page being read. Absent on a section page that has no index.md. */
  doc?: Doc;
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  crumbs: Crumb[];
  prev?: Doc;
  next?: Doc;
}
const { section, doc, title, description, headings = [], crumbs, prev, next } = Astro.props;
const sections = await sectionNav();
const currentId = doc?.id;
const onIndex = !currentId || currentId === section.intro?.id;
const hasAfter = Astro.slots.has('after');
---

<DocsLayout
  sections={sections}
  section={docNav(section)}
  currentId={currentId}
  onIndex={onIndex}
  title={title}
  description={description}
  crumbs={crumbs}
  toc={headings.map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }))}
  updated={doc?.data.updated?.toISOString()}
  hasDoc={!!doc}
  prev={prev && { id: prev.id, title: prev.data.title, url: docUrl(prev) }}
  next={next && { id: next.id, title: next.data.title, url: docUrl(next) }}
>
  {doc && <EntryBar slot="bar" client:idle path={`src/content/docs/${doc.id}.md`} kind="doc" title={doc.data.title} />}
  <PostBody>
    <slot />
  </PostBody>
  {
    doc && (
      <a slot="footer" href={docEditUrl(doc)} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-foreground">
        <Pencil className="size-3.5" aria-hidden="true" /> Edit this page on GitHub<span class="sr-only"> (opens in a new tab)</span>
      </a>
    )
  }
  {
    hasAfter && (
      <div slot="after">
        <slot name="after" />
      </div>
    )
  }
</DocsLayout>
