---
/** The images section's tabs: applications, base images and tools, each its own page. */
import { withBase } from '@/lib/base';
import { getApps, getImagesOfKind, IMAGE_KINDS, type ImageKind } from '@/lib/images';

interface Props {
  current: ImageKind;
}
const { current } = Astro.props;
const counts: Record<ImageKind, number> = {
  app: getApps().length,
  base: getImagesOfKind('base').filter((i) => !i.deprecated).length,
  tool: getImagesOfKind('tool').filter((i) => !i.deprecated).length,
};
---

<nav aria-label="Image kinds" class="border-b border-[var(--raft-hair)] bg-background/80 backdrop-blur-xl">
  <div class="raft-container">
    <ul class="-mb-px flex gap-1 overflow-x-auto py-1 [scrollbar-width:thin]">
      {
        (Object.keys(IMAGE_KINDS) as ImageKind[]).map((kind) => (
          <li class="shrink-0">
            <a
              href={withBase(IMAGE_KINDS[kind].href)}
              aria-current={kind === current ? 'page' : undefined}
              class="relative inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-3 aria-[current=page]:after:-bottom-1 aria-[current=page]:after:h-px aria-[current=page]:after:bg-primary"
            >
              {IMAGE_KINDS[kind].label}
              <span class="font-mono text-xs text-muted-foreground tabular-nums">{counts[kind]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
