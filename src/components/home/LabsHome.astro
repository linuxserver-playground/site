---
/**
 * The Labs site's home page (workspace docs/labs.md): what Labs is, every image in Labs, and a pointer to how an app
 * gets in (/propose/, the full guide) and what is on its way (/proposals/: the images in review and, for team members,
 * the open proposals). Rendered by pages/index.astro in Labs mode only.
 */
import Layout from '@/layouts/Layout.astro';
import ImageTile from '@/components/ImageTile.astro';
import SectionHead from '@/components/SectionHead.astro';
import { withBase } from '@/lib/base';
import { getImages } from '@/lib/images';
import { getPending } from '@/lib/pending';
import { MAIN_SITE_URL, SITE } from '@/lib/site';
import { ArrowRight, FlaskConical, ShieldAlert, Sprout } from 'lucide-react';

const images = getImages();
const pending = getPending();
---

<Layout section="home" title={SITE.title} description="LinuxServer Labs publishes newer, less proven self-hosted software on the LinuxServer.io pipeline, outside the main fleet.">
  <section class="relative overflow-hidden border-b border-[var(--raft-hair)]" aria-labelledby="hero-title">
    <div class="raft-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="raft-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="raft-container relative py-16 md:py-24">
      <p class="raft-eyebrow"><span class="text-primary" aria-hidden="true">//</span> LinuxServer Labs</p>
      <h1 id="hero-title" class="mt-4 max-w-3xl text-[2.3rem] leading-[1.05] font-semibold tracking-[-0.04em] sm:text-6xl">
        New self-hosted software, on the LinuxServer pipeline.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Labs is where applications too new or too small for the main LinuxServer.io fleet get a proper container: the same base images, build pipeline and
        tests, published so people can use them and get to know them. The good, popular and maintained ones graduate to the main fleet.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/images/')} class="inline-flex h-10 items-center gap-2 rounded-md bg-foreground px-4 text-sm font-medium text-background hover:opacity-90">
          Browse the images <ArrowRight className="size-4" aria-hidden="true" />
        </a>
        <a href={withBase('/propose/')} class="inline-flex h-10 items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] px-4 text-sm font-medium hover:bg-muted">
          Propose an application
        </a>
      </div>
    </div>
  </section>

  <section class="raft-container pt-20" aria-labelledby="what">
    <SectionHead eyebrow="What Labs is" title="Reviewed builds of unaudited software" id="what" />
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <div class="raft-panel p-5">
        <FlaskConical className="size-5 text-primary" aria-hidden="true" />
        <h3 class="mt-3 font-semibold">The same pipeline</h3>
        <p class="mt-2 text-sm text-muted-foreground">
          Every Labs image is built, tested and released by the workflows the main fleet uses, on the LinuxServer base images, with every build's layers, files,
          packages and tests published here.
        </p>
      </div>
      <div class="raft-panel p-5">
        <ShieldAlert className="size-5 text-primary" aria-hidden="true" />
        <h3 class="mt-3 font-semibold">Not security reviewed</h3>
        <p class="mt-2 text-sm text-muted-foreground">
          The LinuxServer team reviews every change to a Labs repository, but not the application: its code and the release files the image downloads are used
          as upstream publishes them. Understand what an application does before you run it, and protect it before you expose it.
        </p>
      </div>
      <div class="raft-panel p-5">
        <Sprout className="size-5 text-primary" aria-hidden="true" />
        <h3 class="mt-3 font-semibold">A path to the main fleet</h3>
        <p class="mt-2 text-sm text-muted-foreground">
          An image that proves itself, used, maintained and building cleanly, can move to the{' '}
          <a href={MAIN_SITE_URL} class="underline underline-offset-4" target="_blank" rel="noopener">main fleet<span class="sr-only"> (opens in a new tab)</span></a>. One that stops
          working is archived.
        </p>
      </div>
    </div>
  </section>

  <section class="raft-container pt-20" aria-labelledby="images">
    <SectionHead
      eyebrow="Images"
      title={images.length === 1 ? 'One image in Labs' : `${images.length} images in Labs`}
      id="images"
      link={{ label: 'All images', href: withBase('/images/') }}
    />
    {
      images.length ? (
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {images.map((image) => (
            <ImageTile image={image} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-muted-foreground">No image has been published in Labs yet.</p>
      )
    }
  </section>

  <section class="raft-container pt-20" aria-labelledby="get-in">
    <div class="raft-panel relative overflow-hidden p-8 md:p-10">
      <div class="raft-aurora pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="relative grid grid-cols-1 gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div class="max-w-2xl">
          <p class="raft-eyebrow"><span class="text-primary" aria-hidden="true">//</span> Get in</p>
          <h2 id="get-in" class="mt-2 text-2xl font-semibold tracking-tight md:text-[2rem] md:leading-tight">Get your app in Labs</h2>
          <p class="mt-3 text-muted-foreground">
            Open source, self-hosted, released from an organisation's repository and able to run with just its own container: propose it with a form, or let an
            AI agent with the LinuxServer harness check the bar and fill it in with you. The guide covers what qualifies and why, how to build and run the image
            on your own machine first, and every step from the proposal to a published image.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-2 sm:flex-row md:flex-col">
          <a href={withBase('/propose/')} class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-foreground px-5 font-medium text-background hover:opacity-90">
            How to propose an app <ArrowRight className="size-4" aria-hidden="true" />
          </a>
          <a href={withBase('/proposals/')} class="inline-flex h-11 items-center justify-center gap-2 rounded-md border border-[var(--raft-hair-strong)] px-5 font-medium hover:bg-muted">
            {pending.length === 1 ? 'One image in review' : pending.length ? `${pending.length} images in review` : 'Images in review'}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
