  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\n# Runtime Stage\nFROM ghcr.io/linuxserver-playground/baseimage-selkies:arch\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG HANDBRAKE_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"thelamer\"\n\nENV TITLE=HandBrake \\\n    NO_GAMEPAD=true \\\n    PIXELFLUX_WAYLAND=true\n\nRUN \\\n  echo \"**** add icon ****\" && \\\n  curl -o \\\n    /usr/share/selkies/www/icon.png \\\n    https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/handbrake-logo.png && \\\n  echo \"**** install packages ****\" && \\\n  pacman -Sy --noconfirm --needed \\\n   \"handbrake${HANDBRAKE_VERSION:+=$HANDBRAKE_VERSION}\" \\\n    handbrake-cli \\\n    intel-media-sdk \\\n    onevpl-intel-gpu && \\\n  echo \"**** cleanup ****\" && \\\n  printf \\\n    \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" \\\n    > /build_version && \\\n  pacman -Scc --noconfirm && \\\n  rm -rf \\\n    /tmp/* \\\n    /var/cache/pacman/pkg/* \\\n    /var/lib/pacman/sync/*\n\n# add local files and files from buildstage\nCOPY root/ /\n\n# ports and volumes\nVOLUME /config\nEXPOSE 3001\n"
  },
