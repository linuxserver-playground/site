  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:3.24\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG LIDARR_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"Roxedus,thespad\"\n\n# environment settings\nARG LIDARR_BRANCH=\"nightly\"\nENV XDG_CONFIG_HOME=\"/config/xdg\" \\\n  COMPlus_EnableDiagnostics=0 \\\n  TMPDIR=/run/lidarr-temp\n\nRUN \\\n  echo \"**** install packages ****\" && \\\n  apk add -U --upgrade --no-cache \\\n    chromaprint \\\n    icu-libs \\\n    krb5-libs \\\n    sqlite-libs \\\n    xmlstarlet && \\\n  echo \"**** install lidarr ****\" && \\\n  mkdir -p /app/lidarr/bin && \\\n  if [ -z ${LIDARR_RELEASE+x} ]; then \\\n    LIDARR_RELEASE=$(curl -sL \"https://lidarr.servarr.com/v1/update/${LIDARR_BRANCH}/changes?runtime=netcore&os=linuxmusl\" \\\n    | jq -r '.[0].version'); \\\n  fi && \\\n  curl -o \\\n  /tmp/lidarr.tar.gz -L \\\n    \"https://lidarr.servarr.com/v1/update/${LIDARR_BRANCH}/updatefile?version=${LIDARR_RELEASE}&os=linuxmusl&runtime=netcore&arch=x64\" && \\\n  tar xzf \\\n    /tmp/lidarr.tar.gz -C \\\n    /app/lidarr/bin --strip-components=1 && \\\n  echo -e \"UpdateMethod=docker\\nBranch=${LIDARR_BRANCH}\\nPackageVersion=${VERSION}\\nPackageAuthor=[linuxserver.io](https://www.linuxserver.io/)\" > /app/lidarr/package_info && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    /app/lidarr/bin/Lidarr.Update \\\n    /tmp/*\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nEXPOSE 8686\n\nVOLUME /config\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-3.24\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG LIDARR_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"Roxedus,thespad\"\n\n# environment settings\nARG LIDARR_BRANCH=\"nightly\"\nENV XDG_CONFIG_HOME=\"/config/xdg\" \\\n  COMPlus_EnableDiagnostics=0 \\\n  TMPDIR=/run/lidarr-temp\n\nRUN \\\n  echo \"**** install packages ****\" && \\\n  apk add -U --upgrade --no-cache \\\n    chromaprint \\\n    icu-libs \\\n    krb5-libs \\\n    sqlite-libs \\\n    xmlstarlet && \\\n  echo \"**** install lidarr ****\" && \\\n  mkdir -p /app/lidarr/bin && \\\n  if [ -z ${LIDARR_RELEASE+x} ]; then \\\n    LIDARR_RELEASE=$(curl -sL \"https://lidarr.servarr.com/v1/update/${LIDARR_BRANCH}/changes?runtime=netcore&os=linuxmusl\" \\\n    | jq -r '.[0].version'); \\\n  fi && \\\n  curl -o \\\n  /tmp/lidarr.tar.gz -L \\\n    \"https://lidarr.servarr.com/v1/update/${LIDARR_BRANCH}/updatefile?version=${LIDARR_RELEASE}&os=linuxmusl&runtime=netcore&arch=arm64\" && \\\n  tar xzf \\\n    /tmp/lidarr.tar.gz -C \\\n    /app/lidarr/bin --strip-components=1 && \\\n  echo -e \"UpdateMethod=docker\\nBranch=${LIDARR_BRANCH}\\nPackageVersion=${VERSION}\\nPackageAuthor=[linuxserver.io](https://www.linuxserver.io/)\" > /app/lidarr/package_info && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    /app/lidarr/bin/Lidarr.Update \\\n    /tmp/*\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nEXPOSE 8686\n\nVOLUME /config\n"
