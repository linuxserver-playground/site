     "script": "#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\n# create folders\nmkdir -p \\\n    /config/{backup,conf,data,data/tmp,web,logs,plugins}\n\n# set permissions\nlsiown -R abc:abc /config\n"
