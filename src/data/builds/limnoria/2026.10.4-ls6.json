    {
     "name": "init-limnoria-plugin-requirements",
     "type": "oneshot",
     "depends_on": [
      "init-limnoria-config"
     ],
     "source": "image",
     "script": "#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\nPLUGIN_REQUIREMENTS=$(find /config/plugins -maxdepth 2 -name 'requirements.txt')\nif [[ -n \"${PLUGIN_REQUIREMENTS}\" ]]; then\n    apk add --no-cache --virtual=pip-dependencies \\\n        build-base \\\n        cargo \\\n        libffi-dev \\\n        openssl-dev \\\n        python3-dev\n    while IFS= read -r line; do\n        pip install -U --no-cache-dir --find-links https://wheel-index.linuxserver.io/alpine-3.21/ \\\n            -r \"${line}\"\n    done <<<\"${PLUGIN_REQUIREMENTS}\"\n    apk del --purge \\\n        pip-dependencies\n    rm -rf \\\n        /tmp/* \\\n        \"${HOME}\"/.cache \\\n        \"${HOME}\"/.cargo\nfi\n"
