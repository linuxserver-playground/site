  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/unrar:latest AS unrar\n\nENV LSIO_FIRST_PARTY=true\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:3.24\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG MYLAR3_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"aptalca\"\n\nRUN \\\n  echo \"**** install build dependencies ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    build-base \\\n    jpeg-dev \\\n    libffi-dev \\\n    libwebp-dev \\\n    python3-dev \\\n    zlib-dev && \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    jpeg \\\n    libwebp-tools \\\n    nodejs \\\n    python3 \\\n    zlib && \\\n  echo \"**** install mylar3 ****\" && \\\n  if [ -z ${MYLAR3_RELEASE+x} ]; then \\\n    MYLAR3_RELEASE=$(curl -sX GET https://api.github.com/repos/MylarComics/mylar3/commits/nightly \\\n      | jq -r '.sha' | cut -c1-8); \\\n  fi && \\\n  mkdir /app/mylar3 && \\\n  curl -o \\\n    /tmp/mylar3.tar.gz -L \\\n    \"https://github.com/MylarComics/mylar3/archive/${MYLAR3_RELEASE}.tar.gz\" && \\\n  tar xf /tmp/mylar3.tar.gz -C \\\n    /app/mylar3/ --strip-components=1 && \\\n  cd /app/mylar3 && \\\n  python3 -m venv /lsiopy && \\\n  pip install -U --no-cache-dir \\\n    pip \\\n    setuptools && \\\n  pip install --no-cache-dir --find-links https://wheel-index.linuxserver.io/alpine-3.24/ -r requirements.txt && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    $HOME/.cache \\\n    /tmp/*\n\n# add local files\nCOPY root/ /\n\n# add unrar\nCOPY --from=unrar /usr/bin/unrar-ubuntu /usr/bin/unrar\n\n# ports and volumes\nVOLUME /config\nEXPOSE 8090\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/unrar:arm64v8-latest AS unrar\n\nENV LSIO_FIRST_PARTY=true\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-3.24\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG MYLAR3_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"aptalca\"\n\nRUN \\\n  echo \"**** install build dependencies ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    build-base \\\n    jpeg-dev \\\n    libffi-dev \\\n    libwebp-dev \\\n    python3-dev \\\n    zlib-dev && \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    jpeg \\\n    libwebp-tools \\\n    nodejs \\\n    python3 \\\n    zlib && \\\n  echo \"**** install mylar3 ****\" && \\\n  if [ -z ${MYLAR3_RELEASE+x} ]; then \\\n    MYLAR3_RELEASE=$(curl -sX GET https://api.github.com/repos/MylarComics/mylar3/commits/nightly \\\n      | jq -r '.sha' | cut -c1-8); \\\n  fi && \\\n  mkdir /app/mylar3 && \\\n  curl -o \\\n    /tmp/mylar3.tar.gz -L \\\n    \"https://github.com/MylarComics/mylar3/archive/${MYLAR3_RELEASE}.tar.gz\" && \\\n  tar xf /tmp/mylar3.tar.gz -C \\\n    /app/mylar3/ --strip-components=1 && \\\n  cd /app/mylar3 && \\\n  python3 -m venv /lsiopy && \\\n  pip install -U --no-cache-dir \\\n    pip \\\n    setuptools && \\\n  pip install --no-cache-dir --find-links https://wheel-index.linuxserver.io/alpine-3.24/ -r requirements.txt && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    $HOME/.cache \\\n    /tmp/*\n\n# add local files\nCOPY root/ /\n\n# add unrar\nCOPY --from=unrar /usr/bin/unrar-ubuntu /usr/bin/unrar\n\n# ports and volumes\nVOLUME /config\nEXPOSE 8090\n"
