  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:3.22\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG PAIRDROP_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"thespad\"\n\n# environment settings\nENV NODE_ENV=\"production\"\n\nRUN \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    nodejs \\\n    npm && \\\n  echo \"**** install pairdrop ****\" && \\\n  mkdir -p /app/pairdrop && \\\n  if [ -z ${PAIRDROP_RELEASE} ]; then \\\n    PAIRDROP_RELEASE=$(curl -sL \"https://api.github.com/repos/schlagmichdoch/pairdrop/tags\" \\\n    | jq -r '.[0].name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/pairdrop.tar.gz -L \\\n    \"https://github.com/schlagmichdoch/PairDrop/archive/refs/tags/${PAIRDROP_RELEASE}.tar.gz\" && \\\n  tar xf \\\n    /tmp/pairdrop.tar.gz -C \\\n    /app/pairdrop/ --strip-components=1 && \\\n  cd /app/pairdrop && \\\n  chown -R abc:abc ./ && \\\n  su -s /bin/sh abc -c 'HOME=/tmp NODE_ENV=production npm ci' && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    $HOME/.cache \\\n    /tmp/* \\\n    /tmp/.npm\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nEXPOSE 3000\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-3.22\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG PAIRDROP_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"thespad\"\n\n# environment settings\nENV NODE_ENV=\"production\"\n\nRUN \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    nodejs \\\n    npm && \\\n  echo \"**** install pairdrop ****\" && \\\n  mkdir -p /app/pairdrop && \\\n  if [ -z ${PAIRDROP_RELEASE} ]; then \\\n    PAIRDROP_RELEASE=$(curl -sL \"https://api.github.com/repos/schlagmichdoch/pairdrop/tags\" \\\n    | jq -r '.[0].name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/pairdrop.tar.gz -L \\\n    \"https://github.com/schlagmichdoch/PairDrop/archive/refs/tags/${PAIRDROP_RELEASE}.tar.gz\" && \\\n  tar xf \\\n    /tmp/pairdrop.tar.gz -C \\\n    /app/pairdrop/ --strip-components=1 && \\\n  cd /app/pairdrop && \\\n  chown -R abc:abc ./ && \\\n  su -s /bin/sh abc -c 'HOME=/tmp NODE_ENV=production npm ci' && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    $HOME/.cache \\\n    /tmp/* \\\n    /tmp/.npm\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nEXPOSE 3000\n"
