  "dockerfile": {
   "amd64": "FROM ghcr.io/linuxserver-playground/baseimage-selkies:arch\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG PELORUS_RELEASE\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"thelamer\"\n\n# title\nENV TITLE=\"Pelorus\" \\\n    PIXELFLUX_WAYLAND=true \\\n    PIXELFLUX_CU=5000 \\\n    ROOT_PATH=/pelorus\n\nRUN \\\n  echo \"**** add icon ****\" && \\\n  curl -o \\\n    /usr/share/selkies/www/icon.png \\\n    https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/pelorus-logo.png && \\\n  echo \"**** install packages ****\" && \\\n  pacman -Sy --noconfirm --needed \\\n    aurorae \\\n    chromium \\\n    discover \\\n    dolphin \\\n    drawing \\\n    gimp \\\n    git \\\n    gobject-introspection \\\n    inkscape \\\n    kate \\\n    kdenlive \\\n    konsole \\\n    kvantum \\\n    libreoffice \\\n    packagekit \\\n    papirus-icon-theme \\\n    pipewire \\\n    plasma-desktop \\\n    python-gobject \\\n    rust \\\n    wireplumber \\\n    xdg-desktop-portal \\\n    xdg-desktop-portal-kde \\\n    xdg-user-dirs \\\n    xorg-xhost && \\\n  cargo install \\\n    wl-clipboard-rs-tools && \\\n  echo \"**** replace wl-clipboard with rust ****\" && \\\n  mv \\\n    /config/.cargo/bin/wl-* \\\n    /usr/bin/ && \\\n  echo \"**** install pelorus ****\" && \\\n  mkdir -p /tmp/pelorus && \\\n  if [ -z ${PELORUS_RELEASE+x} ]; then \\\n    PELORUS_RELEASE=$(curl -sX GET \"https://api.github.com/repos/linuxserver/pelorus/releases/latest\" \\\n    | jq -r '.tag_name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/pelorus.tar.gz -L \\\n    \"https://github.com/linuxserver/pelorus/archive/${PELORUS_RELEASE}.tar.gz\" && \\\n  tar xf \\\n    /tmp/pelorus.tar.gz -C \\\n    /tmp/pelorus/ --strip-components=1 && \\\n  pip install /tmp/pelorus && \\\n  echo \"**** application tweaks ****\" && \\\n  mv \\\n    /usr/bin/chromium \\\n    /usr/bin/chromium-real && \\\n  setcap -r \\\n    /usr/sbin/kwin_wayland && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    /config/.cache \\\n    /config/.cargo \\\n    /tmp/* \\\n    /var/cache/pacman/pkg/* \\\n    /var/lib/pacman/sync/*\n\n# add local files\nCOPY /root /\nCOPY --from=ghcr.io/linuxserver-playground/selkies-layers:amd64-arch-kwin / /\n\n# ports and volumes\nEXPOSE 3001\n\nVOLUME /config\n"
  },
