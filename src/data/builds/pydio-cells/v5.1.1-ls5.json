  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:edge AS buildstage\n\nENV LSIO_FIRST_PARTY=true\n\nARG CELLS_RELEASE\n\nENV \\\n  HOME=\"/config\" \\\n  CELLS_WORKING_DIR=\"/config\" \\\n  GOPATH=\"/tmp\"\n\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    build-base \\\n    go \\\n    openssl && \\\n  echo \"**** fetch source code ****\" && \\\n  mkdir -p \\\n    /tmp/src/github.com/pydio/cells && \\\n  if [ -z ${CELLS_RELEASE+x} ]; then \\\n    CELLS_RELEASE=$(curl -sX GET https://api.github.com/repos/pydio/cells/releases \\\n      | jq -r '.[] | select(.prerelease != true) | .tag_name' \\\n      | sort -rV | head -1); \\\n  fi && \\\n  curl -o \\\n    /tmp/cells-src.tar.gz -L \\\n    https://github.com/pydio/cells/archive/${CELLS_RELEASE}.tar.gz && \\\n  tar xf \\\n    /tmp/cells-src.tar.gz -C \\\n    /tmp/src/github.com/pydio/cells --strip-components=1 && \\\n  echo \"**** compile cells  ****\" && \\\n  cd /tmp/src/github.com/pydio/cells && \\\n  GOARCH=amd64 GOOS=linux go build -trimpath \\\n    -ldflags \"\\\n    -X github.com/pydio/cells/v4/common.version=${CELLS_RELEASE:1} \\\n    -X github.com/pydio/cells/v4/common.BuildStamp=${BUILD_DATE} \\\n    -X github.com/pydio/cells/v4/common.BuildRevision=${VERSION}\" \\\n    -o /app/cells -x . && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    /tmp/* \\\n    \"${HOME}\"/.cache \\\n    \"${HOME}\"/go\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:3.24\n\nENV LSIO_FIRST_PARTY=true\n\nARG BUILD_DATE\nARG VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"aptalca\"\n\nENV \\\n  HOME=\"/config\" \\\n  CELLS_WORKING_DIR=\"/config\" \\\n  GOPATH=\"/tmp\" \\\n  PATH=/app/:$PATH\n\nRUN \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    openssl && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version\n\nCOPY --from=buildstage /app/cells /app/\n\nCOPY root/ /\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-edge AS buildstage\n\nENV LSIO_FIRST_PARTY=true\n\nARG CELLS_RELEASE\n\nENV \\\n  HOME=\"/config\" \\\n  CELLS_WORKING_DIR=\"/config\" \\\n  GOPATH=\"/tmp\"\n\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    build-base \\\n    go \\\n    openssl && \\\n  echo \"**** fetch source code ****\" && \\\n  mkdir -p \\\n    /tmp/src/github.com/pydio/cells && \\\n  if [ -z ${CELLS_RELEASE+x} ]; then \\\n    CELLS_RELEASE=$(curl -sX GET https://api.github.com/repos/pydio/cells/releases \\\n      | jq -r '.[] | select(.prerelease != true) | .tag_name' \\\n      | sort -rV | head -1); \\\n  fi && \\\n  curl -o \\\n    /tmp/cells-src.tar.gz -L \\\n    https://github.com/pydio/cells/archive/${CELLS_RELEASE}.tar.gz && \\\n  tar xf \\\n    /tmp/cells-src.tar.gz -C \\\n    /tmp/src/github.com/pydio/cells --strip-components=1 && \\\n  echo \"**** compile cells  ****\" && \\\n  cd /tmp/src/github.com/pydio/cells && \\\n  GOARCH=arm64 GOOS=linux go build -trimpath \\\n    -ldflags \"\\\n    -X github.com/pydio/cells/v4/common.version=${CELLS_RELEASE:1} \\\n    -X github.com/pydio/cells/v4/common.BuildStamp=${BUILD_DATE} \\\n    -X github.com/pydio/cells/v4/common.BuildRevision=${VERSION}\" \\\n    -o /app/cells -x . && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    /tmp/* \\\n    \"${HOME}\"/.cache \\\n    \"${HOME}\"/go\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-3.24\n\nENV LSIO_FIRST_PARTY=true\n\nARG BUILD_DATE\nARG VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"aptalca\"\n\nENV \\\n  HOME=\"/config\" \\\n  CELLS_WORKING_DIR=\"/config\" \\\n  GOPATH=\"/tmp\" \\\n  PATH=/app/:$PATH\n\nRUN \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    openssl && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version\n\nCOPY --from=buildstage /app/cells /app/\n\nCOPY root/ /\n"
