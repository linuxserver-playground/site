  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/unrar:latest AS unrar\n\nENV LSIO_FIRST_PARTY=true\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:3.22\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG PYLOAD_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"aptalca\"\n\nENV HOME=\"/config\"\n\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    build-base \\\n    cargo \\\n    curl-dev \\\n    libffi-dev \\\n    libjpeg-turbo-dev \\\n    openssl-dev \\\n    python3-dev \\\n    zlib-dev && \\\n  echo \"**** install packages ****\" && \\\n  apk add --no-cache \\\n    ffmpeg \\\n    gcompat \\\n    libatomic \\\n    libjpeg-turbo \\\n    7zip \\\n    python3 \\\n    sqlite \\\n    tesseract-ocr && \\\n  echo \"**** install pyload ****\" && \\\n  if [ -z ${PYLOAD_VERSION+x} ]; then \\\n    PYLOAD_VERSION=$(curl -sL  https://pypi.python.org/pypi/pyload-ng/json |jq -r '. | .info.version'); \\\n  fi && \\\n  python3 -m venv /lsiopy && \\\n  pip install -U --no-cache-dir \\\n    pip \\\n    wheel && \\\n  pip install -U --no-cache-dir --find-links https://wheel-index.linuxserver.io/alpine-3.22/ \\\n    pyload-ng[all]==\"${PYLOAD_VERSION}\" && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    /tmp/* \\\n    ${HOME}/.cache \\\n    ${HOME}/.cargo\n\n# add local files\nCOPY root/ /\n\n# add unrar\nCOPY --from=unrar /usr/bin/unrar-alpine /usr/bin/unrar\n\n# ports and volumes\nEXPOSE 8000\nVOLUME /config\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/unrar:arm64v8-latest AS unrar\n\nENV LSIO_FIRST_PARTY=true\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-3.22\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG PYLOAD_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"aptalca\"\n\nENV HOME=\"/config\"\n\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    build-base \\\n    cargo \\\n    curl-dev \\\n    libffi-dev \\\n    libjpeg-turbo-dev \\\n    openssl-dev \\\n    python3-dev \\\n    zlib-dev && \\\n  echo \"**** install packages ****\" && \\\n  apk add --no-cache \\\n    ffmpeg \\\n    gcompat \\\n    libatomic \\\n    libjpeg-turbo \\\n    7zip \\\n    python3 \\\n    sqlite \\\n    tesseract-ocr && \\\n  echo \"**** install pyload ****\" && \\\n  if [ -z ${PYLOAD_VERSION+x} ]; then \\\n    PYLOAD_VERSION=$(curl -sL  https://pypi.python.org/pypi/pyload-ng/json |jq -r '. | .info.version'); \\\n  fi && \\\n  python3 -m venv /lsiopy && \\\n  pip install -U --no-cache-dir \\\n    pip \\\n    wheel && \\\n  pip install -U --no-cache-dir --find-links https://wheel-index.linuxserver.io/alpine-3.22/ \\\n    pyload-ng[all]==\"${PYLOAD_VERSION}\" && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    /tmp/* \\\n    ${HOME}/.cache \\\n    ${HOME}/.cargo\n\n# add local files\nCOPY root/ /\n\n# add unrar\nCOPY --from=unrar /usr/bin/unrar-alpine /usr/bin/unrar\n\n# ports and volumes\nEXPOSE 8000\nVOLUME /config\n"
  },
