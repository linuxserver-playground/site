  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:3.21\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG RSNAPSHOT_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"nemchik\"\n\nRUN \\\n  echo \"**** install runtime packages ****\" && \\\n  if [ -z ${RSNAPSHOT_VERSION+x} ]; then \\\n    RSNAPSHOT_VERSION=$(curl -sL \"http://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/APKINDEX.tar.gz\" | tar -xz -C /tmp \\\n    && awk '/^P:rsnapshot$/,/V:/' /tmp/APKINDEX | sed -n 2p | sed 's/^V://'); \\\n  fi && \\\n  apk add --no-cache \\\n    openssh \\\n    rsnapshot==${RSNAPSHOT_VERSION} \\\n    rsync && \\\n  rm -rf /etc/rsnapshot.conf && \\\n  ln -s /config/rsnapshot.conf /etc/rsnapshot.conf && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    /tmp/* \\\n    $HOME/.cache\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nVOLUME /config\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver-playground/baseimage-alpine:arm64v8-3.21\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG RSNAPSHOT_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"nemchik\"\n\nRUN \\\n  echo \"**** install runtime packages ****\" && \\\n  if [ -z ${RSNAPSHOT_VERSION+x} ]; then \\\n    RSNAPSHOT_VERSION=$(curl -sL \"http://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/APKINDEX.tar.gz\" | tar -xz -C /tmp \\\n    && awk '/^P:rsnapshot$/,/V:/' /tmp/APKINDEX | sed -n 2p | sed 's/^V://'); \\\n  fi && \\\n  apk add --no-cache \\\n    openssh \\\n    rsnapshot==${RSNAPSHOT_VERSION} \\\n    rsync && \\\n  rm -rf /etc/rsnapshot.conf && \\\n  ln -s /config/rsnapshot.conf /etc/rsnapshot.conf && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  rm -rf \\\n    /tmp/* \\\n    $HOME/.cache\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nVOLUME /config\n"
