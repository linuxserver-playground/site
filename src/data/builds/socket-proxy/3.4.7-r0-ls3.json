   "amd64": "# syntax=docker/dockerfile:1\n\nFROM docker.io/alpine:3.24\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG HAPROXY_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"thespad\"\n\n# install packages\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache \\\n    alpine-release \\\n    curl \\\n    tzdata && \\\n  if [ -z ${HAPROXY_VERSION+x} ]; then \\\n  HAPROXY_VERSION=$(curl -sL \"http://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/APKINDEX.tar.gz\" | tar -xz -C /tmp \\\n    && awk '/^P:haproxy$/,/V:/' /tmp/APKINDEX | sed -n 2p | sed 's/^V://'); \\\n  fi && \\\n  apk add --no-cache \\\n    haproxy==${HAPROXY_VERSION} && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  apk del --no-cache \\\n    curl && \\\n  rm -rf \\\n    /etc/haproxy \\\n    /tmp/*\n\nENV ALLOW_ARCHIVE=0 \\\n  ALLOW_CHANGES=0 \\\n  ALLOW_EXPORT=0 \\\n  ALLOW_LOGS=0 \\\n  ALLOW_PAUSE=0 \\\n  ALLOW_RESTARTS=0 \\\n  ALLOW_STOP=0 \\\n  ALLOW_START=0 \\\n  ALLOW_TOP=0 \\\n  ALLOW_UNPAUSE=0 \\\n  AUTH=0 \\\n  BUILD=0 \\\n  COMMIT=0 \\\n  CONFIGS=0 \\\n  CONTAINERS=0 \\\n  DISTRIBUTION=0 \\\n  EVENTS=1 \\\n  EXEC=0 \\\n  IMAGES=0 \\\n  INFO=0 \\\n  LOG_LEVEL=info \\\n  NETWORKS=0 \\\n  NODES=0 \\\n  PING=1 \\\n  PLUGINS=0 \\\n  POST=0 \\\n  SECRETS=0 \\\n  SERVICES=0 \\\n  SESSION=0 \\\n  SOCKET_PATH=/var/run/docker.sock \\\n  SWARM=0 \\\n  SYSTEM=0 \\\n  TASKS=0 \\\n  VERSION=1 \\\n  VOLUMES=0 \\\n  LIBPOD_ALLOW_PAUSE=0 \\\n  LIBPOD_ALLOW_POD_PAUSE=0 \\\n  LIBPOD_ALLOW_POD_RESTARTS=0 \\\n  LIBPOD_ALLOW_POD_START=0 \\\n  LIBPOD_ALLOW_POD_STOP=0 \\\n  LIBPOD_ALLOW_POD_UNPAUSE=0 \\\n  LIBPOD_ALLOW_RESTARTS=0 \\\n  LIBPOD_ALLOW_START=0 \\\n  LIBPOD_ALLOW_STOP=0 \\\n  LIBPOD_ALLOW_UNPAUSE=0 \\\n  LIBPOD_CONTAINERS=0 \\\n  LIBPOD_EVENTS=0 \\\n  LIBPOD_EXEC=0 \\\n  LIBPOD_GENERATE=0 \\\n  LIBPOD_IMAGES=0 \\\n  