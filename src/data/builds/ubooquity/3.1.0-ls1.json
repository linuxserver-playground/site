     "source": "image",
     "script": "#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\n# make our folders\nmkdir -p \\\n    /config/fonts\n\n# copy config\nif [[ ! -f /config/preferences.json ]]; then\n    cp /defaults/preferences.json /config/preferences.json\nfi\n\n# permissions\nlsiown -R abc:abc \\\n    /config\n"
    },
    {
     "name": "svc-cron",
     "type": "longrun",
     "depends_on": [
      "init-services"
     ],
     "source": "base"
    },
    {
     "name": "svc-ubooquity",
     "type": "longrun",
     "depends_on": [
      "init-services"
     ],
     "source": "image",
     "script": "#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\nJAVAMEM=${MAXMEM:-512}\nPORT=$(jq -r '.adminPortNumber' < /config/preferences.json)\n\nexec \\\n    s6-notifyoncheck -d -n 300 -w 1000 -c \"nc -z localhost ${PORT:-2203}\" \\\n        cd /app/ubooquity s6-setuidgid abc java -Xmx\"$JAVAMEM\"m \\\n        -jar /app/ubooquity/Ubooquity.jar \\\n        --headless --host 0.0.0.0 --remoteadmin \\\n        --workdir /config\n"
    },
