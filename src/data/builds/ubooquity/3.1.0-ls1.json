  "dockerfile": {
   "amd64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver/baseimage-alpine:3.22\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG UBOOQUITY_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"sparklyballs\"\n\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    unzip && \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    openjdk17-jre && \\\n  echo \"**** install ubooquity ****\" && \\\n  if [ -z ${UBOOQUITY_VERSION+x} ]; then \\\n    UBOOQUITY_VERSION=$(curl -IsL -w %{url_effective} -o /dev/null https://vaemendis.net/ubooquity/service/download.php \\\n    | sed 's|.*Ubooquity-\\([0-9\\.]*\\).zip|\\1|'); \\\n  fi && \\\n  mkdir -p \\\n    /app/ubooquity && \\\n  curl -o \\\n  /tmp/ubooquity.zip -L \\\n    \"https://vaemendis.net/ubooquity/downloads/Ubooquity-${UBOOQUITY_VERSION}.zip\" && \\\n  unzip /tmp/ubooquity.zip -d /app/ubooquity && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    /tmp/*\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nEXPOSE 2202 2203\n\nVOLUME /config\n",
   "arm64": "# syntax=docker/dockerfile:1\n\nFROM ghcr.io/linuxserver/baseimage-alpine:arm64v8-3.22\n\nENV LSIO_FIRST_PARTY=true\n\n# set version label\nARG BUILD_DATE\nARG VERSION\nARG UBOOQUITY_VERSION\nLABEL build_version=\"Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}\"\nLABEL maintainer=\"sparklyballs\"\n\nRUN \\\n  echo \"**** install build packages ****\" && \\\n  apk add --no-cache --virtual=build-dependencies \\\n    unzip && \\\n  echo \"**** install runtime packages ****\" && \\\n  apk add --no-cache \\\n    openjdk17-jre && \\\n  echo \"**** install ubooquity ****\" && \\\n  if [ -z ${UBOOQUITY_VERSION+x} ]; then \\\n    UBOOQUITY_VERSION=$(curl -IsL -w %{url_effective} -o /dev/null https://vaemendis.net/ubooquity/service/download.php \\\n    | sed 's|.*Ubooquity-\\([0-9\\.]*\\).zip|\\1|'); \\\n  fi && \\\n  mkdir -p \\\n    /app/ubooquity && \\\n  curl -o \\\n  /tmp/ubooquity.zip -L \\\n    \"https://vaemendis.net/ubooquity/downloads/Ubooquity-${UBOOQUITY_VERSION}.zip\" && \\\n  unzip /tmp/ubooquity.zip -d /app/ubooquity && \\\n  printf \"Linuxserver.io version: ${VERSION}\\nBuild-date: ${BUILD_DATE}\" > /build_version && \\\n  echo \"**** cleanup ****\" && \\\n  apk del --purge \\\n    build-dependencies && \\\n  rm -rf \\\n    /tmp/*\n\n# copy local files\nCOPY root/ /\n\n# ports and volumes\nEXPOSE 2202 2203\n\nVOLUME /config\n"
  },
