     "script": "#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\n# make our folders\nmkdir -p \\\n    /config/fonts\n\n# copy config\nif [[ ! -f /config/preferences.json ]]; then\n    cp /defaults/preferences.json /config/preferences.json\nfi\n\n# permissions\nlsiown -R abc:abc \\\n    /config\n"
