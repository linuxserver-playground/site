     ],
     "source": "base"
    },
    {
     "name": "svc-wikijs",
     "type": "longrun",
     "depends_on": [
      "init-services"
     ],
     "source": "image",
     "script": "#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\nexport CONFIG_FILE=\"/config/config.yml\"\n\nif [[ -z ${LSIO_NON_ROOT_USER} ]]; then\n    exec \\\n        s6-notifyoncheck -d -n 300 -w 1000 -c \"nc -z localhost 3000\" \\\n            cd /app/wiki s6-setuidgid abc /usr/bin/node server\nelse\n    exec \\\n        s6-notifyoncheck -d -n 300 -w 1000 -c \"nc -z localhost 3000\" \\\n            cd /app/wiki /usr/bin/node server\nfi\n"
    },
