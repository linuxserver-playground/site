 "kubernetes": "# Adguardhome-sync: generated by the hub from https://github.com/linuxserver-playground/docker-adguardhome-sync/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: adguardhome-sync-env\n  labels:\n    app.kubernetes.io/name: adguardhome-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: adguardhome-sync-config\n  labels:\n    app.kubernetes.io/name: adguardhome-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: adguardhome-sync\n  labels:\n    app.kubernetes.io/name: adguardhome-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: adguardhome-sync\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: adguardhome-sync\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: adguardhome-sync\n        image: ghcr.io/linuxserver-playground/adguardhome-sync:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: adguardhome-sync-env\n        ports:\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n        volumeMounts:\n        - name: adguardhome-sync-config\n          mountPath: /config\n      volumes:\n      - name: adguardhome-sync-config\n        persistentVolumeClaim:\n          claimName: adguardhome-sync-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: adguardhome-sync\n  labels:\n    app.kubernetes.io/name: adguardhome-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: adguardhome-sync\n  ports:\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n",
 "quadlet": "# adguardhome-sync.container: generated by the hub from https://github.com/linuxserver-playground/docker-adguardhome-sync/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Adguardhome-sync (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/adguardhome-sync:latest\nContainerName=adguardhome-sync\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=CONFIGFILE=/config/adguardhome-sync.yaml\nVolume=/path/to/adguardhome-sync/config:/config:Z\nPublishPort=8080:8080\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
