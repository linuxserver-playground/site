 "kubernetes": "# Airsonic-advanced: generated by the hub from https://github.com/linuxserver-playground/docker-airsonic-advanced/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/snd: Only needed to pass your host sound device to Airsonic's Java jukebox player. (needs a device plugin or hostPath; not emitted).\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: airsonic-advanced-env\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: airsonic-advanced-config\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: airsonic-advanced-music\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: airsonic-advanced-playlists\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: airsonic-advanced-podcasts\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: airsonic-advanced\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: airsonic-advanced\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: airsonic-advanced\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: airsonic-advanced\n        image: ghcr.io/linuxserver-playground/airsonic-advanced:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: airsonic-advanced-env\n        ports:\n        - name: port-4040\n          containerPort: 4040\n          protocol: TCP\n        volumeMounts:\n        - name: airsonic-advanced-config\n          mountPath: /config\n        - name: airsonic-advanced-music\n          mountPath: /music\n        - name: airsonic-advanced-playlists\n          mountPath: /playlists\n        - name: airsonic-advanced-podcasts\n          mountPath: /podcasts\n      volumes:\n      - name: airsonic-advanced-config\n        persistentVolumeClaim:\n          claimName: airsonic-advanced-config\n      - name: airsonic-advanced-music\n        persistentVolumeClaim:\n          claimName: airsonic-advanced-music\n      - name: airsonic-advanced-playlists\n        persistentVolumeClaim:\n          claimName: airsonic-advanced-playlists\n      - name: airsonic-advanced-podcasts\n        persistentVolumeClaim:\n          claimName: airsonic-advanced-podcasts\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: airsonic-advanced\n  labels:\n    app.kubernetes.io/name: airsonic-advanced\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: airsonic-advanced\n  ports:\n  - name: port-4040\n    port: 4040\n    targetPort: 4040\n    protocol: TCP\n",
 "quadlet": "# airsonic-advanced.container: generated by the hub from https://github.com/linuxserver-playground/docker-airsonic-advanced/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Airsonic-advanced (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/airsonic-advanced:latest\nContainerName=airsonic-advanced\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=CONTEXT_PATH=\n# Environment=JAVA_OPTS=\nVolume=/path/to/airsonic-advanced/config:/config:Z\nVolume=/path/to/music:/music:Z\nVolume=/path/to/playlists:/playlists:Z\nVolume=/path/to/podcasts:/podcasts:Z\n# Volume=/path/to/other media:/media:Z\nPublishPort=4040:4040\n# AddDevice=/dev/snd:/dev/snd\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
