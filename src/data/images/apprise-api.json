 "proxy": {
  "image": "apprise-api",
  "port": 8000,
  "scheme": "http",
  "subdomain": "## Version 2026/11/12\n# make sure that your apprise-api container is named apprise-api\n# make sure that your dns has a cname set for apprise-api\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name apprise-api.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app apprise-api;\n        set $upstream_port 8000;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for apprise-api, generated by the hub from its image.yml.\n# Caddy and the apprise-api container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\napprise-api.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy apprise-api:8000\n\t}\n}\n",
  "traefik": "# Traefik reference config for apprise-api, generated by the hub from its image.yml.\n# Labels for the apprise-api service in your compose file. Traefik's docker provider must reach the apprise-api\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  apprise-api:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.apprise-api.loadbalancer.server.port=8000\n      - traefik.http.routers.apprise-api.rule=Host(`apprise-api.example.com`)\n      - traefik.http.routers.apprise-api.entrypoints=websecure\n      - traefik.http.routers.apprise-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.apprise-api.service=apprise-api\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.apprise-api.middlewares=authelia@docker\n      # - traefik.http.routers.apprise-api.middlewares=authentik@docker\n",
  "config": {
   "port": 8000,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Apprise-api: generated by the hub from https://github.com/linuxserver-playground/docker-apprise-api/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: apprise-api-env\n  labels:\n    app.kubernetes.io/name: apprise-api\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: apprise-api-config\n  labels:\n    app.kubernetes.io/name: apprise-api\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: apprise-api\n  labels:\n    app.kubernetes.io/name: apprise-api\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: apprise-api\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: apprise-api\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: apprise-api\n        image: ghcr.io/linuxserver-playground/apprise-api:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: apprise-api-env\n        ports:\n        - name: port-8000\n          containerPort: 8000\n          protocol: TCP\n        volumeMounts:\n        - name: apprise-api-config\n          mountPath: /config\n      volumes:\n      - name: apprise-api-config\n        persistentVolumeClaim:\n          claimName: apprise-api-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: apprise-api\n  labels:\n    app.kubernetes.io/name: apprise-api\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: apprise-api\n  ports:\n  - name: port-8000\n    port: 8000\n    targetPort: 8000\n    protocol: TCP\n",
 "quadlet": "# apprise-api.container: generated by the hub from https://github.com/linuxserver-playground/docker-apprise-api/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Apprise-api (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/apprise-api:latest\nContainerName=apprise-api\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=APPRISE_ATTACH_SIZE=0\nVolume=/path/to/apprise-api/config:/config:Z\n# Volume=/path/to/apprise-api/attachments:/attachments:Z\nPublishPort=8000:8000\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
