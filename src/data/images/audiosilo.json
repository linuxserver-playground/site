 "kubernetes": "# Audiosilo: generated by the hub from https://github.com/linuxserver-playground/docker-audiosilo/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: audiosilo-env\n  labels:\n    app.kubernetes.io/name: audiosilo\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: audiosilo-config\n  labels:\n    app.kubernetes.io/name: audiosilo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: audiosilo-audiobooks:ro\n  labels:\n    app.kubernetes.io/name: audiosilo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: audiosilo\n  labels:\n    app.kubernetes.io/name: audiosilo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: audiosilo\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: audiosilo\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: audiosilo\n        image: ghcr.io/linuxserver-playground/audiosilo:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: audiosilo-env\n        ports:\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n        volumeMounts:\n        - name: audiosilo-config\n          mountPath: /config\n        - name: audiosilo-audiobooks:ro\n          mountPath: /audiobooks:ro\n      volumes:\n      - name: audiosilo-config\n        persistentVolumeClaim:\n          claimName: audiosilo-config\n      - name: audiosilo-audiobooks:ro\n        persistentVolumeClaim:\n          claimName: audiosilo-audiobooks:ro\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: audiosilo\n  labels:\n    app.kubernetes.io/name: audiosilo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: audiosilo\n  ports:\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n",
 "quadlet": "# audiosilo.container: generated by the hub from https://github.com/linuxserver-playground/docker-audiosilo/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Audiosilo (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/audiosilo:latest\nContainerName=audiosilo\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/audiosilo/config:/config:Z\nVolume=/path/to/audiobooks:/audiobooks:ro:Z\nPublishPort=8080:8080\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
