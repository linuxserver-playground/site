 "proxy": {
  "image": "azahar",
  "port": 3001,
  "scheme": "https",
  "subdomain": "## Version 2026/11/24\n# make sure that your azahar container is named azahar\n# make sure that your dns has a cname set for azahar\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name azahar.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app azahar;\n        set $upstream_port 3001;\n        set $upstream_proto https;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for azahar, generated by the hub from its image.yml.\n# Caddy and the azahar container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nazahar.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy https://azahar:3001 {\n\t\t\ttransport http {\n\t\t\t\ttls_insecure_skip_verify\n\t\t\t}\n\t\t}\n\t}\n}\n",
  "traefik": "# Traefik reference config for azahar, generated by the hub from its image.yml.\n# Labels for the azahar service in your compose file. Traefik's docker provider must reach the azahar\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  azahar:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.azahar.loadbalancer.server.port=3001\n      - traefik.http.services.azahar.loadbalancer.server.scheme=https\n      # The app serves a self-signed certificate: define a serversTransport with insecureSkipVerify: true\n      # in Traefik's file provider (named insecure here) and reference it.\n      - traefik.http.services.azahar.loadbalancer.serverstransport=insecure@file\n      - traefik.http.routers.azahar.rule=Host(`azahar.example.com`)\n      - traefik.http.routers.azahar.entrypoints=websecure\n      - traefik.http.routers.azahar.tls.certresolver=letsencrypt\n      - traefik.http.routers.azahar.service=azahar\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.azahar.middlewares=authelia@docker\n      # - traefik.http.routers.azahar.middlewares=authentik@docker\n",
  "config": {
   "port": 3001,
   "scheme": "https",
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Azahar: generated by the hub from https://github.com/linuxserver-playground/docker-azahar/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: azahar-env\n  labels:\n    app.kubernetes.io/name: azahar\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: azahar-config\n  labels:\n    app.kubernetes.io/name: azahar\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: azahar\n  labels:\n    app.kubernetes.io/name: azahar\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: azahar\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: azahar\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: azahar\n        image: ghcr.io/linuxserver-playground/azahar:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: azahar-env\n        ports:\n        - name: port-3000\n          containerPort: 3000\n          protocol: TCP\n        - name: port-3001\n          containerPort: 3001\n          protocol: TCP\n        volumeMounts:\n        - name: azahar-config\n          mountPath: /config\n      volumes:\n      - name: azahar-config\n        persistentVolumeClaim:\n          claimName: azahar-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: azahar\n  labels:\n    app.kubernetes.io/name: azahar\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: azahar\n  ports:\n  - name: port-3000\n    port: 3000\n    targetPort: 3000\n    protocol: TCP\n  - name: port-3001\n    port: 3001\n    targetPort: 3001\n    protocol: TCP\n",
 "quadlet": "# azahar.container: generated by the hub from https://github.com/linuxserver-playground/docker-azahar/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Azahar (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/azahar:latest\nContainerName=azahar\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/config:/config:Z\nPublishPort=3000:3000\nPublishPort=3001:3001\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
