 "kubernetes": "# Beets: generated by the hub from https://github.com/linuxserver-playground/docker-beets/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: beets-env\n  labels:\n    app.kubernetes.io/name: beets\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: beets-config\n  labels:\n    app.kubernetes.io/name: beets\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: beets-music\n  labels:\n    app.kubernetes.io/name: beets\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: beets-downloads\n  labels:\n    app.kubernetes.io/name: beets\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: beets\n  labels:\n    app.kubernetes.io/name: beets\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: beets\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: beets\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: beets\n        image: ghcr.io/linuxserver-playground/beets:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: beets-env\n        ports:\n        - name: port-8337\n          containerPort: 8337\n          protocol: TCP\n        volumeMounts:\n        - name: beets-config\n          mountPath: /config\n        - name: beets-music\n          mountPath: /music\n        - name: beets-downloads\n          mountPath: /downloads\n      volumes:\n      - name: beets-config\n        persistentVolumeClaim:\n          claimName: beets-config\n      - name: beets-music\n        persistentVolumeClaim:\n          claimName: beets-music\n      - name: beets-downloads\n        persistentVolumeClaim:\n          claimName: beets-downloads\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: beets\n  labels:\n    app.kubernetes.io/name: beets\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: beets\n  ports:\n  - name: port-8337\n    port: 8337\n    targetPort: 8337\n    protocol: TCP\n",
 "quadlet": "# beets.container: generated by the hub from https://github.com/linuxserver-playground/docker-beets/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Beets (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/beets:latest\nContainerName=beets\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/beets/config:/config:Z\nVolume=/path/to/music/library:/music:Z\nVolume=/path/to/ingest:/downloads:Z\nPublishPort=8337:8337\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
