 "kubernetes": "# Bitcoin-knots: generated by the hub from https://github.com/linuxserver-playground/docker-bitcoin-knots/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: bitcoin-knots-env\n  labels:\n    app.kubernetes.io/name: bitcoin-knots\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: bitcoin-knots-config\n  labels:\n    app.kubernetes.io/name: bitcoin-knots\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: bitcoin-knots\n  labels:\n    app.kubernetes.io/name: bitcoin-knots\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: bitcoin-knots\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: bitcoin-knots\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: bitcoin-knots\n        image: ghcr.io/linuxserver-playground/bitcoin-knots:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: bitcoin-knots-env\n        ports:\n        - name: port-3000\n          containerPort: 3000\n          protocol: TCP\n        - name: port-3001\n          containerPort: 3001\n          protocol: TCP\n        - name: port-8333\n          containerPort: 8333\n          protocol: TCP\n        volumeMounts:\n        - name: bitcoin-knots-config\n          mountPath: /config\n      volumes:\n      - name: bitcoin-knots-config\n        persistentVolumeClaim:\n          claimName: bitcoin-knots-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: bitcoin-knots\n  labels:\n    app.kubernetes.io/name: bitcoin-knots\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: bitcoin-knots\n  ports:\n  - name: port-3000\n    port: 3000\n    targetPort: 3000\n    protocol: TCP\n  - name: port-3001\n    port: 3001\n    targetPort: 3001\n    protocol: TCP\n  - name: port-8333\n    port: 8333\n    targetPort: 8333\n    protocol: TCP\n",
 "quadlet": "# bitcoin-knots.container: generated by the hub from https://github.com/linuxserver-playground/docker-bitcoin-knots/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Bitcoin-knots (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/bitcoin-knots:latest\nContainerName=bitcoin-knots\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/bitcoin-knots/config:/config:Z\nPublishPort=3000:3000\nPublishPort=3001:3001\nPublishPort=8333:8333\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
