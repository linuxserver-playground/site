 "proxy": {
  "image": "boinc",
  "port": 8080,
  "scheme": "http",
  "subdomain": "## Version 2026/11/10\n# make sure that your boinc container is named boinc\n# make sure that your dns has a cname set for boinc\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name boinc.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app boinc;\n        set $upstream_port 8080;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for boinc, generated by the hub from its image.yml.\n# Caddy and the boinc container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nboinc.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy boinc:8080\n\t}\n}\n",
  "traefik": "# Traefik reference config for boinc, generated by the hub from its image.yml.\n# Labels for the boinc service in your compose file. Traefik's docker provider must reach the boinc\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  boinc:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.boinc.loadbalancer.server.port=8080\n      - traefik.http.routers.boinc.rule=Host(`boinc.example.com`)\n      - traefik.http.routers.boinc.entrypoints=websecure\n      - traefik.http.routers.boinc.tls.certresolver=letsencrypt\n      - traefik.http.routers.boinc.service=boinc\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.boinc.middlewares=authelia@docker\n      # - traefik.http.routers.boinc.middlewares=authentik@docker\n",
  "config": {
   "port": 8080,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Boinc: generated by the hub from https://github.com/linuxserver-playground/docker-boinc/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/dri: Only needed if you want to use your Intel GPU (vaapi). (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: boinc-env\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: boinc-config\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: boinc\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: boinc\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: boinc\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: boinc\n        image: ghcr.io/linuxserver-playground/boinc:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: boinc-env\n        ports:\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n        - name: port-8181\n          containerPort: 8181\n          protocol: TCP\n        volumeMounts:\n        - name: boinc-config\n          mountPath: /config\n      volumes:\n      - name: boinc-config\n        persistentVolumeClaim:\n          claimName: boinc-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: boinc\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: boinc\n  ports:\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n  - name: port-8181\n    port: 8181\n    targetPort: 8181\n    protocol: TCP\n",
 "quadlet": "# boinc.container: generated by the hub from https://github.com/linuxserver-playground/docker-boinc/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Boinc (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/boinc:latest\nContainerName=boinc\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=PASSWORD=\nVolume=/path/to/boinc/config:/config:Z\nPublishPort=8080:8080\nPublishPort=8181:8181\n# AddDevice=/dev/dri:/dev/dri\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
