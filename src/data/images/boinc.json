 "kubernetes": "# Boinc: generated by the hub from https://github.com/linuxserver-playground/docker-boinc/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/dri: Only needed if you want to use your Intel GPU (vaapi). (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: boinc-env\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: boinc-config\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: boinc\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: boinc\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: boinc\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: boinc\n        image: ghcr.io/linuxserver-playground/boinc:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: boinc-env\n        ports:\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n        - name: port-8181\n          containerPort: 8181\n          protocol: TCP\n        volumeMounts:\n        - name: boinc-config\n          mountPath: /config\n      volumes:\n      - name: boinc-config\n        persistentVolumeClaim:\n          claimName: boinc-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: boinc\n  labels:\n    app.kubernetes.io/name: boinc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: boinc\n  ports:\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n  - name: port-8181\n    port: 8181\n    targetPort: 8181\n    protocol: TCP\n",
 "quadlet": "# boinc.container: generated by the hub from https://github.com/linuxserver-playground/docker-boinc/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Boinc (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/boinc:latest\nContainerName=boinc\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=PASSWORD=\nVolume=/path/to/boinc/config:/config:Z\nPublishPort=8080:8080\nPublishPort=8181:8181\n# AddDevice=/dev/dri:/dev/dri\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
