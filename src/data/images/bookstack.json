 "proxy": {
  "image": "bookstack",
  "port": 80,
  "scheme": "http",
  "subdomain": "## Version 2026/11/13\n# make sure that your bookstack container is named bookstack\n# make sure that your dns has a cname set for bookstack\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name bookstack.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app bookstack;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/11/13\n# make sure that your bookstack container is named bookstack\n# make sure that bookstack is set to work with the base url /bookstack/\n# APP_URL environment variable, set to the full URL including the subfolder, e.g. https://example.com/bookstack\n\nlocation ^~ /bookstack {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app bookstack;\n    set $upstream_port 80;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for bookstack, generated by the hub from its image.yml.\n# Caddy and the bookstack container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nbookstack.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy bookstack:80\n\t}\n}\n\n# Subfolder alternative, https://example.com/bookstack: set bookstack's base URL to /bookstack first.\n# APP_URL environment variable, set to the full URL including the subfolder, e.g. https://example.com/bookstack\n# example.com {\n# \thandle /bookstack* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy bookstack:80\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for bookstack, generated by the hub from its image.yml.\n# Labels for the bookstack service in your compose file. Traefik's docker provider must reach the bookstack\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  bookstack:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.bookstack.loadbalancer.server.port=80\n      - traefik.http.routers.bookstack.rule=Host(`bookstack.example.com`)\n      - traefik.http.routers.bookstack.entrypoints=websecure\n      - traefik.http.routers.bookstack.tls.certresolver=letsencrypt\n      - traefik.http.routers.bookstack.service=bookstack\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.bookstack.middlewares=authelia@docker\n      # - traefik.http.routers.bookstack.middlewares=authentik@docker\n",
  "base_url_note": "APP_URL environment variable, set to the full URL including the subfolder, e.g. https://example.com/bookstack",
  "config": {
   "port": 80,
   "subdomain": true,
   "subfolder": {
    "supported": true,
    "base_url_note": "APP_URL environment variable, set to the full URL including the subfolder, e.g. https://example.com/bookstack"
   }
  }
 },
 "kubernetes": "# Bookstack: generated by the hub from https://github.com/linuxserver-playground/docker-bookstack/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: bookstack-env\n  labels:\n    app.kubernetes.io/name: bookstack\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  APP_URL: ''\n  APP_KEY: ''\n  DB_HOST: ''\n  DB_PORT: '3306'\n  DB_USERNAME: ''\n  DB_PASSWORD: ''\n  DB_DATABASE: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: bookstack-config\n  labels:\n    app.kubernetes.io/name: bookstack\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: bookstack\n  labels:\n    app.kubernetes.io/name: bookstack\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: bookstack\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: bookstack\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: bookstack\n        image: ghcr.io/linuxserver-playground/bookstack:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: bookstack-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: bookstack-config\n          mountPath: /config\n      volumes:\n      - name: bookstack-config\n        persistentVolumeClaim:\n          claimName: bookstack-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: bookstack\n  labels:\n    app.kubernetes.io/name: bookstack\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: bookstack\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# bookstack.container: generated by the hub from https://github.com/linuxserver-playground/docker-bookstack/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Bookstack (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/bookstack:latest\nContainerName=bookstack\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=APP_URL=\nEnvironment=APP_KEY=\nEnvironment=DB_HOST=\nEnvironment=DB_PORT=3306\nEnvironment=DB_USERNAME=\nEnvironment=DB_PASSWORD=\nEnvironment=DB_DATABASE=\n# Environment=QUEUE_CONNECTION=\nVolume=/path/to/bookstack/config:/config:Z\nPublishPort=6875:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
