 "proxy": {
  "image": "calibre-web",
  "port": 8083,
  "scheme": "http",
  "subdomain": "## Version 2026/10/30\n# make sure that your calibre-web container is named calibre-web\n# make sure that your dns has a cname set for calibre-web\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name calibre-web.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app calibre-web;\n        set $upstream_port 8083;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/calibre-web)?/opds {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app calibre-web;\n        set $upstream_port 8083;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/calibre-web)?/kobo {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app calibre-web;\n        set $upstream_port 8083;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for calibre-web, generated by the hub from its image.yml.\n# Caddy and the calibre-web container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\ncalibre-web.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /opds /opds/* /kobo /kobo/*\n\thandle @api {\n\t\treverse_proxy calibre-web:8083\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy calibre-web:8083\n\t}\n}\n",
  "traefik": "# Traefik reference config for calibre-web, generated by the hub from its image.yml.\n# Labels for the calibre-web service in your compose file. Traefik's docker provider must reach the calibre-web\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  calibre-web:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.calibre-web.loadbalancer.server.port=8083\n      - traefik.http.routers.calibre-web.rule=Host(`calibre-web.example.com`)\n      - traefik.http.routers.calibre-web.entrypoints=websecure\n      - traefik.http.routers.calibre-web.tls.certresolver=letsencrypt\n      - traefik.http.routers.calibre-web.service=calibre-web\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.calibre-web.middlewares=authelia@docker\n      # - traefik.http.routers.calibre-web.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.calibre-web-api.rule=Host(`calibre-web.example.com`) && (PathPrefix(`/opds`) || PathPrefix(`/kobo`))\n      - traefik.http.routers.calibre-web-api.entrypoints=websecure\n      - traefik.http.routers.calibre-web-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.calibre-web-api.service=calibre-web\n      - traefik.http.routers.calibre-web-api.priority=100\n",
  "config": {
   "port": 8083,
   "subdomain": true,
   "subfolder": {
    "supported": false
   },
   "api_locations": [
    "/opds",
    "/kobo"
   ]
  }
 },
 "kubernetes": "# Calibre-web: generated by the hub from https://github.com/linuxserver-playground/docker-calibre-web/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: calibre-web-env\n  labels:\n    app.kubernetes.io/name: calibre-web\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: calibre-web-config\n  labels:\n    app.kubernetes.io/name: calibre-web\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: calibre-web-books\n  labels:\n    app.kubernetes.io/name: calibre-web\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: calibre-web\n  labels:\n    app.kubernetes.io/name: calibre-web\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: calibre-web\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: calibre-web\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: calibre-web\n        image: ghcr.io/linuxserver-playground/calibre-web:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: calibre-web-env\n        ports:\n        - name: port-8083\n          containerPort: 8083\n          protocol: TCP\n        volumeMounts:\n        - name: calibre-web-config\n          mountPath: /config\n        - name: calibre-web-books\n          mountPath: /books\n      volumes:\n      - name: calibre-web-config\n        persistentVolumeClaim:\n          claimName: calibre-web-config\n      - name: calibre-web-books\n        persistentVolumeClaim:\n          claimName: calibre-web-books\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: calibre-web\n  labels:\n    app.kubernetes.io/name: calibre-web\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: calibre-web\n  ports:\n  - name: port-8083\n    port: 8083\n    targetPort: 8083\n    protocol: TCP\n",
 "quadlet": "# calibre-web.container: generated by the hub from https://github.com/linuxserver-playground/docker-calibre-web/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Calibre-web (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/calibre-web:latest\nContainerName=calibre-web\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=DOCKER_MODS=linuxserver/mods:universal-calibre\n# Environment=OAUTHLIB_RELAX_TOKEN_SCOPE=1\nVolume=/path/to/calibre-web/data:/config:Z\nVolume=/path/to/calibre/library:/books:Z\nPublishPort=8083:8083\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
