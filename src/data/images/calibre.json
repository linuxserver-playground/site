 "proxy": {
  "image": "calibre",
  "port": 8080,
  "scheme": "http",
  "subdomain": "## Version 2026/10/30\n# make sure that your calibre container is named calibre\n# make sure that your dns has a cname set for calibre\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name calibre.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app calibre;\n        set $upstream_port 8080;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/calibre)?/content-server {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app calibre;\n        set $upstream_port 8080;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for calibre, generated by the hub from its image.yml.\n# Caddy and the calibre container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\ncalibre.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /content-server /content-server/*\n\thandle @api {\n\t\treverse_proxy calibre:8080\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy calibre:8080\n\t}\n}\n",
  "traefik": "# Traefik reference config for calibre, generated by the hub from its image.yml.\n# Labels for the calibre service in your compose file. Traefik's docker provider must reach the calibre\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  calibre:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.calibre.loadbalancer.server.port=8080\n      - traefik.http.routers.calibre.rule=Host(`calibre.example.com`)\n      - traefik.http.routers.calibre.entrypoints=websecure\n      - traefik.http.routers.calibre.tls.certresolver=letsencrypt\n      - traefik.http.routers.calibre.service=calibre\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.calibre.middlewares=authelia@docker\n      # - traefik.http.routers.calibre.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.calibre-api.rule=Host(`calibre.example.com`) && (PathPrefix(`/content-server`))\n      - traefik.http.routers.calibre-api.entrypoints=websecure\n      - traefik.http.routers.calibre-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.calibre-api.service=calibre\n      - traefik.http.routers.calibre-api.priority=100\n",
  "config": {
   "port": 8080,
   "subdomain": true,
   "subfolder": {
    "supported": false
   },
   "api_locations": [
    "/content-server"
   ]
  }
 },
 "kubernetes": "# Calibre: generated by the hub from https://github.com/linuxserver-playground/docker-calibre/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - security_opt seccomp=unconfined: For Docker Engine only, many modern gui apps need this to function as syscalls are unkown to Docker. (map to a seccompProfile or AppArmor annotation).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: calibre-env\n  labels:\n    app.kubernetes.io/name: calibre\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: calibre-config\n  labels:\n    app.kubernetes.io/name: calibre\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: calibre\n  labels:\n    app.kubernetes.io/name: calibre\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: calibre\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: calibre\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: calibre\n        image: ghcr.io/linuxserver-playground/calibre:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: calibre-env\n        ports:\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n        - name: port-8181\n          containerPort: 8181\n          protocol: TCP\n        - name: port-8081\n          containerPort: 8081\n          protocol: TCP\n        volumeMounts:\n        - name: calibre-config\n          mountPath: /config\n      volumes:\n      - name: calibre-config\n        persistentVolumeClaim:\n          claimName: calibre-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: calibre\n  labels:\n    app.kubernetes.io/name: calibre\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: calibre\n  ports:\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n  - name: port-8181\n    port: 8181\n    targetPort: 8181\n    protocol: TCP\n  - name: port-8081\n    port: 8081\n    targetPort: 8081\n    protocol: TCP\n",
 "quadlet": "# calibre.container: generated by the hub from https://github.com/linuxserver-playground/docker-calibre/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Calibre (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/calibre:latest\nContainerName=calibre\nAutoUpdate=registry\n# PodmanArgs=--security-opt seccomp=unconfined\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=PASSWORD=\n# Environment=CLI_ARGS=\nVolume=/path/to/calibre/config:/config:Z\nPublishPort=8080:8080\nPublishPort=8181:8181\nPublishPort=8081:8081\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
