 "kubernetes": "# Code-server: generated by the hub from https://github.com/linuxserver-playground/docker-code-server/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: code-server-env\n  labels:\n    app.kubernetes.io/name: code-server\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: code-server-config\n  labels:\n    app.kubernetes.io/name: code-server\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: code-server\n  labels:\n    app.kubernetes.io/name: code-server\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: code-server\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: code-server\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: code-server\n        image: ghcr.io/linuxserver-playground/code-server:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: code-server-env\n        ports:\n        - name: port-8443\n          containerPort: 8443\n          protocol: TCP\n        volumeMounts:\n        - name: code-server-config\n          mountPath: /config\n      volumes:\n      - name: code-server-config\n        persistentVolumeClaim:\n          claimName: code-server-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: code-server\n  labels:\n    app.kubernetes.io/name: code-server\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: code-server\n  ports:\n  - name: port-8443\n    port: 8443\n    targetPort: 8443\n    protocol: TCP\n",
 "quadlet": "# code-server.container: generated by the hub from https://github.com/linuxserver-playground/docker-code-server/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Code-server (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/code-server:latest\nContainerName=code-server\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=PASSWORD=password\n# Environment=HASHED_PASSWORD=\n# Environment=SUDO_PASSWORD=password\n# Environment=SUDO_PASSWORD_HASH=\n# Environment=PROXY_DOMAIN=code-server.my.domain\n# Environment=DEFAULT_WORKSPACE=/config/workspace\n# Environment=PWA_APPNAME=code-server\nVolume=/path/to/code-server/config:/config:Z\nPublishPort=8443:8443\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
