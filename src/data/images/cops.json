 "kubernetes": "# Cops: generated by the hub from https://github.com/linuxserver-playground/docker-cops/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: cops-env\n  labels:\n    app.kubernetes.io/name: cops\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: cops-config\n  labels:\n    app.kubernetes.io/name: cops\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: cops-books\n  labels:\n    app.kubernetes.io/name: cops\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: cops\n  labels:\n    app.kubernetes.io/name: cops\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: cops\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: cops\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: cops\n        image: ghcr.io/linuxserver-playground/cops:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: cops-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        - name: port-443\n          containerPort: 443\n          protocol: TCP\n        volumeMounts:\n        - name: cops-config\n          mountPath: /config\n        - name: cops-books\n          mountPath: /books\n      volumes:\n      - name: cops-config\n        persistentVolumeClaim:\n          claimName: cops-config\n      - name: cops-books\n        persistentVolumeClaim:\n          claimName: cops-books\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: cops\n  labels:\n    app.kubernetes.io/name: cops\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: cops\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n  - name: port-443\n    port: 443\n    targetPort: 443\n    protocol: TCP\n",
 "quadlet": "# cops.container: generated by the hub from https://github.com/linuxserver-playground/docker-cops/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Cops (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/cops:latest\nContainerName=cops\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/cops/config:/config:Z\nVolume=/path/to/data:/books:Z\nPublishPort=80:80\nPublishPort=443:443\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
