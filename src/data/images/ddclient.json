 "kubernetes": "# Ddclient: generated by the hub from https://github.com/linuxserver-playground/docker-ddclient/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: ddclient-env\n  labels:\n    app.kubernetes.io/name: ddclient\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: ddclient-config\n  labels:\n    app.kubernetes.io/name: ddclient\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: ddclient\n  labels:\n    app.kubernetes.io/name: ddclient\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: ddclient\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: ddclient\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: ddclient\n        image: ghcr.io/linuxserver-playground/ddclient:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: ddclient-env\n        volumeMounts:\n        - name: ddclient-config\n          mountPath: /config\n      volumes:\n      - name: ddclient-config\n        persistentVolumeClaim:\n          claimName: ddclient-config\n  strategy:\n    type: Recreate\n",
 "quadlet": "# ddclient.container: generated by the hub from https://github.com/linuxserver-playground/docker-ddclient/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Ddclient (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/ddclient:latest\nContainerName=ddclient\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/ddclient/config:/config:Z\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
