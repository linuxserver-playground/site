 "kubernetes": "# Deluge: generated by the hub from https://github.com/linuxserver-playground/docker-deluge/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: deluge-env\n  labels:\n    app.kubernetes.io/name: deluge\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: deluge-config\n  labels:\n    app.kubernetes.io/name: deluge\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: deluge-downloads\n  labels:\n    app.kubernetes.io/name: deluge\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: deluge\n  labels:\n    app.kubernetes.io/name: deluge\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: deluge\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: deluge\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: deluge\n        image: ghcr.io/linuxserver-playground/deluge:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: deluge-env\n        ports:\n        - name: port-8112\n          containerPort: 8112\n          protocol: TCP\n        - name: port-6881\n          containerPort: 6881\n          protocol: TCP\n        - name: port-6881\n          containerPort: 6881\n          protocol: UDP\n        volumeMounts:\n        - name: deluge-config\n          mountPath: /config\n        - name: deluge-downloads\n          mountPath: /downloads\n      volumes:\n      - name: deluge-config\n        persistentVolumeClaim:\n          claimName: deluge-config\n      - name: deluge-downloads\n        persistentVolumeClaim:\n          claimName: deluge-downloads\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: deluge\n  labels:\n    app.kubernetes.io/name: deluge\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: deluge\n  ports:\n  - name: port-8112\n    port: 8112\n    targetPort: 8112\n    protocol: TCP\n  - name: port-6881\n    port: 6881\n    targetPort: 6881\n    protocol: TCP\n  - name: port-6881\n    port: 6881\n    targetPort: 6881\n    protocol: UDP\n",
 "quadlet": "# deluge.container: generated by the hub from https://github.com/linuxserver-playground/docker-deluge/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Deluge (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/deluge:latest\nContainerName=deluge\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=DELUGE_LOGLEVEL=error\nVolume=/path/to/deluge/config:/config:Z\nVolume=/path/to/downloads:/downloads:Z\nPublishPort=8112:8112\nPublishPort=6881:6881\nPublishPort=6881:6881/udp\n# PublishPort=58846:58846\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
