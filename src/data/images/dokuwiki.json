 "kubernetes": "# Dokuwiki: generated by the hub from https://github.com/linuxserver-playground/docker-dokuwiki/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: dokuwiki-env\n  labels:\n    app.kubernetes.io/name: dokuwiki\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: dokuwiki-config\n  labels:\n    app.kubernetes.io/name: dokuwiki\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: dokuwiki\n  labels:\n    app.kubernetes.io/name: dokuwiki\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: dokuwiki\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: dokuwiki\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: dokuwiki\n        image: ghcr.io/linuxserver-playground/dokuwiki:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: dokuwiki-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: dokuwiki-config\n          mountPath: /config\n      volumes:\n      - name: dokuwiki-config\n        persistentVolumeClaim:\n          claimName: dokuwiki-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: dokuwiki\n  labels:\n    app.kubernetes.io/name: dokuwiki\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: dokuwiki\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# dokuwiki.container: generated by the hub from https://github.com/linuxserver-playground/docker-dokuwiki/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Dokuwiki (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/dokuwiki:latest\nContainerName=dokuwiki\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/dokuwiki/config:/config:Z\nPublishPort=80:80\n# PublishPort=443:443\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
