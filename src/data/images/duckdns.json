 "kubernetes": "# Duckdns: generated by the hub from https://github.com/linuxserver-playground/docker-duckdns/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - network: host networking is required; hostNetwork is set and no Service is emitted.\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: duckdns-env\n  labels:\n    app.kubernetes.io/name: duckdns\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  SUBDOMAINS: subdomain1,subdomain2\n  TOKEN: token\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: duckdns\n  labels:\n    app.kubernetes.io/name: duckdns\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: duckdns\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: duckdns\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: duckdns\n        image: ghcr.io/linuxserver-playground/duckdns:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: duckdns-env\n      hostNetwork: true\n  strategy:\n    type: Recreate\n",
 "quadlet": "# duckdns.container: generated by the hub from https://github.com/linuxserver-playground/docker-duckdns/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Duckdns (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/duckdns:latest\nContainerName=duckdns\nAutoUpdate=registry\n# Network=host\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=SUBDOMAINS=subdomain1,subdomain2\nEnvironment=TOKEN=token\n# Environment=UPDATE_IP=ipv4\n# Environment=LOG_FILE=false\n# Volume=/path/to/duckdns/config:/config:Z\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
