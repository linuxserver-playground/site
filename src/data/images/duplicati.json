 "kubernetes": "# Duplicati: generated by the hub from https://github.com/linuxserver-playground/docker-duplicati/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: duplicati-env\n  labels:\n    app.kubernetes.io/name: duplicati\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  SETTINGS_ENCRYPTION_KEY: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: duplicati-config\n  labels:\n    app.kubernetes.io/name: duplicati\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: duplicati-backups\n  labels:\n    app.kubernetes.io/name: duplicati\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: duplicati-source\n  labels:\n    app.kubernetes.io/name: duplicati\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: duplicati\n  labels:\n    app.kubernetes.io/name: duplicati\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: duplicati\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: duplicati\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: duplicati\n        image: ghcr.io/linuxserver-playground/duplicati:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: duplicati-env\n        ports:\n        - name: port-8200\n          containerPort: 8200\n          protocol: TCP\n        volumeMounts:\n        - name: duplicati-config\n          mountPath: /config\n        - name: duplicati-backups\n          mountPath: /backups\n        - name: duplicati-source\n          mountPath: /source\n      volumes:\n      - name: duplicati-config\n        persistentVolumeClaim:\n          claimName: duplicati-config\n      - name: duplicati-backups\n        persistentVolumeClaim:\n          claimName: duplicati-backups\n      - name: duplicati-source\n        persistentVolumeClaim:\n          claimName: duplicati-source\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: duplicati\n  labels:\n    app.kubernetes.io/name: duplicati\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: duplicati\n  ports:\n  - name: port-8200\n    port: 8200\n    targetPort: 8200\n    protocol: TCP\n",
 "quadlet": "# duplicati.container: generated by the hub from https://github.com/linuxserver-playground/docker-duplicati/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Duplicati (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/duplicati:latest\nContainerName=duplicati\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=SETTINGS_ENCRYPTION_KEY=\n# Environment=CLI_ARGS=\n# Environment=DUPLICATI__WEBSERVICE_PASSWORD=\nVolume=/path/to/duplicati/config:/config:Z\nVolume=/path/to/backups:/backups:Z\nVolume=/path/to/source:/source:Z\nPublishPort=8200:8200\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
