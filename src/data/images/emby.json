 "proxy": {
  "image": "emby",
  "port": 8096,
  "scheme": "http",
  "subdomain": "## Version 2026/10/26\n# make sure that your emby container is named emby\n# make sure that your dns has a cname set for emby\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name emby.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app emby;\n        set $upstream_port 8096;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for emby, generated by the hub from its image.yml.\n# Caddy and the emby container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nemby.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy emby:8096\n\t}\n}\n",
  "traefik": "# Traefik reference config for emby, generated by the hub from its image.yml.\n# Labels for the emby service in your compose file. Traefik's docker provider must reach the emby\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  emby:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.emby.loadbalancer.server.port=8096\n      - traefik.http.routers.emby.rule=Host(`emby.example.com`)\n      - traefik.http.routers.emby.entrypoints=websecure\n      - traefik.http.routers.emby.tls.certresolver=letsencrypt\n      - traefik.http.routers.emby.service=emby\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.emby.middlewares=authelia@docker\n      # - traefik.http.routers.emby.middlewares=authentik@docker\n",
  "config": {
   "port": 8096,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Emby: generated by the hub from https://github.com/linuxserver-playground/docker-emby/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/dri: Only needed if you want to use your Intel or AMD GPU for hardware accelerated video encoding (vaapi). (needs a device plugin or hostPath; not emitted).\n#   - device /dev/video10: Only needed if you want to use your Raspberry Pi V4L2 video encoding. (needs a device plugin or hostPath; not emitted).\n#   - device /dev/video11: Only needed if you want to use your Raspberry Pi V4L2 video encoding. (needs a device plugin or hostPath; not emitted).\n#   - device /dev/video12: Only needed if you want to use your Raspberry Pi V4L2 video encoding. (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: emby-env\n  labels:\n    app.kubernetes.io/name: emby\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: emby-config\n  labels:\n    app.kubernetes.io/name: emby\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: emby-data-tvshows\n  labels:\n    app.kubernetes.io/name: emby\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: emby-data-movies\n  labels:\n    app.kubernetes.io/name: emby\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: emby\n  labels:\n    app.kubernetes.io/name: emby\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: emby\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: emby\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: emby\n        image: ghcr.io/linuxserver-playground/emby:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: emby-env\n        ports:\n        - name: port-8096\n          containerPort: 8096\n          protocol: TCP\n        volumeMounts:\n        - name: emby-config\n          mountPath: /config\n        - name: emby-data-tvshows\n          mountPath: /data/tvshows\n        - name: emby-data-movies\n          mountPath: /data/movies\n      volumes:\n      - name: emby-config\n        persistentVolumeClaim:\n          claimName: emby-config\n      - name: emby-data-tvshows\n        persistentVolumeClaim:\n          claimName: emby-data-tvshows\n      - name: emby-data-movies\n        persistentVolumeClaim:\n          claimName: emby-data-movies\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: emby\n  labels:\n    app.kubernetes.io/name: emby\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: emby\n  ports:\n  - name: port-8096\n    port: 8096\n    targetPort: 8096\n    protocol: TCP\n",
 "quadlet": "# emby.container: generated by the hub from https://github.com/linuxserver-playground/docker-emby/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Emby (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/emby:latest\nContainerName=emby\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/emby/library:/config:Z\nVolume=/path/to/tvshows:/data/tvshows:Z\nVolume=/path/to/movies:/data/movies:Z\n# Volume=/opt/vc/lib:/opt/vc/lib:Z\nPublishPort=8096:8096\n# PublishPort=8920:8920\n# AddDevice=/dev/dri:/dev/dri\n# AddDevice=/dev/video10:/dev/video10\n# AddDevice=/dev/video11:/dev/video11\n# AddDevice=/dev/video12:/dev/video12\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
