 "proxy": {
  "image": "flexget",
  "port": 5050,
  "scheme": "http",
  "subdomain": "## Version 2026/11/09\n# make sure that your flexget container is named flexget\n# make sure that your dns has a cname set for flexget\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name flexget.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app flexget;\n        set $upstream_port 5050;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/flexget)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app flexget;\n        set $upstream_port 5050;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/11/09\n# make sure that your flexget container is named flexget\n# make sure that flexget is set to work with the base url /flexget/\n\nlocation ^~ /flexget {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app flexget;\n    set $upstream_port 5050;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /flexget/api {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app flexget;\n    set $upstream_port 5050;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for flexget, generated by the hub from its image.yml.\n# Caddy and the flexget container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nflexget.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/*\n\thandle @api {\n\t\treverse_proxy flexget:5050\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy flexget:5050\n\t}\n}\n\n# Subfolder alternative, https://example.com/flexget: set flexget's base URL to /flexget first.\n# example.com {\n# \t# API paths stay open so client applications keep working.\n# \t@api path /flexget/api /flexget/api/*\n# \thandle @api {\n# \t\treverse_proxy flexget:5050\n# \t}\n#\n# \thandle /flexget* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy flexget:5050\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for flexget, generated by the hub from its image.yml.\n# Labels for the flexget service in your compose file. Traefik's docker provider must reach the flexget\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  flexget:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.flexget.loadbalancer.server.port=5050\n      - traefik.http.routers.flexget.rule=Host(`flexget.example.com`)\n      - traefik.http.routers.flexget.entrypoints=websecure\n      - traefik.http.routers.flexget.tls.certresolver=letsencrypt\n      - traefik.http.routers.flexget.service=flexget\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.flexget.middlewares=authelia@docker\n      # - traefik.http.routers.flexget.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.flexget-api.rule=Host(`flexget.example.com`) && (PathPrefix(`/api`))\n      - traefik.http.routers.flexget-api.entrypoints=websecure\n      - traefik.http.routers.flexget-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.flexget-api.service=flexget\n      - traefik.http.routers.flexget-api.priority=100\n",
  "config": {
   "port": 5050,
   "subdomain": true,
   "subfolder": {
    "supported": true
   },
   "api_locations": [
    "/api"
   ]
  }
 },
 "kubernetes": "# Flexget: generated by the hub from https://github.com/linuxserver-playground/docker-flexget/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: flexget-env\n  labels:\n    app.kubernetes.io/name: flexget\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  FG_LOG_LEVEL: info\n  FG_LOG_FILE: /config/flexget.log\n  FG_CONFIG_FILE: /config/.flexget/config.yml\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: flexget-config\n  labels:\n    app.kubernetes.io/name: flexget\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: flexget\n  labels:\n    app.kubernetes.io/name: flexget\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: flexget\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: flexget\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: flexget\n        image: ghcr.io/linuxserver-playground/flexget:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: flexget-env\n        ports:\n        - name: port-5050\n          containerPort: 5050\n          protocol: TCP\n        volumeMounts:\n        - name: flexget-config\n          mountPath: /config\n      volumes:\n      - name: flexget-config\n        persistentVolumeClaim:\n          claimName: flexget-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: flexget\n  labels:\n    app.kubernetes.io/name: flexget\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: flexget\n  ports:\n  - name: port-5050\n    port: 5050\n    targetPort: 5050\n    protocol: TCP\n",
 "quadlet": "# flexget.container: generated by the hub from https://github.com/linuxserver-playground/docker-flexget/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Flexget (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/flexget:latest\nContainerName=flexget\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=FG_LOG_LEVEL=info\nEnvironment=FG_LOG_FILE=/config/flexget.log\nEnvironment=FG_CONFIG_FILE=/config/.flexget/config.yml\n# Environment=FG_WEBUI_PASSWORD=info\nVolume=/path/to/flexget/data:/config:Z\n# Volume=/path/to/downloads:/data:Z\nPublishPort=5050:5050\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
