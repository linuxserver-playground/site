 "kubernetes": "# Foldingathome: generated by the hub from https://github.com/linuxserver-playground/docker-foldingathome/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: foldingathome-env\n  labels:\n    app.kubernetes.io/name: foldingathome\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  ACCOUNT_TOKEN: ''\n  MACHINE_NAME: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: foldingathome-config\n  labels:\n    app.kubernetes.io/name: foldingathome\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: foldingathome\n  labels:\n    app.kubernetes.io/name: foldingathome\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: foldingathome\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: foldingathome\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: foldingathome\n        image: ghcr.io/linuxserver-playground/foldingathome:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: foldingathome-env\n        volumeMounts:\n        - name: foldingathome-config\n          mountPath: /config\n      volumes:\n      - name: foldingathome-config\n        persistentVolumeClaim:\n          claimName: foldingathome-config\n  strategy:\n    type: Recreate\n",
 "quadlet": "# foldingathome.container: generated by the hub from https://github.com/linuxserver-playground/docker-foldingathome/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Foldingathome (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/foldingathome:latest\nContainerName=foldingathome\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=ACCOUNT_TOKEN=\nEnvironment=MACHINE_NAME=\n# Environment=CLI_ARGS=\nVolume=/path/to/foldingathome/data:/config:Z\n# PublishPort=7396:7396\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
