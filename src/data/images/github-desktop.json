 "kubernetes": "# Github-desktop: generated by the hub from https://github.com/linuxserver-playground/docker-github-desktop/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - capability IPC_LOCK: Required for keyring functionality..\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: github-desktop-env\n  labels:\n    app.kubernetes.io/name: github-desktop\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: github-desktop-config\n  labels:\n    app.kubernetes.io/name: github-desktop\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: github-desktop\n  labels:\n    app.kubernetes.io/name: github-desktop\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: github-desktop\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: github-desktop\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: github-desktop\n        image: ghcr.io/linuxserver-playground/github-desktop:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: github-desktop-env\n        ports:\n        - name: port-3000\n          containerPort: 3000\n          protocol: TCP\n        - name: port-3001\n          containerPort: 3001\n          protocol: TCP\n        volumeMounts:\n        - name: github-desktop-config\n          mountPath: /config\n        securityContext:\n          capabilities:\n            add:\n            - IPC_LOCK\n      volumes:\n      - name: github-desktop-config\n        persistentVolumeClaim:\n          claimName: github-desktop-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: github-desktop\n  labels:\n    app.kubernetes.io/name: github-desktop\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: github-desktop\n  ports:\n  - name: port-3000\n    port: 3000\n    targetPort: 3000\n    protocol: TCP\n  - name: port-3001\n    port: 3001\n    targetPort: 3001\n    protocol: TCP\n",
 "quadlet": "# github-desktop.container: generated by the hub from https://github.com/linuxserver-playground/docker-github-desktop/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Github-desktop (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/github-desktop:latest\nContainerName=github-desktop\nAutoUpdate=registry\nAddCapability=IPC_LOCK\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/github-desktop/config:/config:Z\nPublishPort=3000:3000\nPublishPort=3001:3001\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
