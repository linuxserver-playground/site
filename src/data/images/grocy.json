 "proxy": {
  "image": "grocy",
  "port": 80,
  "scheme": "http",
  "subdomain": "## Version 2026/11/22\n# make sure that your grocy container is named grocy\n# make sure that your dns has a cname set for grocy\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name grocy.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app grocy;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/grocy)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app grocy;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for grocy, generated by the hub from its image.yml.\n# Caddy and the grocy container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\ngrocy.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/*\n\thandle @api {\n\t\treverse_proxy grocy:80\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy grocy:80\n\t}\n}\n",
  "traefik": "# Traefik reference config for grocy, generated by the hub from its image.yml.\n# Labels for the grocy service in your compose file. Traefik's docker provider must reach the grocy\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  grocy:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.grocy.loadbalancer.server.port=80\n      - traefik.http.routers.grocy.rule=Host(`grocy.example.com`)\n      - traefik.http.routers.grocy.entrypoints=websecure\n      - traefik.http.routers.grocy.tls.certresolver=letsencrypt\n      - traefik.http.routers.grocy.service=grocy\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.grocy.middlewares=authelia@docker\n      # - traefik.http.routers.grocy.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.grocy-api.rule=Host(`grocy.example.com`) && (PathPrefix(`/api`))\n      - traefik.http.routers.grocy-api.entrypoints=websecure\n      - traefik.http.routers.grocy-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.grocy-api.service=grocy\n      - traefik.http.routers.grocy-api.priority=100\n",
  "config": {
   "port": 80,
   "subdomain": true,
   "subfolder": {
    "supported": false
   },
   "api_locations": [
    "/api"
   ]
  }
 },
 "kubernetes": "# Grocy: generated by the hub from https://github.com/linuxserver-playground/docker-grocy/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: grocy-env\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: grocy-config\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: grocy\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: grocy\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: grocy\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: grocy\n        image: ghcr.io/linuxserver-playground/grocy:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: grocy-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: grocy-config\n          mountPath: /config\n      volumes:\n      - name: grocy-config\n        persistentVolumeClaim:\n          claimName: grocy-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: grocy\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: grocy\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# grocy.container: generated by the hub from https://github.com/linuxserver-playground/docker-grocy/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Grocy (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/grocy:latest\nContainerName=grocy\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/grocy/config:/config:Z\nPublishPort=9283:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
