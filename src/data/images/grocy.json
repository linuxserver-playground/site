 "kubernetes": "# Grocy: generated by the hub from https://github.com/linuxserver-playground/docker-grocy/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: grocy-env\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: grocy-config\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: grocy\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: grocy\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: grocy\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: grocy\n        image: ghcr.io/linuxserver-playground/grocy:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: grocy-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: grocy-config\n          mountPath: /config\n      volumes:\n      - name: grocy-config\n        persistentVolumeClaim:\n          claimName: grocy-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: grocy\n  labels:\n    app.kubernetes.io/name: grocy\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: grocy\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# grocy.container: generated by the hub from https://github.com/linuxserver-playground/docker-grocy/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Grocy (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/grocy:latest\nContainerName=grocy\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/grocy/config:/config:Z\nPublishPort=9283:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
