 "proxy": {
  "image": "healthchecks",
  "port": 8000,
  "scheme": "http",
  "subdomain": "## Version 2026/11/08\n# make sure that your healthchecks container is named healthchecks\n# make sure that your dns has a cname set for healthchecks\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name healthchecks.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app healthchecks;\n        set $upstream_port 8000;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for healthchecks, generated by the hub from its image.yml.\n# Caddy and the healthchecks container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nhealthchecks.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy healthchecks:8000\n\t}\n}\n",
  "traefik": "# Traefik reference config for healthchecks, generated by the hub from its image.yml.\n# Labels for the healthchecks service in your compose file. Traefik's docker provider must reach the healthchecks\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  healthchecks:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.healthchecks.loadbalancer.server.port=8000\n      - traefik.http.routers.healthchecks.rule=Host(`healthchecks.example.com`)\n      - traefik.http.routers.healthchecks.entrypoints=websecure\n      - traefik.http.routers.healthchecks.tls.certresolver=letsencrypt\n      - traefik.http.routers.healthchecks.service=healthchecks\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.healthchecks.middlewares=authelia@docker\n      # - traefik.http.routers.healthchecks.middlewares=authentik@docker\n",
  "config": {
   "port": 8000,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Healthchecks: generated by the hub from https://github.com/linuxserver-playground/docker-healthchecks/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: healthchecks-env\n  labels:\n    app.kubernetes.io/name: healthchecks\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  SECRET_KEY: ''\n  SITE_ROOT: ''\n  SITE_NAME: ''\n  SUPERUSER_EMAIL: ''\n  SUPERUSER_PASSWORD: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: healthchecks-config\n  labels:\n    app.kubernetes.io/name: healthchecks\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: healthchecks\n  labels:\n    app.kubernetes.io/name: healthchecks\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: healthchecks\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: healthchecks\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: healthchecks\n        image: ghcr.io/linuxserver-playground/healthchecks:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: healthchecks-env\n        ports:\n        - name: port-8000\n          containerPort: 8000\n          protocol: TCP\n        volumeMounts:\n        - name: healthchecks-config\n          mountPath: /config\n      volumes:\n      - name: healthchecks-config\n        persistentVolumeClaim:\n          claimName: healthchecks-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: healthchecks\n  labels:\n    app.kubernetes.io/name: healthchecks\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: healthchecks\n  ports:\n  - name: port-8000\n    port: 8000\n    targetPort: 8000\n    protocol: TCP\n",
 "quadlet": "# healthchecks.container: generated by the hub from https://github.com/linuxserver-playground/docker-healthchecks/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Healthchecks (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/healthchecks:latest\nContainerName=healthchecks\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=SECRET_KEY=\nEnvironment=SITE_ROOT=\nEnvironment=SITE_NAME=\nEnvironment=SUPERUSER_EMAIL=\nEnvironment=SUPERUSER_PASSWORD=\n# Environment=ALLOWED_HOSTS=\n# Environment=APPRISE_ENABLED=False\n# Environment=CSRF_TRUSTED_ORIGINS=\n# Environment=DEBUG=True\n# Environment=DEFAULT_FROM_EMAIL=\n# Environment=EMAIL_HOST=\n# Environment=EMAIL_PORT=\n# Environment=EMAIL_HOST_USER=\n# Environment=EMAIL_HOST_PASSWORD=\n# Environment=EMAIL_USE_TLS=\n# Environment=INTEGRATIONS_ALLOW_PRIVATE_IPS=\n# Environment=PING_EMAIL_DOMAIN=\n# Environment=RP_ID=\n# Environment=SITE_LOGO_URL=\nVolume=/path/to/healthchecks/config:/config:Z\nPublishPort=8000:8000\n# PublishPort=2525:2525\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
