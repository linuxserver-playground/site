 "proxy": {
  "image": "hedgedoc",
  "port": 3000,
  "scheme": "http",
  "subdomain": "## Version 2026/11/05\n# make sure that your hedgedoc container is named hedgedoc\n# make sure that your dns has a cname set for hedgedoc\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name hedgedoc.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app hedgedoc;\n        set $upstream_port 3000;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for hedgedoc, generated by the hub from its image.yml.\n# Caddy and the hedgedoc container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nhedgedoc.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy hedgedoc:3000\n\t}\n}\n",
  "traefik": "# Traefik reference config for hedgedoc, generated by the hub from its image.yml.\n# Labels for the hedgedoc service in your compose file. Traefik's docker provider must reach the hedgedoc\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  hedgedoc:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.hedgedoc.loadbalancer.server.port=3000\n      - traefik.http.routers.hedgedoc.rule=Host(`hedgedoc.example.com`)\n      - traefik.http.routers.hedgedoc.entrypoints=websecure\n      - traefik.http.routers.hedgedoc.tls.certresolver=letsencrypt\n      - traefik.http.routers.hedgedoc.service=hedgedoc\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.hedgedoc.middlewares=authelia@docker\n      # - traefik.http.routers.hedgedoc.middlewares=authentik@docker\n",
  "config": {
   "port": 3000,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Hedgedoc: generated by the hub from https://github.com/linuxserver-playground/docker-hedgedoc/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: hedgedoc-env\n  labels:\n    app.kubernetes.io/name: hedgedoc\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  DB_HOST: <hostname or ip>\n  DB_PORT: '3306'\n  DB_USER: hedgedoc\n  DB_PASS: <secret password>\n  DB_NAME: hedgedoc\n  CMD_DOMAIN: localhost\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: hedgedoc-config\n  labels:\n    app.kubernetes.io/name: hedgedoc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: hedgedoc\n  labels:\n    app.kubernetes.io/name: hedgedoc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: hedgedoc\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: hedgedoc\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: hedgedoc\n        image: ghcr.io/linuxserver-playground/hedgedoc:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: hedgedoc-env\n        ports:\n        - name: port-3000\n          containerPort: 3000\n          protocol: TCP\n        volumeMounts:\n        - name: hedgedoc-config\n          mountPath: /config\n      volumes:\n      - name: hedgedoc-config\n        persistentVolumeClaim:\n          claimName: hedgedoc-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: hedgedoc\n  labels:\n    app.kubernetes.io/name: hedgedoc\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: hedgedoc\n  ports:\n  - name: port-3000\n    port: 3000\n    targetPort: 3000\n    protocol: TCP\n",
 "quadlet": "# hedgedoc.container: generated by the hub from https://github.com/linuxserver-playground/docker-hedgedoc/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Hedgedoc (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/hedgedoc:latest\nContainerName=hedgedoc\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=\"DB_HOST=<hostname or ip>\"\nEnvironment=DB_PORT=3306\nEnvironment=DB_USER=hedgedoc\nEnvironment=\"DB_PASS=<secret password>\"\nEnvironment=DB_NAME=hedgedoc\nEnvironment=CMD_DOMAIN=localhost\n# Environment=CMD_URL_ADDPORT=false\n# Environment=CMD_PROTOCOL_USESSL=false\n# Environment=CMD_PORT=3000\n# Environment=CMD_ALLOW_ORIGIN=['localhost']\n# Environment=CMD_DB_DIALECT=\nVolume=/path/to/hedgedoc/config:/config:Z\nPublishPort=3000:3000\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
