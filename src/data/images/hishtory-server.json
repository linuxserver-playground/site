 "kubernetes": "# Hishtory-server: generated by the hub from https://github.com/linuxserver-playground/docker-hishtory-server/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: hishtory-server-env\n  labels:\n    app.kubernetes.io/name: hishtory-server\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: hishtory-server\n  labels:\n    app.kubernetes.io/name: hishtory-server\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: hishtory-server\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: hishtory-server\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: hishtory-server\n        image: ghcr.io/linuxserver-playground/hishtory-server:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: hishtory-server-env\n        ports:\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: hishtory-server\n  labels:\n    app.kubernetes.io/name: hishtory-server\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: hishtory-server\n  ports:\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n",
 "quadlet": "# hishtory-server.container: generated by the hub from https://github.com/linuxserver-playground/docker-hishtory-server/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Hishtory-server (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/hishtory-server:latest\nContainerName=hishtory-server\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=HISHTORY_POSTGRES_DB=postgresql://${HISHTORY_DB_USER}:${HISHTORY_DB_PASS}@hishtory-db:5432/hishtory?sslmode=disable\n# Environment=HISHTORY_SQLITE_DB=/config/hishtory.db\nPublishPort=8080:8080\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
