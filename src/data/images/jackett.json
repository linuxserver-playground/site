 "proxy": {
  "image": "jackett",
  "port": 9117,
  "scheme": "http",
  "subdomain": "## Version 2026/11/14\n# make sure that your jackett container is named jackett\n# make sure that your dns has a cname set for jackett\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name jackett.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app jackett;\n        set $upstream_port 9117;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/jackett)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app jackett;\n        set $upstream_port 9117;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/jackett)?/dl {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app jackett;\n        set $upstream_port 9117;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/11/14\n# make sure that your jackett container is named jackett\n# make sure that jackett is set to work with the base url /jackett/\n# Jackett dashboard → Base path override, set to /jackett\n\nlocation ^~ /jackett {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app jackett;\n    set $upstream_port 9117;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /jackett/api {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app jackett;\n    set $upstream_port 9117;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /jackett/dl {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app jackett;\n    set $upstream_port 9117;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for jackett, generated by the hub from its image.yml.\n# Caddy and the jackett container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\njackett.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/* /dl /dl/*\n\thandle @api {\n\t\treverse_proxy jackett:9117\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy jackett:9117\n\t}\n}\n\n# Subfolder alternative, https://example.com/jackett: set jackett's base URL to /jackett first.\n# Jackett dashboard → Base path override, set to /jackett\n# example.com {\n# \t# API paths stay open so client applications keep working.\n# \t@api path /jackett/api /jackett/api/* /jackett/dl /jackett/dl/*\n# \thandle @api {\n# \t\treverse_proxy jackett:9117\n# \t}\n#\n# \thandle /jackett* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy jackett:9117\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for jackett, generated by the hub from its image.yml.\n# Labels for the jackett service in your compose file. Traefik's docker provider must reach the jackett\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  jackett:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.jackett.loadbalancer.server.port=9117\n      - traefik.http.routers.jackett.rule=Host(`jackett.example.com`)\n      - traefik.http.routers.jackett.entrypoints=websecure\n      - traefik.http.routers.jackett.tls.certresolver=letsencrypt\n      - traefik.http.routers.jackett.service=jackett\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.jackett.middlewares=authelia@docker\n      # - traefik.http.routers.jackett.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.jackett-api.rule=Host(`jackett.example.com`) && (PathPrefix(`/api`) || PathPrefix(`/dl`))\n      - traefik.http.routers.jackett-api.entrypoints=websecure\n      - traefik.http.routers.jackett-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.jackett-api.service=jackett\n      - traefik.http.routers.jackett-api.priority=100\n",
  "base_url_note": "Jackett dashboard → Base path override, set to /jackett",
  "config": {
   "port": 9117,
   "subdomain": true,
   "subfolder": {
    "supported": true,
    "base_url_note": "Jackett dashboard → Base path override, set to /jackett"
   },
   "api_locations": [
    "/api",
    "/dl"
   ]
  }
 },
 "kubernetes": "# Jackett: generated by the hub from https://github.com/linuxserver-playground/docker-jackett/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: jackett-env\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: jackett-config\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: jackett-downloads\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: jackett\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: jackett\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: jackett\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: jackett\n        image: ghcr.io/linuxserver-playground/jackett:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: jackett-env\n        ports:\n        - name: port-9117\n          containerPort: 9117\n          protocol: TCP\n        volumeMounts:\n        - name: jackett-config\n          mountPath: /config\n        - name: jackett-downloads\n          mountPath: /downloads\n      volumes:\n      - name: jackett-config\n        persistentVolumeClaim:\n          claimName: jackett-config\n      - name: jackett-downloads\n        persistentVolumeClaim:\n          claimName: jackett-downloads\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: jackett\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: jackett\n  ports:\n  - name: port-9117\n    port: 9117\n    targetPort: 9117\n    protocol: TCP\n",
 "quadlet": "# jackett.container: generated by the hub from https://github.com/linuxserver-playground/docker-jackett/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Jackett (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/jackett:latest\nContainerName=jackett\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=AUTO_UPDATE=true\n# Environment=RUN_OPTS=\nVolume=/path/to/jackett/data:/config:Z\nVolume=/path/to/blackhole:/downloads:Z\nPublishPort=9117:9117\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
