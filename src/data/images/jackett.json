 "kubernetes": "# Jackett: generated by the hub from https://github.com/linuxserver-playground/docker-jackett/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: jackett-env\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: jackett-config\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: jackett-downloads\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: jackett\n  labels:\n    app.kubernetes.io/name: jackett\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: jackett\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: jackett\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: jackett\n        image: ghcr.io/linuxserver-playground/jackett:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: jackett-env\n        ports:\n        - name: port-9117\n          containerPort: 9117\n          protocol: TCP\n        volumeMounts:\n        - name: jackett-config\n          mountPath