 "proxy": {
  "image": "kavita",
  "port": 5000,
  "scheme": "http",
  "subdomain": "## Version 2026/11/13\n# make sure that your kavita container is named kavita\n# make sure that your dns has a cname set for kavita\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name kavita.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app kavita;\n        set $upstream_port 5000;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/kavita)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app kavita;\n        set $upstream_port 5000;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/11/13\n# make sure that your kavita container is named kavita\n# make sure that kavita is set to work with the base url /kavita/\n\nlocation ^~ /kavita {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app kavita;\n    set $upstream_port 5000;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /kavita/api {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app kavita;\n    set $upstream_port 5000;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for kavita, generated by the hub from its image.yml.\n# Caddy and the kavita container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nkavita.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/*\n\thandle @api {\n\t\treverse_proxy kavita:5000\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy kavita:5000\n\t}\n}\n\n# Subfolder alternative, https://example.com/kavita: set kavita's base URL to /kavita first.\n# example.com {\n# \t# API paths stay open so client applications keep working.\n# \t@api path /kavita/api /kavita/api/*\n# \thandle @api {\n# \t\treverse_proxy kavita:5000\n# \t}\n#\n# \thandle /kavita* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy kavita:5000\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for kavita, generated by the hub from its image.yml.\n# Labels for the kavita service in your compose file. Traefik's docker provider must reach the kavita\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  kavita:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.kavita.loadbalancer.server.port=5000\n      - traefik.http.routers.kavita.rule=Host(`kavita.example.com`)\n      - traefik.http.routers.kavita.entrypoints=websecure\n      - traefik.http.routers.kavita.tls.certresolver=letsencrypt\n      - traefik.http.routers.kavita.service=kavita\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.kavita.middlewares=authelia@docker\n      # - traefik.http.routers.kavita.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.kavita-api.rule=Host(`kavita.example.com`) && (PathPrefix(`/api`))\n      - traefik.http.routers.kavita-api.entrypoints=websecure\n      - traefik.http.routers.kavita-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.kavita-api.service=kavita\n      - traefik.http.routers.kavita-api.priority=100\n",
  "config": {
   "port": 5000,
   "subdomain": true,
   "subfolder": {
    "supported": true
   },
   "api_locations": [
    "/api"
   ]
  }
 },
 "kubernetes": "# Kavita: generated by the hub from https://github.com/linuxserver-playground/docker-kavita/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: kavita-env\n  labels:\n    app.kubernetes.io/name: kavita\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: kavita-config\n  labels:\n    app.kubernetes.io/name: kavita\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: kavita\n  labels:\n    app.kubernetes.io/name: kavita\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: kavita\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: kavita\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: kavita\n        image: ghcr.io/linuxserver-playground/kavita:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: kavita-env\n        ports:\n        - name: port-5000\n          containerPort: 5000\n          protocol: TCP\n        volumeMounts:\n        - name: kavita-config\n          mountPath: /config\n      volumes:\n      - name: kavita-config\n        persistentVolumeClaim:\n          claimName: kavita-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: kavita\n  labels:\n    app.kubernetes.io/name: kavita\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: kavita\n  ports:\n  - name: port-5000\n    port: 5000\n    targetPort: 5000\n    protocol: TCP\n",
 "quadlet": "# kavita.container: generated by the hub from https://github.com/linuxserver-playground/docker-kavita/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Kavita (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/kavita:latest\nContainerName=kavita\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/kavita/config:/config:Z\n# Volume=/path/to/data:/data:Z\nPublishPort=5000:5000\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
