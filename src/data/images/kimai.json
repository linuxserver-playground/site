 "proxy": {
  "image": "kimai",
  "port": 80,
  "scheme": "http",
  "subdomain": "## Version 2026/11/13\n# make sure that your kimai container is named kimai\n# make sure that your dns has a cname set for kimai\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name kimai.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app kimai;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/kimai)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app kimai;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for kimai, generated by the hub from its image.yml.\n# Caddy and the kimai container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nkimai.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/*\n\thandle @api {\n\t\treverse_proxy kimai:80\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy kimai:80\n\t}\n}\n",
  "traefik": "# Traefik reference config for kimai, generated by the hub from its image.yml.\n# Labels for the kimai service in your compose file. Traefik's docker provider must reach the kimai\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  kimai:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.kimai.loadbalancer.server.port=80\n      - traefik.http.routers.kimai.rule=Host(`kimai.example.com`)\n      - traefik.http.routers.kimai.entrypoints=websecure\n      - traefik.http.routers.kimai.tls.certresolver=letsencrypt\n      - traefik.http.routers.kimai.service=kimai\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.kimai.middlewares=authelia@docker\n      # - traefik.http.routers.kimai.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.kimai-api.rule=Host(`kimai.example.com`) && (PathPrefix(`/api`))\n      - traefik.http.routers.kimai-api.entrypoints=websecure\n      - traefik.http.routers.kimai-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.kimai-api.service=kimai\n      - traefik.http.routers.kimai-api.priority=100\n",
  "config": {
   "port": 80,
   "subdomain": true,
   "subfolder": {
    "supported": false
   },
   "api_locations": [
    "/api"
   ]
  }
 },
 "kubernetes": "# Kimai: generated by the hub from https://github.com/linuxserver-playground/docker-kimai/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: kimai-env\n  labels:\n    app.kubernetes.io/name: kimai\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  APP_SECRET: ''\n  DATABASE_URL: mysql://your_db_user:your_db_pass@your_db_host:3306/your_db_name?charset=your_db_charset&serverVersion=your_db_version\n  TRUSTED_HOSTS: kimai.example.com\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: kimai-config\n  labels:\n    app.kubernetes.io/name: kimai\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: kimai\n  labels:\n    app.kubernetes.io/name: kimai\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: kimai\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: kimai\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: kimai\n        image: ghcr.io/linuxserver-playground/kimai:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: kimai-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        - name: port-443\n          containerPort: 443\n          protocol: TCP\n        volumeMounts:\n        - name: kimai-config\n          mountPath: /config\n      volumes:\n      - name: kimai-config\n        persistentVolumeClaim:\n          claimName: kimai-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: kimai\n  labels:\n    app.kubernetes.io/name: kimai\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: kimai\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n  - name: port-443\n    port: 443\n    targetPort: 443\n    protocol: TCP\n",
 "quadlet": "# kimai.container: generated by the hub from https://github.com/linuxserver-playground/docker-kimai/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Kimai (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/kimai:latest\nContainerName=kimai\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=APP_SECRET=\nEnvironment=DATABASE_URL=mysql://your_db_user:your_db_pass@your_db_host:3306/your_db_name?charset=your_db_charset&serverVersion=your_db_version\nEnvironment=TRUSTED_HOSTS=kimai.example.com\n# Environment=TRUSTED_PROXIES=127.0.0.1/32\nVolume=/path/to/kimai/config:/config:Z\nPublishPort=80:80\nPublishPort=443:443\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
