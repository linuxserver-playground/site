 "proxy": {
  "image": "lazylibrarian",
  "port": 5299,
  "scheme": "http",
  "subdomain": "## Version 2026/10/29\n# make sure that your lazylibrarian container is named lazylibrarian\n# make sure that your dns has a cname set for lazylibrarian\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name lazylibrarian.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app lazylibrarian;\n        set $upstream_port 5299;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/10/29\n# make sure that your lazylibrarian container is named lazylibrarian\n# make sure that lazylibrarian is set to work with the base url /lazylibrarian/\n\nlocation ^~ /lazylibrarian {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app lazylibrarian;\n    set $upstream_port 5299;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for lazylibrarian, generated by the hub from its image.yml.\n# Caddy and the lazylibrarian container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nlazylibrarian.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy lazylibrarian:5299\n\t}\n}\n\n# Subfolder alternative, https://example.com/lazylibrarian: set lazylibrarian's base URL to /lazylibrarian first.\n# example.com {\n# \thandle /lazylibrarian* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy lazylibrarian:5299\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for lazylibrarian, generated by the hub from its image.yml.\n# Labels for the lazylibrarian service in your compose file. Traefik's docker provider must reach the lazylibrarian\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  lazylibrarian:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.lazylibrarian.loadbalancer.server.port=5299\n      - traefik.http.routers.lazylibrarian.rule=Host(`lazylibrarian.example.com`)\n      - traefik.http.routers.lazylibrarian.entrypoints=websecure\n      - traefik.http.routers.lazylibrarian.tls.certresolver=letsencrypt\n      - traefik.http.routers.lazylibrarian.service=lazylibrarian\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.lazylibrarian.middlewares=authelia@docker\n      # - traefik.http.routers.lazylibrarian.middlewares=authentik@docker\n",
  "config": {
   "port": 5299,
   "subdomain": true,
   "subfolder": {
    "supported": true
   }
  }
 },
 "kubernetes": "# Lazylibrarian: generated by the hub from https://github.com/linuxserver-playground/docker-lazylibrarian/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: lazylibrarian-env\n  labels:\n    app.kubernetes.io/name: lazylibrarian\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: lazylibrarian-config\n  labels:\n    app.kubernetes.io/name: lazylibrarian\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: lazylibrarian-downloads\n  labels:\n    app.kubernetes.io/name: lazylibrarian\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: lazylibrarian\n  labels:\n    app.kubernetes.io/name: lazylibrarian\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: lazylibrarian\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: lazylibrarian\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: lazylibrarian\n        image: ghcr.io/linuxserver-playground/lazylibrarian:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: lazylibrarian-env\n        ports:\n        - name: port-5299\n          containerPort: 5299\n          protocol: TCP\n        volumeMounts:\n        - name: lazylibrarian-config\n          mountPath: /config\n        - name: lazylibrarian-downloads\n          mountPath: /downloads\n      volumes:\n      - name: lazylibrarian-config\n        persistentVolumeClaim:\n          claimName: lazylibrarian-config\n      - name: lazylibrarian-downloads\n        persistentVolumeClaim:\n          claimName: lazylibrarian-downloads\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: lazylibrarian\n  labels:\n    app.kubernetes.io/name: lazylibrarian\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: lazylibrarian\n  ports:\n  - name: port-5299\n    port: 5299\n    targetPort: 5299\n    protocol: TCP\n",
 "quadlet": "# lazylibrarian.container: generated by the hub from https://github.com/linuxserver-playground/docker-lazylibrarian/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Lazylibrarian (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/lazylibrarian:latest\nContainerName=lazylibrarian\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=DOCKER_MODS=linuxserver/mods:universal-calibre|linuxserver/mods:lazylibrarian-ffmpeg\nVolume=/path/to/lazylibrarian/data:/config:Z\nVolume=/path/to/downloads/:/downloads:Z\n# Volume=/path/to/data/:/books:Z\nPublishPort=5299:5299\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
