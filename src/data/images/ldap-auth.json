 "kubernetes": "# Ldap-auth: generated by the hub from https://github.com/linuxserver-playground/docker-ldap-auth/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: ldap-auth-env\n  labels:\n    app.kubernetes.io/name: ldap-auth\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: ldap-auth\n  labels:\n    app.kubernetes.io/name: ldap-auth\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: ldap-auth\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: ldap-auth\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: ldap-auth\n        image: ghcr.io/linuxserver-playground/ldap-auth:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: ldap-auth-env\n        ports:\n        - name: port-8888\n          containerPort: 8888\n          protocol: TCP\n        - name: port-9000\n          containerPort: 9000\n          protocol: TCP\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: ldap-auth\n  labels:\n    app.kubernetes.io/name: ldap-auth\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: ldap-auth\n  ports:\n  - name: port-8888\n    port: 8888\n    targetPort: 8888\n    protocol: TCP\n  - name: port-9000\n    port: 9000\n    targetPort: 9000\n    protocol: TCP\n",
 "quadlet": "# ldap-auth.container: generated by the hub from https://github.com/linuxserver-playground/docker-ldap-auth/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Ldap-auth (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/ldap-auth:latest\nContainerName=ldap-auth\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=FERNETKEY=\n# Environment=CERTFILE=\n# Environment=KEYFILE=\nPublishPort=8888:8888\nPublishPort=9000:9000\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
