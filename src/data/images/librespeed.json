 "kubernetes": "# Librespeed: generated by the hub from https://github.com/linuxserver-playground/docker-librespeed/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: librespeed-env\n  labels:\n    app.kubernetes.io/name: librespeed\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  PASSWORD: PASSWORD\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: librespeed-config\n  labels:\n    app.kubernetes.io/name: librespeed\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: librespeed\n  labels:\n    app.kubernetes.io/name: librespeed\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: librespeed\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: librespeed\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: librespeed\n        image: ghcr.io/linuxserver-playground/librespeed:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: librespeed-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: librespeed-config\n          mountPath: /config\n      volumes:\n      - name: librespeed-config\n        persistentVolumeClaim:\n          claimName: librespeed-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: librespeed\n  labels:\n    app.kubernetes.io/name: librespeed\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: librespeed\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# librespeed.container: generated by the hub from https://github.com/linuxserver-playground/docker-librespeed/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Librespeed (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/librespeed:latest\nContainerName=librespeed\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=PASSWORD=PASSWORD\n# Environment=CUSTOM_RESULTS=false\n# Environment=DB_TYPE=sqlite\n# Environment=DB_NAME=DB_NAME\n# Environment=DB_HOSTNAME=DB_HOSTNAME\n# Environment=DB_USERNAME=DB_USERNAME\n# Environment=DB_PASSWORD=DB_PASSWORD\n# Environment=DB_PORT=DB_PORT\n# Environment=IPINFO_APIKEY=ACCESS_TOKEN\nVolume=/path/to/librespeed/config:/config:Z\nPublishPort=80:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
