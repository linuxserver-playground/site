 "proxy": {
  "image": "lidarr",
  "port": 8686,
  "scheme": "http",
  "subdomain": "## Version 2026/10/26\n# make sure that your lidarr container is named lidarr\n# make sure that your dns has a cname set for lidarr\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name lidarr.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app lidarr;\n        set $upstream_port 8686;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/lidarr)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app lidarr;\n        set $upstream_port 8686;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/10/26\n# make sure that your lidarr container is named lidarr\n# make sure that lidarr is set to work with the base url /lidarr/\n# Settings → General → URL Base, set to /lidarr\n\nlocation ^~ /lidarr {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app lidarr;\n    set $upstream_port 8686;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /lidarr/api {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app lidarr;\n    set $upstream_port 8686;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for lidarr, generated by the hub from its image.yml.\n# Caddy and the lidarr container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nlidarr.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/*\n\thandle @api {\n\t\treverse_proxy lidarr:8686\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy lidarr:8686\n\t}\n}\n\n# Subfolder alternative, https://example.com/lidarr: set lidarr's base URL to /lidarr first.\n# Settings → General → URL Base, set to /lidarr\n# example.com {\n# \t# API paths stay open so client applications keep working.\n# \t@api path /lidarr/api /lidarr/api/*\n# \thandle @api {\n# \t\treverse_proxy lidarr:8686\n# \t}\n#\n# \thandle /lidarr* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy lidarr:8686\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for lidarr, generated by the hub from its image.yml.\n# Labels for the lidarr service in your compose file. Traefik's docker provider must reach the lidarr\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  lidarr:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.lidarr.loadbalancer.server.port=8686\n      - traefik.http.routers.lidarr.rule=Host(`lidarr.example.com`)\n      - traefik.http.routers.lidarr.entrypoints=websecure\n      - traefik.http.routers.lidarr.tls.certresolver=letsencrypt\n      - traefik.http.routers.lidarr.service=lidarr\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.lidarr.middlewares=authelia@docker\n      # - traefik.http.routers.lidarr.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.lidarr-api.rule=Host(`lidarr.example.com`) && (PathPrefix(`/api`))\n      - traefik.http.routers.lidarr-api.entrypoints=websecure\n      - traefik.http.routers.lidarr-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.lidarr-api.service=lidarr\n      - traefik.http.routers.lidarr-api.priority=100\n",
  "base_url_note": "Settings → General → URL Base, set to /lidarr",
  "config": {
   "port": 8686,
   "subdomain": true,
   "subfolder": {
    "supported": true,
    "base_url_note": "Settings → General → URL Base, set to /lidarr"
   },
   "api_locations": [
    "/api"
   ]
  }
 },
 "kubernetes": "# Lidarr: generated by the hub from https://github.com/linuxserver-playground/docker-lidarr/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: lidarr-env\n  labels:\n    app.kubernetes.io/name: lidarr\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: lidarr-config\n  labels:\n    app.kubernetes.io/name: lidarr\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: lidarr\n  labels:\n    app.kubernetes.io/name: lidarr\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: lidarr\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: lidarr\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: lidarr\n        image: ghcr.io/linuxserver-playground/lidarr:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: lidarr-env\n        ports:\n        - name: port-8686\n          containerPort: 8686\n          protocol: TCP\n        volumeMounts:\n        - name: lidarr-config\n          mountPath: /config\n      volumes:\n      - name: lidarr-config\n        persistentVolumeClaim:\n          claimName: lidarr-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: lidarr\n  labels:\n    app.kubernetes.io/name: lidarr\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: lidarr\n  ports:\n  - name: port-8686\n    port: 8686\n    targetPort: 8686\n    protocol: TCP\n",
 "quadlet": "# lidarr.container: generated by the hub from https://github.com/linuxserver-playground/docker-lidarr/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Lidarr (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/lidarr:latest\nContainerName=lidarr\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/lidarr/config:/config:Z\n# Volume=/path/to/music:/music:Z\n# Volume=/path/to/downloads:/downloads:Z\nPublishPort=8686:8686\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
