 "proxy": {
  "image": "lychee",
  "port": 80,
  "scheme": "http",
  "subdomain": "## Version 2026/11/10\n# make sure that your lychee container is named lychee\n# make sure that your dns has a cname set for lychee\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name lychee.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app lychee;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for lychee, generated by the hub from its image.yml.\n# Caddy and the lychee container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nlychee.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy lychee:80\n\t}\n}\n",
  "traefik": "# Traefik reference config for lychee, generated by the hub from its image.yml.\n# Labels for the lychee service in your compose file. Traefik's docker provider must reach the lychee\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  lychee:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.lychee.loadbalancer.server.port=80\n      - traefik.http.routers.lychee.rule=Host(`lychee.example.com`)\n      - traefik.http.routers.lychee.entrypoints=websecure\n      - traefik.http.routers.lychee.tls.certresolver=letsencrypt\n      - traefik.http.routers.lychee.service=lychee\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.lychee.middlewares=authelia@docker\n      # - traefik.http.routers.lychee.middlewares=authentik@docker\n",
  "config": {
   "port": 80,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Lychee: generated by the hub from https://github.com/linuxserver-playground/docker-lychee/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: lychee-env\n  labels:\n    app.kubernetes.io/name: lychee\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  DB_CONNECTION: ''\n  DB_HOST: ''\n  DB_PORT: ''\n  DB_USERNAME: ''\n  DB_PASSWORD: ''\n  DB_DATABASE: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: lychee-config\n  labels:\n    app.kubernetes.io/name: lychee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: lychee-pictures\n  labels:\n    app.kubernetes.io/name: lychee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: lychee\n  labels:\n    app.kubernetes.io/name: lychee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: lychee\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: lychee\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: lychee\n        image: ghcr.io/linuxserver-playground/lychee:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: lychee-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: lychee-config\n          mountPath: /config\n        - name: lychee-pictures\n          mountPath: /pictures\n      volumes:\n      - name: lychee-config\n        persistentVolumeClaim:\n          claimName: lychee-config\n      - name: lychee-pictures\n        persistentVolumeClaim:\n          claimName: lychee-pictures\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: lychee\n  labels:\n    app.kubernetes.io/name: lychee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: lychee\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# lychee.container: generated by the hub from https://github.com/linuxserver-playground/docker-lychee/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Lychee (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/lychee:latest\nContainerName=lychee\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=DB_CONNECTION=\nEnvironment=DB_HOST=\nEnvironment=DB_PORT=\nEnvironment=DB_USERNAME=\nEnvironment=DB_PASSWORD=\nEnvironment=DB_DATABASE=\n# Environment=APP_NAME=Lychee\n# Environment=APP_URL=\n# Environment=TRUSTED_PROXIES=\nVolume=/path/to/lychee/config:/config:Z\nVolume=/path/to/pictures:/pictures:Z\nPublishPort=80:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
