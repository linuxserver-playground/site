 "kubernetes": "# Mastodon: generated by the hub from https://github.com/linuxserver-playground/docker-mastodon/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: mastodon-env\n  labels:\n    app.kubernetes.io/name: mastodon\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  LOCAL_DOMAIN: example.com\n  REDIS_HOST: redis\n  REDIS_PORT: '6379'\n  DB_HOST: db\n  DB_USER: mastodon\n  DB_NAME: mastodon\n  DB_PASS: mastodon\n  DB_PORT: '5432'\n  ES_ENABLED: 'false'\n  ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY: ''\n  ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY: ''\n  ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT: ''\n  SECRET_KEY_BASE: ''\n  OTP_SECRET: ''\n  VAPID_PRIVATE_KEY: ''\n  VAPID_PUBLIC_KEY: ''\n  SMTP_SERVER: mail.example.com\n  SMTP_PORT: '25'\n  SMTP_LOGIN: ''\n  SMTP_PASSWORD: ''\n  SMTP_FROM_ADDRESS: notifications@example.com\n  S3_ENABLED: 'false'\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: mastodon-config\n  labels:\n    app.kubernetes.io/name: mastodon\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: mastodon\n  labels:\n    app.kubernetes.io/name: mastodon\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: mastodon\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: mastodon\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: mastodon\n        image: ghcr.io/linuxserver-playground/mastodon:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: mastodon-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        - name: port-443\n          containerPort: 443\n          protocol: TCP\n        volumeMounts:\n        - name: mastodon-config\n          mountPath: /config\n      volumes:\n      - name: mastodon-config\n        persistentVolumeClaim:\n          claimName: mastodon-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: mastodon\n  labels:\n    app.kubernetes.io/name: mastodon\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: mastodon\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n  - name: port-443\n    port: 443\n    targetPort: 443\n    protocol: TCP\n",
 "quadlet": "# mastodon.container: generated by the hub from https://github.com/linuxserver-playground/docker-mastodon/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Mastodon (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/mastodon:latest\nContainerName=mastodon\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=LOCAL_DOMAIN=example.com\nEnvironment=REDIS_HOST=redis\nEnvironment=REDIS_PORT=6379\nEnvironment=DB_HOST=db\nEnvironment=DB_USER=mastodon\nEnvironment=DB_NAME=mastodon\nEnvironment=DB_PASS=mastodon\nEnvironment=DB_PORT=5432\nEnvironment=ES_ENABLED=false\nEnvironment=ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=\nEnvironment=ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=\nEnvironment=ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=\nEnvironment=SECRET_KEY_BASE=\nEnvironment=OTP_SECRET=\nEnvironment=VAPID_PRIVATE_KEY=\nEnvironment=VAPID_PUBLIC_KEY=\nEnvironment=SMTP_SERVER=mail.example.com\nEnvironment=SMTP_PORT=25\nEnvironment=SMTP_LOGIN=\nEnvironment=SMTP_PASSWORD=\nEnvironment=SMTP_FROM_ADDRESS=notifications@example.com\nEnvironment=S3_ENABLED=false\n# Environment=WEB_DOMAIN=mastodon.example.com\n# Environment=ES_HOST=es\n# Environment=ES_PORT=9200\n# Environment=ES_USER=elastic\n# Environment=ES_PASS=elastic\n# Environment=S3_BUCKET=\n# Environment=AWS_ACCESS_KEY_ID=\n# Environment=AWS_SECRET_ACCESS_KEY=\n# Environment=S3_ALIAS_HOST=\n# Environment=SIDEKIQ_ONLY=false\n# Environment=SIDEKIQ_QUEUE=\n# Environment=SIDEKIQ_DEFAULT=false\n# Environment=SIDEKIQ_THREADS=5\n# Environment=DB_POOL=5\n# Environment=NO_CHOWN=\n# Environment=MASTODON_PROMETHEUS_EXPORTER_ENABLED=\nVolume=/path/to/mastodon/config:/config:Z\nPublishPort=80:80\nPublishPort=443:443\n# PublishPort=9394:9394\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
