 "kubernetes": "# Medusa: generated by the hub from https://github.com/linuxserver-playground/docker-medusa/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: medusa-env\n  labels:\n    app.kubernetes.io/name: medusa\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: medusa-config\n  labels:\n    app.kubernetes.io/name: medusa\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: medusa-downloads\n  labels:\n    app.kubernetes.io/name: medusa\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: medusa-tv\n  labels:\n    app.kubernetes.io/name: medusa\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: medusa\n  labels:\n    app.kubernetes.io/name: medusa\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: medusa\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: medusa\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: medusa\n        image: ghcr.io/linuxserver-playground/medusa:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: medusa-env\n        ports:\n        - name: port-8081\n          containerPort: 8081\n          protocol: TCP\n        volumeMounts:\n        - name: medusa-config\n          mountPath: /config\n        - name: medusa-downloads\n          mountPath: /downloads\n        - name: medusa-tv\n          mountPath: /tv\n      volumes:\n      - name: medusa-config\n        persistentVolumeClaim:\n          claimName: medusa-config\n      - name: medusa-downloads\n        persistentVolumeClaim:\n          claimName: medusa-downloads\n      - name: medusa-tv\n        persistentVolumeClaim:\n          claimName: medusa-tv\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: medusa\n  labels:\n    app.kubernetes.io/name: medusa\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: medusa\n  ports:\n  - name: port-8081\n    port: 8081\n    targetPort: 8081\n    protocol: TCP\n",
 "quadlet": "# medusa.container: generated by the hub from https://github.com/linuxserver-playground/docker-medusa/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Medusa (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/medusa:latest\nContainerName=medusa\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/medusa/config:/config:Z\nVolume=/path/to/downloads:/downloads:Z\nVolume=/path/to/tv/shows:/tv:Z\nPublishPort=8081:8081\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
