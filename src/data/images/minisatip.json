 "kubernetes": "# Minisatip: generated by the hub from https://github.com/linuxserver-playground/docker-minisatip/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/dvb: For passing through Tv-cards (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: minisatip-env\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  RUN_OPTS: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: minisatip-config\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: minisatip\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: minisatip\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: minisatip\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: minisatip\n        image: ghcr.io/linuxserver-playground/minisatip:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: minisatip-env\n        ports:\n        - name: port-8875\n          containerPort: 8875\n          protocol: TCP\n        - name: port-554\n          containerPort: 554\n          protocol: TCP\n        - name: port-1900\n          containerPort: 1900\n          protocol: UDP\n        volumeMounts:\n        - name: minisatip-config\n          mountPath: /config\n      volumes:\n      - name: minisatip-config\n        persistentVolumeClaim:\n          claimName: minisatip-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: minisatip\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: minisatip\n  ports:\n  - name: port-8875\n    port: 8875\n    targetPort: 8875\n    protocol: TCP\n  - name: port-554\n    port: 554\n    targetPort: 554\n    protocol: TCP\n  - name: port-1900\n    port: 1900\n    targetPort: 1900\n    protocol: UDP\n",
 "quadlet": "# minisatip.container: generated by the hub from https://github.com/linuxserver-playground/docker-minisatip/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Minisatip (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/minisatip:latest\nContainerName=minisatip\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=RUN_OPTS=\nVolume=/path/to/minisatip/config:/config:Z\nPublishPort=8875:8875\nPublishPort=554:554\nPublishPort=1900:1900/udp\nAddDevice=/dev/dvb:/dev/dvb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
