 "proxy": {
  "image": "minisatip",
  "port": 8875,
  "scheme": "http",
  "subdomain": "## Version 2026/11/12\n# make sure that your minisatip container is named minisatip\n# make sure that your dns has a cname set for minisatip\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name minisatip.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app minisatip;\n        set $upstream_port 8875;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for minisatip, generated by the hub from its image.yml.\n# Caddy and the minisatip container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nminisatip.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy minisatip:8875\n\t}\n}\n",
  "traefik": "# Traefik reference config for minisatip, generated by the hub from its image.yml.\n# Labels for the minisatip service in your compose file. Traefik's docker provider must reach the minisatip\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  minisatip:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.minisatip.loadbalancer.server.port=8875\n      - traefik.http.routers.minisatip.rule=Host(`minisatip.example.com`)\n      - traefik.http.routers.minisatip.entrypoints=websecure\n      - traefik.http.routers.minisatip.tls.certresolver=letsencrypt\n      - traefik.http.routers.minisatip.service=minisatip\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.minisatip.middlewares=authelia@docker\n      # - traefik.http.routers.minisatip.middlewares=authentik@docker\n",
  "config": {
   "port": 8875,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Minisatip: generated by the hub from https://github.com/linuxserver-playground/docker-minisatip/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/dvb: For passing through Tv-cards (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: minisatip-env\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  RUN_OPTS: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: minisatip-config\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: minisatip\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: minisatip\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: minisatip\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: minisatip\n        image: ghcr.io/linuxserver-playground/minisatip:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: minisatip-env\n        ports:\n        - name: port-8875\n          containerPort: 8875\n          protocol: TCP\n        - name: port-554\n          containerPort: 554\n          protocol: TCP\n        - name: port-1900\n          containerPort: 1900\n          protocol: UDP\n        volumeMounts:\n        - name: minisatip-config\n          mountPath: /config\n      volumes:\n      - name: minisatip-config\n        persistentVolumeClaim:\n          claimName: minisatip-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: minisatip\n  labels:\n    app.kubernetes.io/name: minisatip\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: minisatip\n  ports:\n  - name: port-8875\n    port: 8875\n    targetPort: 8875\n    protocol: TCP\n  - name: port-554\n    port: 554\n    targetPort: 554\n    protocol: TCP\n  - name: port-1900\n    port: 1900\n    targetPort: 1900\n    protocol: UDP\n",
 "quadlet": "# minisatip.container: generated by the hub from https://github.com/linuxserver-playground/docker-minisatip/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Minisatip (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/minisatip:latest\nContainerName=minisatip\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=RUN_OPTS=\nVolume=/path/to/minisatip/config:/config:Z\nPublishPort=8875:8875\nPublishPort=554:554\nPublishPort=1900:1900/udp\nAddDevice=/dev/dvb:/dev/dvb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
