 "kubernetes": "# Mullvad-browser: generated by the hub from https://github.com/linuxserver-playground/docker-mullvad-browser/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - capability NET_ADMIN: Neccessary for Wireguard to create its VPN interface..\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: mullvad-browser-env\n  labels:\n    app.kubernetes.io/name: mullvad-browser\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: mullvad-browser-config\n  labels:\n    app.kubernetes.io/name: mullvad-browser\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: mullvad-browser\n  labels:\n    app.kubernetes.io/name: mullvad-browser\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: mullvad-browser\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: mullvad-browser\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: mullvad-browser\n        image: ghcr.io/linuxserver-playground/mullvad-browser:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: mullvad-browser-env\n        ports:\n        - name: port-3000\n          containerPort: 3000\n          protocol: TCP\n        - name: port-3001\n          containerPort: 3001\n          protocol: TCP\n        volumeMounts:\n        - name: mullvad-browser-config\n          mountPath: /config\n        securityContext:\n          capabilities:\n            add:\n            - NET_ADMIN\n      volumes:\n      - name: mullvad-browser-config\n        persistentVolumeClaim:\n          claimName: mullvad-browser-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: mullvad-browser\n  labels:\n    app.kubernetes.io/name: mullvad-browser\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: mullvad-browser\n  ports:\n  - name: port-3000\n    port: 3000\n    targetPort: 3000\n    protocol: TCP\n  - name: port-3001\n    port: 3001\n    targetPort: 3001\n    protocol: TCP\n",
 "quadlet": "# mullvad-browser.container: generated by the hub from https://github.com/linuxserver-playground/docker-mullvad-browser/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Mullvad-browser (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/mullvad-browser:latest\nContainerName=mullvad-browser\nAutoUpdate=registry\nAddCapability=NET_ADMIN\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=LOCAL_NET=192.168.0.0/16\nVolume=/path/to/mullvad-browser/config:/config:Z\nPublishPort=3000:3000\nPublishPort=3001:3001\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
