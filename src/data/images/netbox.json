 "kubernetes": "# Netbox: generated by the hub from https://github.com/linuxserver-playground/docker-netbox/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: netbox-env\n  labels:\n    app.kubernetes.io/name: netbox\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  SUPERUSER_EMAIL: ''\n  SUPERUSER_PASSWORD: ''\n  ALLOWED_HOST: ''\n  DB_NAME: ''\n  DB_USER: ''\n  DB_PASSWORD: ''\n  DB_HOST: ''\n  DB_PORT: ''\n  REDIS_HOST: ''\n  REDIS_PORT: ''\n  REDIS_USERNAME: ''\n  REDIS_PASSWORD: ''\n  REDIS_DB_TASK: ''\n  REDIS_DB_CACHE: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: netbox-config\n  labels:\n    app.kubernetes.io/name: netbox\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: netbox\n  labels:\n    app.kubernetes.io/name: netbox\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: netbox\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: netbox\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: netbox\n        image: ghcr.io/linuxserver-playground/netbox:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: netbox-env\n        ports:\n        - name: port-8000\n          containerPort: 8000\n          protocol: TCP\n        volumeMounts:\n        - name: netbox-config\n          mountPath: /config\n      volumes:\n      - name: netbox-config\n        persistentVolumeClaim:\n          claimName: netbox-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: netbox\n  labels:\n    app.kubernetes.io/name: netbox\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: netbox\n  ports:\n  - name: port-8000\n    port: 8000\n    targetPort: 8000\n    protocol: TCP\n",
 "quadlet": "# netbox.container: generated by the hub from https://github.com/linuxserver-playground/docker-netbox/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Netbox (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/netbox:latest\nContainerName=netbox\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=SUPERUSER_EMAIL=\nEnvironment=SUPERUSER_PASSWORD=\nEnvironment=ALLOWED_HOST=\nEnvironment=DB_NAME=\nEnvironment=DB_USER=\nEnvironment=DB_PASSWORD=\nEnvironment=DB_HOST=\nEnvironment=DB_PORT=\nEnvironment=REDIS_HOST=\nEnvironment=REDIS_PORT=\nEnvironment=REDIS_USERNAME=\nEnvironment=REDIS_PASSWORD=\nEnvironment=REDIS_DB_TASK=\nEnvironment=REDIS_DB_CACHE=\n# Environment=BASE_PATH=\n# Environment=CSRF_TRUSTED_ORIGINS=\n# Environment=REMOTE_AUTH_ENABLED=\n# Environment=REMOTE_AUTH_BACKEND=\n# Environment=REMOTE_AUTH_HEADER=\n# Environment=REMOTE_AUTH_AUTO_CREATE_USER=\n# Environment=REMOTE_AUTH_DEFAULT_GROUPS=\n# Environment=REMOTE_AUTH_DEFAULT_PERMISSIONS=\nVolume=/path/to/netbox/config:/config:Z\nPublishPort=8000:8000\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
