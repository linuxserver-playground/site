 "kubernetes": "# Nextcloud: generated by the hub from https://github.com/linuxserver-playground/docker-nextcloud/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: nextcloud-env\n  labels:\n    app.kubernetes.io/name: nextcloud\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: nextcloud-config\n  labels:\n    app.kubernetes.io/name: nextcloud\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: nextcloud-data\n  labels:\n    app.kubernetes.io/name: nextcloud\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: nextcloud\n  labels:\n    app.kubernetes.io/name: nextcloud\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: nextcloud\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: nextcloud\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: nextcloud\n        image: ghcr.io/linuxserver-playground/nextcloud:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: nextcloud-env\n        ports:\n        - name: port-443\n          containerPort: 443\n          protocol: TCP\n        volumeMounts:\n        - name: nextcloud-config\n          mountPath: /config\n        - name: nextcloud-data\n          mountPath: /data\n      volumes:\n      - name: nextcloud-config\n        persistentVolumeClaim:\n          claimName: nextcloud-config\n      - name: nextcloud-data\n        persistentVolumeClaim:\n          claimName: nextcloud-data\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: nextcloud\n  labels:\n    app.kubernetes.io/name: nextcloud\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: nextcloud\n  ports:\n  - name: port-443\n    port: 443\n    targetPort: 443\n    protocol: TCP\n",
 "quadlet": "# nextcloud.container: generated by the hub from https://github.com/linuxserver-playground/docker-nextcloud/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Nextcloud (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/nextcloud:latest\nContainerName=nextcloud\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/nextcloud/config:/config:Z\nVolume=/path/to/data:/data:Z\nPublishPort=443:443\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
