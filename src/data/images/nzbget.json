 "kubernetes": "# Nzbget: generated by the hub from https://github.com/linuxserver-playground/docker-nzbget/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: nzbget-env\n  labels:\n    app.kubernetes.io/name: nzbget\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: nzbget-config\n  labels:\n    app.kubernetes.io/name: nzbget\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: nzbget\n  labels:\n    app.kubernetes.io/name: nzbget\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: nzbget\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: nzbget\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: nzbget\n        image: ghcr.io/linuxserver-playground/nzbget:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: nzbget-env\n        ports:\n        - name: port-6789\n          containerPort: 6789\n          protocol: TCP\n        volumeMounts:\n        - name: nzbget-config\n          mountPath: /config\n      volumes:\n      - name: nzbget-config\n        persistentVolumeClaim:\n          claimName: nzbget-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: nzbget\n  labels:\n    app.kubernetes.io/name: nzbget\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: nzbget\n  ports:\n  - name: port-6789\n    port: 6789\n    targetPort: 6789\n    protocol: TCP\n",
 "quadlet": "# nzbget.container: generated by the hub from https://github.com/linuxserver-playground/docker-nzbget/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Nzbget (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/nzbget:latest\nContainerName=nzbget\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=NZBGET_USER=nzbget\n# Environment=NZBGET_PASS=tegbzn6789\nVolume=/path/to/nzbget/data:/config:Z\n# Volume=/path/to/downloads:/downloads:Z\nPublishPort=6789:6789\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
