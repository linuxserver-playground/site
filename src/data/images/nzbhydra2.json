 "kubernetes": "# Nzbhydra2: generated by the hub from https://github.com/linuxserver-playground/docker-nzbhydra2/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: nzbhydra2-env\n  labels:\n    app.kubernetes.io/name: nzbhydra2\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: nzbhydra2-config\n  labels:\n    app.kubernetes.io/name: nzbhydra2\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: nzbhydra2\n  labels:\n    app.kubernetes.io/name: nzbhydra2\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: nzbhydra2\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: nzbhydra2\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: nzbhydra2\n        image: ghcr.io/linuxserver-playground/nzbhydra2:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: nzbhydra2-env\n        ports:\n        - name: port-5076\n          containerPort: 5076\n          protocol: TCP\n        volumeMounts:\n        - name: nzbhydra2-config\n          mountPath: /config\n      volumes:\n      - name: nzbhydra2-config\n        persistentVolumeClaim:\n          claimName: nzbhydra2-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: nzbhydra2\n  labels:\n    app.kubernetes.io/name: nzbhydra2\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: nzbhydra2\n  ports:\n  - name: port-5076\n    port: 5076\n    targetPort: 5076\n    protocol: TCP\n",
 "quadlet": "# nzbhydra2.container: generated by the hub from https://github.com/linuxserver-playground/docker-nzbhydra2/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Nzbhydra2 (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/nzbhydra2:latest\nContainerName=nzbhydra2\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/nzbhydra2/data:/config:Z\n# Volume=/path/to/downloads:/downloads:Z\nPublishPort=5076:5076\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
