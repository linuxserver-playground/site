 "proxy": {
  "image": "ombi",
  "port": 3579,
  "scheme": "http",
  "subdomain": "## Version 2026/10/30\n# make sure that your ombi container is named ombi\n# make sure that your dns has a cname set for ombi\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name ombi.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app ombi;\n        set $upstream_port 3579;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/ombi)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app ombi;\n        set $upstream_port 3579;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/ombi)?/swagger {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app ombi;\n        set $upstream_port 3579;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/10/30\n# make sure that your ombi container is named ombi\n# make sure that ombi is set to work with the base url /ombi/\n# Settings → Ombi → Base URL, set to /ombi\n\nlocation ^~ /ombi {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app ombi;\n    set $upstream_port 3579;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /ombi/api {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app ombi;\n    set $upstream_port 3579;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /ombi/swagger {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app ombi;\n    set $upstream_port 3579;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for ombi, generated by the hub from its image.yml.\n# Caddy and the ombi container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nombi.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/* /swagger /swagger/*\n\thandle @api {\n\t\treverse_proxy ombi:3579\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy ombi:3579\n\t}\n}\n\n# Subfolder alternative, https://example.com/ombi: set ombi's base URL to /ombi first.\n# Settings → Ombi → Base URL, set to /ombi\n# example.com {\n# \t# API paths stay open so client applications keep working.\n# \t@api path /ombi/api /ombi/api/* /ombi/swagger /ombi/swagger/*\n# \thandle @api {\n# \t\treverse_proxy ombi:3579\n# \t}\n#\n# \thandle /ombi* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy ombi:3579\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for ombi, generated by the hub from its image.yml.\n# Labels for the ombi service in your compose file. Traefik's docker provider must reach the ombi\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  ombi:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.ombi.loadbalancer.server.port=3579\n      - traefik.http.routers.ombi.rule=Host(`ombi.example.com`)\n      - traefik.http.routers.ombi.entrypoints=websecure\n      - traefik.http.routers.ombi.tls.certresolver=letsencrypt\n      - traefik.http.routers.ombi.service=ombi\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.ombi.middlewares=authelia@docker\n      # - traefik.http.routers.ombi.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.ombi-api.rule=Host(`ombi.example.com`) && (PathPrefix(`/api`) || PathPrefix(`/swagger`))\n      - traefik.http.routers.ombi-api.entrypoints=websecure\n      - traefik.http.routers.ombi-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.ombi-api.service=ombi\n      - traefik.http.routers.ombi-api.priority=100\n",
  "base_url_note": "Settings → Ombi → Base URL, set to /ombi",
  "config": {
   "port": 3579,
   "subdomain": true,
   "subfolder": {
    "supported": true,
    "base_url_note": "Settings → Ombi → Base URL, set to /ombi"
   },
   "api_locations": [
    "/api",
    "/swagger"
   ]
  }
 },
 "kubernetes": "# Ombi: generated by the hub from https://github.com/linuxserver-playground/docker-ombi/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: ombi-env\n  labels:\n    app.kubernetes.io/name: ombi\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: ombi-config\n  labels:\n    app.kubernetes.io/name: ombi\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: ombi\n  labels:\n    app.kubernetes.io/name: ombi\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: ombi\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: ombi\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: ombi\n        image: ghcr.io/linuxserver-playground/ombi:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: ombi-env\n        ports:\n        - name: port-3579\n          containerPort: 3579\n          protocol: TCP\n        volumeMounts:\n        - name: ombi-config\n          mountPath: /config\n      volumes:\n      - name: ombi-config\n        persistentVolumeClaim:\n          claimName: ombi-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: ombi\n  labels:\n    app.kubernetes.io/name: ombi\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: ombi\n  ports:\n  - name: port-3579\n    port: 3579\n    targetPort: 3579\n    protocol: TCP\n",
 "quadlet": "# ombi.container: generated by the hub from https://github.com/linuxserver-playground/docker-ombi/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Ombi (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/ombi:latest\nContainerName=ombi\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=BASE_URL=/\nVolume=/path/to/ombi/config:/config:Z\nPublishPort=3579:3579\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
