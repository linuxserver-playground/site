 "kubernetes": "# Oscam: generated by the hub from https://github.com/linuxserver-playground/docker-oscam/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/ttyUSB0: For passing through smart card readers. (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: oscam-env\n  labels:\n    app.kubernetes.io/name: oscam\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: oscam-config\n  labels:\n    app.kubernetes.io/name: oscam\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: oscam\n  labels:\n    app.kubernetes.io/name: oscam\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: oscam\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: oscam\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: oscam\n        image: ghcr.io/linuxserver-playground/oscam:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: oscam-env\n        ports:\n        - name: port-8888\n          containerPort: 8888\n          protocol: TCP\n        volumeMounts:\n        - name: oscam-config\n          mountPath: /config\n      volumes:\n      - name: oscam-config\n        persistentVolumeClaim:\n          claimName: oscam-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: oscam\n  labels:\n    app.kubernetes.io/name: oscam\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: oscam\n  ports:\n  - name: port-8888\n    port: 8888\n    targetPort: 8888\n    protocol: TCP\n",
 "quadlet": "# oscam.container: generated by the hub from https://github.com/linuxserver-playground/docker-oscam/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Oscam (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/oscam:latest\nContainerName=oscam\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/oscam/data:/config:Z\nPublishPort=8888:8888\nAddDevice=/dev/ttyUSB0:/dev/ttyUSB0\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
