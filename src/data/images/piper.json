 "kubernetes": "# Piper: generated by the hub from https://github.com/linuxserver-playground/docker-piper/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: piper-env\n  labels:\n    app.kubernetes.io/name: piper\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  PIPER_VOICE: en_US-lessac-medium\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: piper-config\n  labels:\n    app.kubernetes.io/name: piper\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: piper\n  labels:\n    app.kubernetes.io/name: piper\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: piper\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: piper\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: piper\n        image: ghcr.io/linuxserver-playground/piper:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: piper-env\n        ports:\n        - name: port-10200\n          containerPort: 10200\n          protocol: TCP\n        volumeMounts:\n        - name: piper-config\n          mountPath: /config\n      volumes:\n      - name: piper-config\n        persistentVolumeClaim:\n          claimName: piper-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: piper\n  labels:\n    app.kubernetes.io/name: piper\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: piper\n  ports:\n  - name: port-10200\n    port: 10200\n    targetPort: 10200\n    protocol: TCP\n",
 "quadlet": "# piper.container: generated by the hub from https://github.com/linuxserver-playground/docker-piper/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Piper (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/piper:latest\nContainerName=piper\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=PIPER_VOICE=en_US-lessac-medium\n# Environment=LOCAL_ONLY=\n# Environment=PIPER_LENGTH=1.0\n# Environment=PIPER_NOISE=0.667\n# Environment=PIPER_NOISEW=0.333\n# Environment=PIPER_SPEAKER=0\n# Environment=NO_STREAMING=\nVolume=/path/to/piper/data:/config:Z\nPublishPort=10200:10200\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
