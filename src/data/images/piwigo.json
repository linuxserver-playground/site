 "kubernetes": "# Piwigo: generated by the hub from https://github.com/linuxserver-playground/docker-piwigo/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: piwigo-env\n  labels:\n    app.kubernetes.io/name: piwigo\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: piwigo-config\n  labels:\n    app.kubernetes.io/name: piwigo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: piwigo-gallery\n  labels:\n    app.kubernetes.io/name: piwigo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: piwigo\n  labels:\n    app.kubernetes.io/name: piwigo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: piwigo\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: piwigo\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: piwigo\n        image: ghcr.io/linuxserver-playground/piwigo:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: piwigo-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: piwigo-config\n          mountPath: /config\n        - name: piwigo-gallery\n          mountPath: /gallery\n      volumes:\n      - name: piwigo-config\n        persistentVolumeClaim:\n          claimName: piwigo-config\n      - name: piwigo-gallery\n        persistentVolumeClaim:\n          claimName: piwigo-gallery\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: piwigo\n  labels:\n    app.kubernetes.io/name: piwigo\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: piwigo\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# piwigo.container: generated by the hub from https://github.com/linuxserver-playground/docker-piwigo/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Piwigo (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/piwigo:latest\nContainerName=piwigo\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/piwigo/config:/config:Z\nVolume=/path/to/appdata/gallery:/gallery:Z\nPublishPort=80:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
