 "kubernetes": "# Rawtherapee: generated by the hub from https://github.com/linuxserver-playground/docker-rawtherapee/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: rawtherapee-env\n  labels:\n    app.kubernetes.io/name: rawtherapee\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: rawtherapee-config\n  labels:\n    app.kubernetes.io/name: rawtherapee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: rawtherapee\n  labels:\n    app.kubernetes.io/name: rawtherapee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: rawtherapee\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: rawtherapee\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: rawtherapee\n        image: ghcr.io/linuxserver-playground/rawtherapee:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: rawtherapee-env\n        ports:\n        - name: port-3000\n          containerPort: 3000\n          protocol: TCP\n        - name: port-3001\n          containerPort: 3001\n          protocol: TCP\n        volumeMounts:\n        - name: rawtherapee-config\n          mountPath: /config\n      volumes:\n      - name: rawtherapee-config\n        persistentVolumeClaim:\n          claimName: rawtherapee-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: rawtherapee\n  labels:\n    app.kubernetes.io/name: rawtherapee\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: rawtherapee\n  ports:\n  - name: port-3000\n    port: 3000\n    targetPort: 3000\n    protocol: TCP\n  - name: port-3001\n    port: 3001\n    targetPort: 3001\n    protocol: TCP\n",
 "quadlet": "# rawtherapee.container: generated by the hub from https://github.com/linuxserver-playground/docker-rawtherapee/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Rawtherapee (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/rawtherapee:latest\nContainerName=rawtherapee\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/rawtherapee/config:/config:Z\nPublishPort=3000:3000\nPublishPort=3001:3001\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
