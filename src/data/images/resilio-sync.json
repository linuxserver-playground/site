 "kubernetes": "# Resilio-sync: generated by the hub from https://github.com/linuxserver-playground/docker-resilio-sync/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: resilio-sync-env\n  labels:\n    app.kubernetes.io/name: resilio-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: resilio-sync-config\n  labels:\n    app.kubernetes.io/name: resilio-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: resilio-sync-downloads\n  labels:\n    app.kubernetes.io/name: resilio-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: resilio-sync-sync\n  labels:\n    app.kubernetes.io/name: resilio-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: resilio-sync\n  labels:\n    app.kubernetes.io/name: resilio-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: resilio-sync\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: resilio-sync\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: resilio-sync\n        image: ghcr.io/linuxserver-playground/resilio-sync:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: resilio-sync-env\n        ports:\n        - name: port-8888\n          containerPort: 8888\n          protocol: TCP\n        - name: port-55555\n          containerPort: 55555\n          protocol: TCP\n        volumeMounts:\n        - name: resilio-sync-config\n          mountPath: /config\n        - name: resilio-sync-downloads\n          mountPath: /downloads\n        - name: resilio-sync-sync\n          mountPath: /sync\n      volumes:\n      - name: resilio-sync-config\n        persistentVolumeClaim:\n          claimName: resilio-sync-config\n      - name: resilio-sync-downloads\n        persistentVolumeClaim:\n          claimName: resilio-sync-downloads\n      - name: resilio-sync-sync\n        persistentVolumeClaim:\n          claimName: resilio-sync-sync\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: resilio-sync\n  labels:\n    app.kubernetes.io/name: resilio-sync\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: resilio-sync\n  ports:\n  - name: port-8888\n    port: 8888\n    targetPort: 8888\n    protocol: TCP\n  - name: port-55555\n    port: 55555\n    targetPort: 55555\n    protocol: TCP\n",
 "quadlet": "# resilio-sync.container: generated by the hub from https://github.com/linuxserver-playground/docker-resilio-sync/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Resilio-sync (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/resilio-sync:latest\nContainerName=resilio-sync\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/resilio-sync/config:/config:Z\nVolume=/path/to/downloads:/downloads:Z\nVolume=/path/to/data:/sync:Z\nPublishPort=8888:8888\nPublishPort=55555:55555\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
