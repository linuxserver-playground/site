 "kubernetes": "# Rsnapshot: generated by the hub from https://github.com/linuxserver-playground/docker-rsnapshot/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: rsnapshot-env\n  labels:\n    app.kubernetes.io/name: rsnapshot\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: rsnapshot-config\n  labels:\n    app.kubernetes.io/name: rsnapshot\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: rsnapshot\n  labels:\n    app.kubernetes.io/name: rsnapshot\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: rsnapshot\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: rsnapshot\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: rsnapshot\n        image: ghcr.io/linuxserver-playground/rsnapshot:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: rsnapshot-env\n        volumeMounts:\n        - name: rsnapshot-config\n          mountPath: /config\n      volumes:\n      - name: rsnapshot-config\n        persistentVolumeClaim:\n          claimName: rsnapshot-config\n  strategy:\n    type: Recreate\n",
 "quadlet": "# rsnapshot.container: generated by the hub from https://github.com/linuxserver-playground/docker-rsnapshot/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Rsnapshot (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/rsnapshot:latest\nContainerName=rsnapshot\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/rsnapshot/config:/config:Z\n# Volume=/path/to/snapshots:/.snapshots:Z\n# Volume=/path/to/data:/data:Z\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
