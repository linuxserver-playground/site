 "kubernetes": "# Sealskin: generated by the hub from https://github.com/linuxserver-playground/docker-sealskin/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: sealskin-env\n  labels:\n    app.kubernetes.io/name: sealskin\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: sealskin-config\n  labels:\n    app.kubernetes.io/name: sealskin\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: sealskin-storage\n  labels:\n    app.kubernetes.io/name: sealskin\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: sealskin-var-run-docker.sock\n  labels:\n    app.kubernetes.io/name: sealskin\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: sealskin\n  labels:\n    app.kubernetes.io/name: sealskin\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: sealskin\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: sealskin\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: sealskin\n        image: ghcr.io/linuxserver-playground/sealskin:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: sealskin-env\n        ports:\n        - name: port-8443\n          containerPort: 8443\n          protocol: TCP\n        volumeMounts:\n        - name: sealskin-config\n          mountPath: /config\n        - name: sealskin-storage\n          mountPath: /storage\n        - name: sealskin-var-run-docker.sock\n          mountPath: /var/run/docker.sock\n      volumes:\n      - name: sealskin-config\n        persistentVolumeClaim:\n          claimName: sealskin-config\n      - name: sealskin-storage\n        persistentVolumeClaim:\n          claimName: sealskin-storage\n      - name: sealskin-var-run-docker.sock\n        persistentVolumeClaim:\n          claimName: sealskin-var-run-docker.sock\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: sealskin\n  labels:\n    app.kubernetes.io/name: sealskin\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: sealskin\n  ports:\n  - name: port-8443\n    port: 8443\n    targetPort: 8443\n    protocol: TCP\n",
 "quadlet": "# sealskin.container: generated by the hub from https://github.com/linuxserver-playground/docker-sealskin/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Sealskin (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/sealskin:latest\nContainerName=sealskin\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=\"HOST_URL=IP or subdomain.domain.com\"\nVolume=/path/to/sealskin/config:/config:Z\nVolume=/path/to/sealskin/storage:/storage:Z\nVolume=/var/run/docker.sock:/var/run/docker.sock:Z\nPublishPort=8443:8443\n# PublishPort=8000:8000\n# PublishPort=8444:8444\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
