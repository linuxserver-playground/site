 "proxy": {
  "image": "smokeping",
  "port": 80,
  "scheme": "http",
  "subdomain": "## Version 2026/11/13\n# make sure that your smokeping container is named smokeping\n# make sure that your dns has a cname set for smokeping\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name smokeping.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app smokeping;\n        set $upstream_port 80;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/11/13\n# make sure that your smokeping container is named smokeping\n# make sure that smokeping is set to work with the base url /smokeping/\n# Smokeping serves /smokeping by default; nothing to change\n\nlocation ^~ /smokeping {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app smokeping;\n    set $upstream_port 80;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for smokeping, generated by the hub from its image.yml.\n# Caddy and the smokeping container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nsmokeping.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy smokeping:80\n\t}\n}\n\n# Subfolder alternative, https://example.com/smokeping: set smokeping's base URL to /smokeping first.\n# Smokeping serves /smokeping by default; nothing to change\n# example.com {\n# \thandle /smokeping* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy smokeping:80\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for smokeping, generated by the hub from its image.yml.\n# Labels for the smokeping service in your compose file. Traefik's docker provider must reach the smokeping\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  smokeping:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.smokeping.loadbalancer.server.port=80\n      - traefik.http.routers.smokeping.rule=Host(`smokeping.example.com`)\n      - traefik.http.routers.smokeping.entrypoints=websecure\n      - traefik.http.routers.smokeping.tls.certresolver=letsencrypt\n      - traefik.http.routers.smokeping.service=smokeping\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.smokeping.middlewares=authelia@docker\n      # - traefik.http.routers.smokeping.middlewares=authentik@docker\n",
  "base_url_note": "Smokeping serves /smokeping by default; nothing to change",
  "config": {
   "port": 80,
   "subdomain": true,
   "subfolder": {
    "supported": true,
    "base_url_note": "Smokeping serves /smokeping by default; nothing to change"
   }
  }
 },
 "kubernetes": "# Smokeping: generated by the hub from https://github.com/linuxserver-playground/docker-smokeping/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: smokeping-env\n  labels:\n    app.kubernetes.io/name: smokeping\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: smokeping-config\n  labels:\n    app.kubernetes.io/name: smokeping\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: smokeping-data\n  labels:\n    app.kubernetes.io/name: smokeping\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: smokeping\n  labels:\n    app.kubernetes.io/name: smokeping\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: smokeping\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: smokeping\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: smokeping\n        image: ghcr.io/linuxserver-playground/smokeping:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: smokeping-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: smokeping-config\n          mountPath: /config\n        - name: smokeping-data\n          mountPath: /data\n      volumes:\n      - name: smokeping-config\n        persistentVolumeClaim:\n          claimName: smokeping-config\n      - name: smokeping-data\n        persistentVolumeClaim:\n          claimName: smokeping-data\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: smokeping\n  labels:\n    app.kubernetes.io/name: smokeping\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: smokeping\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# smokeping.container: generated by the hub from https://github.com/linuxserver-playground/docker-smokeping/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Smokeping (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/smokeping:latest\nContainerName=smokeping\nAutoUpdate=registry\n# HostName=smokeping\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=MASTER_URL=http://<master-host-ip>:80/smokeping/\n# Environment=SHARED_SECRET=password\n# Environment=CACHE_DIR=/tmp\nVolume=/path/to/smokeping/config:/config:Z\nVolume=/path/to/smokeping/data:/data:Z\nPublishPort=80:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
