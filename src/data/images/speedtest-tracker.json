 "kubernetes": "# Speedtest-tracker: generated by the hub from https://github.com/linuxserver-playground/docker-speedtest-tracker/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: speedtest-tracker-env\n  labels:\n    app.kubernetes.io/name: speedtest-tracker\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  APP_KEY: ''\n  APP_URL: ''\n  DB_CONNECTION: sqlite\n  SPEEDTEST_SCHEDULE: ''\n  SPEEDTEST_SERVERS: ''\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: speedtest-tracker-config\n  labels:\n    app.kubernetes.io/name: speedtest-tracker\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: speedtest-tracker\n  labels:\n    app.kubernetes.io/name: speedtest-tracker\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: speedtest-tracker\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: speedtest-tracker\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: speedtest-tracker\n        image: ghcr.io/linuxserver-playground/speedtest-tracker:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: speedtest-tracker-env\n        ports:\n        - name: port-80\n          containerPort: 80\n          protocol: TCP\n        volumeMounts:\n        - name: speedtest-tracker-config\n          mountPath: /config\n      volumes:\n      - name: speedtest-tracker-config\n        persistentVolumeClaim:\n          claimName: speedtest-tracker-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: speedtest-tracker\n  labels:\n    app.kubernetes.io/name: speedtest-tracker\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: speedtest-tracker\n  ports:\n  - name: port-80\n    port: 80\n    targetPort: 80\n    protocol: TCP\n",
 "quadlet": "# speedtest-tracker.container: generated by the hub from https://github.com/linuxserver-playground/docker-speedtest-tracker/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Speedtest-tracker (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/speedtest-tracker:latest\nContainerName=speedtest-tracker\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=APP_KEY=\nEnvironment=APP_URL=\nEnvironment=DB_CONNECTION=sqlite\nEnvironment=SPEEDTEST_SCHEDULE=\nEnvironment=SPEEDTEST_SERVERS=\n# Environment=DB_HOST=\n# Environment=DB_PORT=\n# Environment=DB_DATABASE=\n# Environment=DB_USERNAME=\n# Environment=DB_PASSWORD=\n# Environment=DISPLAY_TIMEZONE=Etc/UTC\n# Environment=PRUNE_RESULTS_OLDER_THAN=0\nVolume=/path/to/speedtest-tracker/data:/config:Z\nPublishPort=80:80\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
