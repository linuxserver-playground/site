 "kubernetes": "# Swag: generated by the hub from https://github.com/linuxserver-playground/docker-swag/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - capability NET_ADMIN: Required for fail2Ban to be able to modify iptables rules..\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: swag-env\n  labels:\n    app.kubernetes.io/name: swag\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  URL: example.com\n  VALIDATION: http\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: swag-config\n  labels:\n    app.kubernetes.io/name: swag\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: swag\n  labels:\n    app.kubernetes.io/name: swag\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: swag\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: swag\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: swag\n        image: ghcr.io/linuxserver-playground/swag:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: swag-env\n        ports:\n        - name: port-443\n          containerPort: 443\n          protocol: TCP\n        volumeMounts:\n        - name: swag-config\n          mountPath: /config\n        securityContext:\n          capabilities:\n            add:\n            - NET_ADMIN\n      volumes:\n      - name: swag-config\n        persistentVolumeClaim:\n          claimName: swag-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: swag\n  labels:\n    app.kubernetes.io/name: swag\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: swag\n  ports:\n  - name: port-443\n    port: 443\n    targetPort: 443\n    protocol: TCP\n",
 "quadlet": "# swag.container: generated by the hub from https://github.com/linuxserver-playground/docker-swag/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Swag (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/swag:latest\nContainerName=swag\nAutoUpdate=registry\nAddCapability=NET_ADMIN\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=URL=example.com\nEnvironment=VALIDATION=http\n# Environment=SUBDOMAINS=www,\n# Environment=CERTPROVIDER=\n# Environment=CERT_PROFILE=\n# Environment=DNSPLUGIN=cloudflare\n# Environment=PROPAGATION=\n# Environment=EMAIL=\n# Environment=ONLY_SUBDOMAINS=false\n# Environment=EXTRA_DOMAINS=\n# Environment=STAGING=false\n# Environment=DISABLE_F2B=\n# Environment=SWAG_AUTORELOAD=\n# Environment=SWAG_AUTORELOAD_WATCHLIST=\nVolume=/path/to/swag/config:/config:Z\nPublishPort=443:443\n# PublishPort=80:80\n# PublishPort=443:443/udp\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
