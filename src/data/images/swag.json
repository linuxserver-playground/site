rvice\nmetadata:\n  name: swag\n  labels:\n    app.kubernetes.io/name: swag\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: swag\n  ports:\n  - name: port-443\n    port: 443\n    targetPort: 443\n    protocol: TCP\n",
