 "proxy": {
  "image": "synclounge",
  "port": 8088,
  "scheme": "http",
  "subdomain": "## Version 2026/10/30\n# make sure that your synclounge container is named synclounge\n# make sure that your dns has a cname set for synclounge\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name synclounge.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app synclounge;\n        set $upstream_port 8088;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "caddy": "# Caddy reference config for synclounge, generated by the hub from its image.yml.\n# Caddy and the synclounge container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\nsynclounge.example.com {\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy synclounge:8088\n\t}\n}\n",
  "traefik": "# Traefik reference config for synclounge, generated by the hub from its image.yml.\n# Labels for the synclounge service in your compose file. Traefik's docker provider must reach the synclounge\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  synclounge:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.synclounge.loadbalancer.server.port=8088\n      - traefik.http.routers.synclounge.rule=Host(`synclounge.example.com`)\n      - traefik.http.routers.synclounge.entrypoints=websecure\n      - traefik.http.routers.synclounge.tls.certresolver=letsencrypt\n      - traefik.http.routers.synclounge.service=synclounge\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.synclounge.middlewares=authelia@docker\n      # - traefik.http.routers.synclounge.middlewares=authentik@docker\n",
  "config": {
   "port": 8088,
   "subdomain": true,
   "subfolder": {
    "supported": false
   }
  }
 },
 "kubernetes": "# Synclounge: generated by the hub from https://github.com/linuxserver-playground/docker-synclounge/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: synclounge\n  labels:\n    app.kubernetes.io/name: synclounge\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: synclounge\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: synclounge\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: synclounge\n        image: ghcr.io/linuxserver-playground/synclounge:latest\n        imagePullPolicy: IfNotPresent\n        ports:\n        - name: port-8088\n          containerPort: 8088\n          protocol: TCP\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: synclounge\n  labels:\n    app.kubernetes.io/name: synclounge\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: synclounge\n  ports:\n  - name: port-8088\n    port: 8088\n    targetPort: 8088\n    protocol: TCP\n",
 "quadlet": "# synclounge.container: generated by the hub from https://github.com/linuxserver-playground/docker-synclounge/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Synclounge (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/synclounge:latest\nContainerName=synclounge\nAutoUpdate=registry\n# Environment=AUTH_LIST=plexuser1,plexuser2,email1,machineid1\nPublishPort=8088:8088\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
