 "kubernetes": "# Syslog-ng: generated by the hub from https://github.com/linuxserver-playground/docker-syslog-ng/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: syslog-ng-env\n  labels:\n    app.kubernetes.io/name: syslog-ng\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: syslog-ng-config\n  labels:\n    app.kubernetes.io/name: syslog-ng\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: syslog-ng\n  labels:\n    app.kubernetes.io/name: syslog-ng\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: syslog-ng\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: syslog-ng\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: syslog-ng\n        image: ghcr.io/linuxserver-playground/syslog-ng:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: syslog-ng-env\n        ports:\n        - name: port-5514\n          containerPort: 5514\n          protocol: UDP\n        - name: port-6601\n          containerPort: 6601\n          protocol: TCP\n        - name: port-6514\n          containerPort: 6514\n          protocol: TCP\n        volumeMounts:\n        - name: syslog-ng-config\n          mountPath: /config\n      volumes:\n      - name: syslog-ng-config\n        persistentVolumeClaim:\n          claimName: syslog-ng-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: syslog-ng\n  labels:\n    app.kubernetes.io/name: syslog-ng\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: syslog-ng\n  ports:\n  - name: port-5514\n    port: 5514\n    targetPort: 5514\n    protocol: UDP\n  - name: port-6601\n    port: 6601\n    targetPort: 6601\n    protocol: TCP\n  - name: port-6514\n    port: 6514\n    targetPort: 6514\n    protocol: TCP\n",
 "quadlet": "# syslog-ng.container: generated by the hub from https://github.com/linuxserver-playground/docker-syslog-ng/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Syslog-ng (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/syslog-ng:latest\nContainerName=syslog-ng\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=LOG_TO_STDOUT=\nVolume=/path/to/syslog-ng/config:/config:Z\n# Volume=/path/to/log:/var/log:Z\nPublishPort=514:5514/udp\nPublishPort=601:6601/tcp\nPublishPort=6514:6514/tcp\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
