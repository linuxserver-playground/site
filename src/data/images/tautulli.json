 "proxy": {
  "image": "tautulli",
  "port": 8181,
  "scheme": "http",
  "subdomain": "## Version 2026/10/26\n# make sure that your tautulli container is named tautulli\n# make sure that your dns has a cname set for tautulli\n\nserver {\n    listen 443 ssl;\n#    listen 443 quic;\n    listen [::]:443 ssl;\n#    listen [::]:443 quic;\n\n    server_name tautulli.*;\n\n    include /config/nginx/ssl.conf;\n\n    client_max_body_size 0;\n\n    # enable for ldap auth (requires ldap-location.conf in the location block)\n    #include /config/nginx/ldap-server.conf;\n\n    # enable for Authelia (requires authelia-location.conf in the location block)\n    #include /config/nginx/authelia-server.conf;\n\n    # enable for Authentik (requires authentik-location.conf in the location block)\n    #include /config/nginx/authentik-server.conf;\n\n    # enable for Tinyauth (requires tinyauth-location.conf in the location block)\n    #include /config/nginx/tinyauth-server.conf;\n\n    location / {\n        # enable the next two lines for http auth\n        #auth_basic \"Restricted\";\n        #auth_basic_user_file /config/nginx/.htpasswd;\n\n        # enable for ldap auth (requires ldap-server.conf in the server block)\n        #include /config/nginx/ldap-location.conf;\n\n        # enable for Authelia (requires authelia-server.conf in the server block)\n        #include /config/nginx/authelia-location.conf;\n\n        # enable for Authentik (requires authentik-server.conf in the server block)\n        #include /config/nginx/authentik-location.conf;\n\n        # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n        #include /config/nginx/tinyauth-location.conf;\n\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app tautulli;\n        set $upstream_port 8181;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/tautulli)?/api {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app tautulli;\n        set $upstream_port 8181;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/tautulli)?/newsletter {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app tautulli;\n        set $upstream_port 8181;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n\n    location ~ (/tautulli)?/image {\n        include /config/nginx/proxy.conf;\n        include /config/nginx/resolver.conf;\n        set $upstream_app tautulli;\n        set $upstream_port 8181;\n        set $upstream_proto http;\n        proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n    }\n}\n",
  "subfolder": "## Version 2026/10/26\n# make sure that your tautulli container is named tautulli\n# make sure that tautulli is set to work with the base url /tautulli/\n# Settings → Web Interface → Show Advanced → HTTP Root, set to /tautulli\n\nlocation ^~ /tautulli {\n    # enable the next two lines for http auth\n    #auth_basic \"Restricted\";\n    #auth_basic_user_file /config/nginx/.htpasswd;\n\n    # enable for ldap auth (requires ldap-server.conf in the server block)\n    #include /config/nginx/ldap-location.conf;\n\n    # enable for Authelia (requires authelia-server.conf in the server block)\n    #include /config/nginx/authelia-location.conf;\n\n    # enable for Authentik (requires authentik-server.conf in the server block)\n    #include /config/nginx/authentik-location.conf;\n\n    # enable for Tinyauth (requires tinyauth-server.conf in the server block)\n    #include /config/nginx/tinyauth-location.conf;\n\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app tautulli;\n    set $upstream_port 8181;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /tautulli/api {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app tautulli;\n    set $upstream_port 8181;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /tautulli/newsletter {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app tautulli;\n    set $upstream_port 8181;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n\nlocation ^~ /tautulli/image {\n    include /config/nginx/proxy.conf;\n    include /config/nginx/resolver.conf;\n    set $upstream_app tautulli;\n    set $upstream_port 8181;\n    set $upstream_proto http;\n    proxy_pass $upstream_proto://$upstream_app:$upstream_port;\n\n}\n",
  "caddy": "# Caddy reference config for tautulli, generated by the hub from its image.yml.\n# Caddy and the tautulli container share a docker network; replace example.com with your domain.\n# Caddy fetches the certificate and passes websockets through on its own.\n\ntautulli.example.com {\n\t# API paths stay open so client applications keep working.\n\t@api path /api /api/* /newsletter /newsletter/* /image /image/*\n\thandle @api {\n\t\treverse_proxy tautulli:8181\n\t}\n\n\thandle {\n\t\t# Authentication: uncomment one.\n\t\t# basic_auth {\n\t\t# \tuser <hash from `caddy hash-password`>\n\t\t# }\n\t\t# forward_auth authelia:9091 {\n\t\t# \turi /api/authz/forward-auth\n\t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n\t\t# }\n\t\t# forward_auth authentik-server:9000 {\n\t\t# \turi /outpost.goauthentik.io/auth/caddy\n\t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n\t\t# \ttrusted_proxies private_ranges\n\t\t# }\n\n\t\treverse_proxy tautulli:8181\n\t}\n}\n\n# Subfolder alternative, https://example.com/tautulli: set tautulli's base URL to /tautulli first.\n# Settings → Web Interface → Show Advanced → HTTP Root, set to /tautulli\n# example.com {\n# \t# API paths stay open so client applications keep working.\n# \t@api path /tautulli/api /tautulli/api/* /tautulli/newsletter /tautulli/newsletter/* /tautulli/image /tautulli/image/*\n# \thandle @api {\n# \t\treverse_proxy tautulli:8181\n# \t}\n#\n# \thandle /tautulli* {\n# \t\t# Authentication: uncomment one.\n# \t\t# basic_auth {\n# \t\t# \tuser <hash from `caddy hash-password`>\n# \t\t# }\n# \t\t# forward_auth authelia:9091 {\n# \t\t# \turi /api/authz/forward-auth\n# \t\t# \tcopy_headers Remote-User Remote-Groups Remote-Email Remote-Name\n# \t\t# }\n# \t\t# forward_auth authentik-server:9000 {\n# \t\t# \turi /outpost.goauthentik.io/auth/caddy\n# \t\t# \tcopy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name\n# \t\t# \ttrusted_proxies private_ranges\n# \t\t# }\n#\n# \t\treverse_proxy tautulli:8181\n# \t}\n# }\n",
  "traefik": "# Traefik reference config for tautulli, generated by the hub from its image.yml.\n# Labels for the tautulli service in your compose file. Traefik's docker provider must reach the tautulli\n# container on a shared network; the entrypoint websecure and the certificate resolver letsencrypt are\n# examples from a typical Traefik setup. Replace example.com with your domain. Websockets need nothing extra.\nservices:\n  tautulli:\n    labels:\n      - traefik.enable=true\n      - traefik.http.services.tautulli.loadbalancer.server.port=8181\n      - traefik.http.routers.tautulli.rule=Host(`tautulli.example.com`)\n      - traefik.http.routers.tautulli.entrypoints=websecure\n      - traefik.http.routers.tautulli.tls.certresolver=letsencrypt\n      - traefik.http.routers.tautulli.service=tautulli\n      # Authentication: uncomment one; the middleware is defined in your Traefik config.\n      # - traefik.http.routers.tautulli.middlewares=authelia@docker\n      # - traefik.http.routers.tautulli.middlewares=authentik@docker\n      # API paths stay open so client applications keep working.\n      - traefik.http.routers.tautulli-api.rule=Host(`tautulli.example.com`) && (PathPrefix(`/api`) || PathPrefix(`/newsletter`) || PathPrefix(`/image`))\n      - traefik.http.routers.tautulli-api.entrypoints=websecure\n      - traefik.http.routers.tautulli-api.tls.certresolver=letsencrypt\n      - traefik.http.routers.tautulli-api.service=tautulli\n      - traefik.http.routers.tautulli-api.priority=100\n",
  "base_url_note": "Settings → Web Interface → Show Advanced → HTTP Root, set to /tautulli",
  "config": {
   "port": 8181,
   "subdomain": true,
   "subfolder": {
    "supported": true,
    "base_url_note": "Settings → Web Interface → Show Advanced → HTTP Root, set to /tautulli"
   },
   "api_locations": [
    "/api",
    "/newsletter",
    "/image"
   ]
  }
 },
 "kubernetes": "# Tautulli: generated by the hub from https://github.com/linuxserver-playground/docker-tautulli/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n#   - runAsNonRoot is supported by this image (set runAsUser and drop PUID/PGID).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: tautulli-env\n  labels:\n    app.kubernetes.io/name: tautulli\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: tautulli-config\n  labels:\n    app.kubernetes.io/name: tautulli\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: tautulli\n  labels:\n    app.kubernetes.io/name: tautulli\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: tautulli\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: tautulli\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: tautulli\n        image: ghcr.io/linuxserver-playground/tautulli:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: tautulli-env\n        ports:\n        - name: port-8181\n          containerPort: 8181\n          protocol: TCP\n        volumeMounts:\n        - name: tautulli-config\n          mountPath: /config\n      volumes:\n      - name: tautulli-config\n        persistentVolumeClaim:\n          claimName: tautulli-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: tautulli\n  labels:\n    app.kubernetes.io/name: tautulli\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: tautulli\n  ports:\n  - name: port-8181\n    port: 8181\n    targetPort: 8181\n    protocol: TCP\n",
 "quadlet": "# tautulli.container: generated by the hub from https://github.com/linuxserver-playground/docker-tautulli/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Tautulli (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/tautulli:latest\nContainerName=tautulli\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/tautulli/config:/config:Z\nPublishPort=8181:8181\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
