 "kubernetes": "# Tvheadend: generated by the hub from https://github.com/linuxserver-playground/docker-tvheadend/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - device /dev/dri: Only needed if you want to use your AMD/Intel GPU for hardware accelerated video encoding (vaapi). (needs a device plugin or hostPath; not emitted).\n#   - device /dev/dvb: Only needed if you want to pass through a DVB card to the container. If you use IPTV or HDHomeRun you can leave it out. (needs a device plugin or hostPath; not emitted).\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: tvheadend-env\n  labels:\n    app.kubernetes.io/name: tvheadend\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: tvheadend-config\n  labels:\n    app.kubernetes.io/name: tvheadend\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: tvheadend-recordings\n  labels:\n    app.kubernetes.io/name: tvheadend\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: tvheadend\n  labels:\n    app.kubernetes.io/name: tvheadend\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: tvheadend\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: tvheadend\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: tvheadend\n        image: ghcr.io/linuxserver-playground/tvheadend:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: tvheadend-env\n        ports:\n        - name: port-9981\n          containerPort: 9981\n          protocol: TCP\n        - name: port-9982\n          containerPort: 9982\n          protocol: TCP\n        volumeMounts:\n        - name: tvheadend-config\n          mountPath: /config\n        - name: tvheadend-recordings\n          mountPath: /recordings\n      volumes:\n      - name: tvheadend-config\n        persistentVolumeClaim:\n          claimName: tvheadend-config\n      - name: tvheadend-recordings\n        persistentVolumeClaim:\n          claimName: tvheadend-recordings\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: tvheadend\n  labels:\n    app.kubernetes.io/name: tvheadend\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: tvheadend\n  ports:\n  - name: port-9981\n    port: 9981\n    targetPort: 9981\n    protocol: TCP\n  - name: port-9982\n    port: 9982\n    targetPort: 9982\n    protocol: TCP\n",
 "quadlet": "# tvheadend.container: generated by the hub from https://github.com/linuxserver-playground/docker-tvheadend/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Tvheadend (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/tvheadend:latest\nContainerName=tvheadend\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=RUN_OPTS=\nVolume=/path/to/tvheadend/data:/config:Z\nVolume=/path/to/recordings:/recordings:Z\nPublishPort=9981:9981\nPublishPort=9982:9982\n# AddDevice=/dev/dri:/dev/dri\n# AddDevice=/dev/dvb:/dev/dvb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
