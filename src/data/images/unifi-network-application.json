 "kubernetes": "# Unifi-network-application: generated by the hub from https://github.com/linuxserver-playground/docker-unifi-network-application/blob/main/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: unifi-network-application-env\n  labels:\n    app.kubernetes.io/name: unifi-network-application\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n  MONGO_USER: unifi\n  MONGO_PASS: ''\n  MONGO_HOST: unifi-db\n  MONGO_PORT: '27017'\n  MONGO_DBNAME: unifi\n  MONGO_AUTHSOURCE: admin\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: unifi-network-application-config\n  labels:\n    app.kubernetes.io/name: unifi-network-application\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: unifi-network-application\n  labels:\n    app.kubernetes.io/name: unifi-network-application\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: unifi-network-application\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: unifi-network-application\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: unifi-network-application\n        image: ghcr.io/linuxserver-playground/unifi-network-application:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: unifi-network-application-env\n        ports:\n        - name: port-8443\n          containerPort: 8443\n          protocol: TCP\n        - name: port-3478\n          containerPort: 3478\n          protocol: UDP\n        - name: port-10001\n          containerPort: 10001\n          protocol: UDP\n        - name: port-8080\n          containerPort: 8080\n          protocol: TCP\n        volumeMounts:\n        - name: unifi-network-application-config\n          mountPath: /config\n      volumes:\n      - name: unifi-network-application-config\n        persistentVolumeClaim:\n          claimName: unifi-network-application-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: unifi-network-application\n  labels:\n    app.kubernetes.io/name: unifi-network-application\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: unifi-network-application\n  ports:\n  - name: port-8443\n    port: 8443\n    targetPort: 8443\n    protocol: TCP\n  - name: port-3478\n    port: 3478\n    targetPort: 3478\n    protocol: UDP\n  - name: port-10001\n    port: 10001\n    targetPort: 10001\n    protocol: UDP\n  - name: port-8080\n    port: 8080\n    targetPort: 8080\n    protocol: TCP\n",
 "quadlet": "# unifi-network-application.container: generated by the hub from https://github.com/linuxserver-playground/docker-unifi-network-application/blob/main/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Unifi-network-application (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/unifi-network-application:latest\nContainerName=unifi-network-application\nAutoUpdate=registry\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nEnvironment=MONGO_USER=unifi\nEnvironment=MONGO_PASS=\nEnvironment=MONGO_HOST=unifi-db\nEnvironment=MONGO_PORT=27017\nEnvironment=MONGO_DBNAME=unifi\nEnvironment=MONGO_AUTHSOURCE=admin\n# Environment=MEM_LIMIT=1024\n# Environment=MEM_STARTUP=1024\n# Environment=MONGO_TLS=\nVolume=/path/to/unifi-network-application/data:/config:Z\nPublishPort=8443:8443\nPublishPort=3478:3478/udp\nPublishPort=10001:10001/udp\nPublishPort=8080:8080\n# PublishPort=1900:1900/udp\n# PublishPort=8843:8843\n# PublishPort=8880:8880\n# PublishPort=6789:6789\n# PublishPort=5514:5514/udp\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
