 "kubernetes": "# Wireguard: generated by the hub from https://github.com/linuxserver-playground/docker-wireguard/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - capability NET_ADMIN: Neccessary for Wireguard to create its VPN interface..\n#   - capability SYS_MODULE (optional): Neccessary for loading Wireguard kernel module if it's not already loaded..\n#   - readOnlyRootFilesystem is supported by this image; enable it once /config and /tmp are mounted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: wireguard-env\n  labels:\n    app.kubernetes.io/name: wireguard\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: wireguard-config\n  labels:\n    app.kubernetes.io/name: wireguard\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: wireguard\n  labels:\n    app.kubernetes.io/name: wireguard\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: wireguard\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: wireguard\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: wireguard\n        image: ghcr.io/linuxserver-playground/wireguard:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: wireguard-env\n        ports:\n        - name: port-51820\n          containerPort: 51820\n          protocol: UDP\n        volumeMounts:\n        - name: wireguard-config\n          mountPath: /config\n        securityContext:\n          capabilities:\n            add:\n            - NET_ADMIN\n      volumes:\n      - name: wireguard-config\n        persistentVolumeClaim:\n          claimName: wireguard-config\n  strategy:\n    type: Recreate\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: wireguard\n  labels:\n    app.kubernetes.io/name: wireguard\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  selector:\n    app.kubernetes.io/name: wireguard\n  ports:\n  - name: port-51820\n    port: 51820\n    targetPort: 51820\n    protocol: UDP\n",
 "quadlet": "# wireguard.container: generated by the hub from https://github.com/linuxserver-playground/docker-wireguard/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Wireguard (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/wireguard:latest\nContainerName=wireguard\nAutoUpdate=registry\nAddCapability=NET_ADMIN\n# AddCapability=SYS_MODULE\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\n# Environment=SERVERURL=wireguard.domain.com\n# Environment=SERVERPORT=51820\n# Environment=PEERS=1\n# Environment=PEERDNS=auto\n# Environment=INTERNAL_SUBNET=10.13.13.0\n# Environment=ALLOWEDIPS=0.0.0.0/0\n# Environment=PERSISTENTKEEPALIVE_PEERS=\n# Environment=LOG_CONFS=true\nVolume=/path/to/wireguard/config:/config:Z\n# Volume=/lib/modules:/lib/modules:Z\nPublishPort=51820:51820/udp\nSysctl=net.ipv4.conf.all.src_valid_mark=1\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
