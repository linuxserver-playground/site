 "kubernetes": "# Wireshark: generated by the hub from https://github.com/linuxserver-playground/docker-wireshark/blob/master/image.yml\n# Storage sizes are placeholders; secrets belong in a Secret, not this ConfigMap.\n# Security notes:\n#   - capability NET_ADMIN: Required to allow packet capture..\n#   - network: host networking is required; hostNetwork is set and no Service is emitted.\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: wireshark-env\n  labels:\n    app.kubernetes.io/name: wireshark\n    app.kubernetes.io/managed-by: linuxserver-hub\ndata:\n  PUID: '1000'\n  PGID: '1000'\n  TZ: Etc/UTC\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: wireshark-config\n  labels:\n    app.kubernetes.io/name: wireshark\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  accessModes:\n  - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: wireshark\n  labels:\n    app.kubernetes.io/name: wireshark\n    app.kubernetes.io/managed-by: linuxserver-hub\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: wireshark\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: wireshark\n        app.kubernetes.io/managed-by: linuxserver-hub\n    spec:\n      containers:\n      - name: wireshark\n        image: ghcr.io/linuxserver-playground/wireshark:latest\n        imagePullPolicy: IfNotPresent\n        envFrom:\n        - configMapRef:\n            name: wireshark-env\n        volumeMounts:\n        - name: wireshark-config\n          mountPath: /config\n        securityContext:\n          capabilities:\n            add:\n            - NET_ADMIN\n      hostNetwork: true\n      volumes:\n      - name: wireshark-config\n        persistentVolumeClaim:\n          claimName: wireshark-config\n  strategy:\n    type: Recreate\n",
 "quadlet": "# wireshark.container: generated by the hub from https://github.com/linuxserver-playground/docker-wireshark/blob/master/image.yml\n# Optional parameters are commented out.\n\n[Unit]\nDescription=Wireshark (LinuxServer.io)\nAfter=network-online.target\nWants=network-online.target\n\n[Container]\nImage=ghcr.io/linuxserver-playground/wireshark:latest\nContainerName=wireshark\nAutoUpdate=registry\nNetwork=host\nAddCapability=NET_ADMIN\nEnvironment=PUID=1000\nEnvironment=PGID=1000\nEnvironment=TZ=Etc/UTC\nVolume=/path/to/wireshark/config:/config:Z\nShmSize=1gb\n\n[Service]\nRestart=always\nTimeoutStartSec=900\n\n[Install]\nWantedBy=default.target\n"
}
