---
import Layout from '@/layouts/Layout.astro';
import ImageRow from '@/components/ImageRow.astro';
import Otter from '@/components/Otter.astro';
import CommandSearch from '@/components/islands/CommandSearch';
import { BASE, withBase } from '@/lib/base';
import { docRedirects, getDocs } from '@/lib/docs';
import { relative } from '@/lib/format';
import { recentlyUpdated, SNAPSHOT_DATE } from '@/lib/images';

const popular = recentlyUpdated(6);
// Old documentation URLs (/general/<slug>/, /selkies/..., /FAQ/) -> their page here, from the docs' `aliases`.
const redirects = docRedirects(await getDocs());
---

<script is:inline define:vars={{ redirects, base: BASE }}>
  // A URL from the retired docs site (with or without this site's base path) goes straight to the page it became.
  var path = location.pathname.replace(/\/?$/, '/');
  if (base && path.indexOf(base + '/') === 0) path = path.slice(base.length);
  var to = redirects[path.toLowerCase()];
  if (to) location.replace(base + to + location.search + location.hash);
  // A run page the site has not pre-rendered yet: the runs page renders it live from the control plane.
  var run = path.match(/^\/fleet\/runs\/(\d+)\/$/);
  if (run) location.replace(base + '/fleet/runs/?run=' + run[1]);
</script>
<Layout section="none" title="Page not found" description="This page drifted off. Search for an image or head back to the fleet." noindex>
  <section class="relative overflow-hidden border-b border-[var(--raft-hair)]">
    <div class="raft-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="raft-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="raft-container relative grid grid-cols-1 items-center gap-10 py-16 md:grid-cols-[1fr_1.1fr] md:py-24">
      <div>
        <p class="font-mono text-sm text-primary">HTTP 404</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">This page drifted off.</h1>
        <p class="mt-5 max-w-md text-lg text-muted-foreground">
          The link may be old: our blog and our docs used to live at different addresses. Search for what you were after, or head back to the fleet.
        </p>
        <div class="mt-8 max-w-md">
          <CommandSearch client:load indexUrl={withBase('/search-index.json')} searchUrl={withBase('/search/')} trigger="input" placeholder="Search images and posts…" className="h-11 rounded-md" />
        </div>
        <p class="mt-6 flex flex-wrap gap-4 text-sm">
          <a href={withBase('/')} class="font-medium underline underline-offset-4 hover:text-primary">Home</a>
          <a href={withBase('/images/')} class="font-medium underline underline-offset-4 hover:text-primary">All images</a>
          <a href={withBase('/docs/')} class="font-medium underline underline-offset-4 hover:text-primary">Docs</a>
          <a href={withBase('/blog/')} class="font-medium underline underline-offset-4 hover:text-primary">Blog</a>
        </p>
      </div>
      <Otter pose="float" class="w-full max-w-lg justify-self-center" />
    </div>
  </section>
  <section class="raft-container pt-14" aria-labelledby="popular-title">
    <h2 id="popular-title" class="raft-eyebrow">Recently built images</h2>
    <ul class="raft-panel mt-4 grid grid-cols-1 p-2 md:grid-cols-2">
      {popular.map((i) => <li><ImageRow image={i} metric={relative(i.version_timestamp.replace(' ', 'T'), SNAPSHOT_DATE)} metricLabel="built" /></li>)}
    </ul>
  </section>
</Layout>
