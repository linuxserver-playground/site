---
import { ArrowRight, BookOpen, FileText, MessagesSquare } from 'lucide-react';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import CommandSearch from '@/components/islands/CommandSearch';
import { withBase } from '@/lib/base';
import { docUrl, getSections } from '@/lib/docs';
import { plural } from '@/lib/format';
import { HUB_URL } from '@/lib/hub';
import { itemListJsonLd } from '@/lib/jsonld';
import { LINKS } from '@/lib/site';

const sections = await getSections();
const pageCount = sections.reduce((n, s) => n + s.sequence.length, 0);
const crumbs = [{ name: 'Docs', href: '/docs/' }];
const description =
  'General guides for running LinuxServer.io containers, the Selkies platform documentation, our policies and the FAQ. Every image has its own page in the catalogue.';

const places = [
  { what: 'Image pages: parameters, setup, builds, mods', where: 'The catalogue', href: '/images/' },
  { what: 'Fleet data, generated documents, build reports', where: 'The hub', href: HUB_URL + '/', external: true },
  { what: 'Live build status, queue, releases', where: 'The control plane', href: LINKS.control, external: true },
  { what: 'Source', where: 'github.com/linuxserver-playground', href: LINKS.github, external: true },
];
const contact = [
  { name: 'Discord', href: LINKS.discord, icon: 'discord' as const },
  { name: 'Discussions', href: LINKS.discussions, icon: 'discussions' as const },
  { name: 'How to get support', href: '/docs/general/how-to-get-support/', icon: 'docs' as const },
];
---

<Layout
  section="docs"
  title="Documentation"
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[itemListJsonLd('Documentation', sections.map((s) => ({ name: s.title, url: s.path })), Astro.site)]}
>
  <PageHeader eyebrow="Documentation" title="Read the docs" lede="How to run our containers, how the Selkies platform works, what we support and the questions we hear most. The page for each image lives in the catalogue." crumbs={crumbs}>
    <div class="mt-8 flex max-w-xl flex-col gap-3 sm:flex-row sm:items-center">
      <CommandSearch client:load indexUrl={withBase('/search-index.json')} searchUrl={withBase('/search/')} trigger="input" placeholder="Search the docs, images and posts…" className="h-11 flex-1 rounded-md" />
      <a href={withBase('/search/')} class="inline-flex h-11 shrink-0 items-center gap-1.5 rounded-md border border-[var(--raft-hair-strong)] bg-background/60 px-4 text-sm font-medium backdrop-blur transition-colors hover:bg-muted">
        Full-text search <ArrowRight className="size-4 opacity-70" aria-hidden="true" />
      </a>
    </div>
    <p class="mt-4 font-mono text-xs text-muted-foreground">{plural(pageCount, 'page')} in {plural(sections.length, 'section')}</p>
  </PageHeader>

  <div class="raft-container pt-10">
    <aside class="raft-panel flex gap-4 p-5" aria-label="About the playground">
      <BookOpen className="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
      <div class="text-sm leading-relaxed">
        <p class="font-medium">This is the v2 playground.</p>
        <p class="mt-1 text-muted-foreground">
          Everything under <code class="font-mono text-foreground">linuxserver-playground</code> is a proof of concept of the next LinuxServer.io build system. The images it publishes to{' '}
          <code class="font-mono text-foreground">ghcr.io/linuxserver-playground/</code> are not for production use. The production images and their documentation remain at{' '}
          <a href="https://github.com/linuxserver" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-foreground">linuxserver<span class="sr-only"> (opens in a new tab)</span></a> and{' '}
          <a href="https://docs.linuxserver.io" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-foreground">docs.linuxserver.io<span class="sr-only"> (opens in a new tab)</span></a>.
        </p>
      </div>
    </aside>
  </div>

  <section class="raft-container pt-14" aria-labelledby="sections-title">
    <h2 id="sections-title" class="raft-eyebrow"><span class="text-primary" aria-hidden="true">//</span> Sections</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        sections.map((s) => (
          <section class="raft-panel raft-glow-edge flex flex-col p-6" aria-labelledby={`section-${s.id}`}>
            <h3 id={`section-${s.id}`} class="text-xl font-semibold tracking-tight">
              <a href={s.url} class="hover:text-primary">
                {s.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-muted-foreground">{s.description}</p>
            {s.groups.map((g) => (
              <div class="mt-5">
                {g.name && <h4 class="mb-1.5 font-mono text-[0.6875rem] tracking-wide text-muted-foreground uppercase">{g.name}</h4>}
                <ul class="grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2" aria-label={g.name ? `${g.name} pages` : `Pages in ${s.title}`}>
                  {g.pages.map((p) => (
                    <li>
                      <a href={docUrl(p)} class="inline-flex items-start gap-1.5 text-foreground/90 hover:text-primary">
                        <FileText className="mt-1 size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
                        {p.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <a href={s.url} class="group mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium hover:text-primary">
              {s.intro ? `Open ${s.title}` : `All ${s.title} pages`}
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </a>
          </section>
        ))
      }
    </div>
  </section>

  <div class="raft-container grid grid-cols-1 gap-10 pt-16 lg:grid-cols-2">
    <section aria-labelledby="places-title">
      <h2 id="places-title" class="text-2xl font-semibold tracking-tight">Where things live</h2>
      <p class="mt-3 text-muted-foreground">
        The image pages are not written here. Every image repository carries one manifest, <code class="font-mono text-sm text-foreground">image.yml</code>; the hub renders the data from it and this site shows the result. The same manifest produces the README, the store templates, the SWAG proxy confs and the Kubernetes and Podman documents, so the page you read, the template you import and the container you run always describe the same thing.
        <a href={withBase('/docs/general/how-a-build-happens/')} class="underline underline-offset-4 hover:text-foreground">How a build happens</a> walks through the pipeline; <a href={withBase('/docs/general/contributing-an-image/')} class="underline underline-offset-4 hover:text-foreground">Contributing an image</a> explains how to change one.
      </p>
      <ul class="raft-panel mt-5 divide-y divide-[var(--raft-hair)] text-sm">
        {
          places.map((p) => (
            <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3">
              <span class="text-muted-foreground">{p.what}</span>
              <a href={p.href.startsWith('/') ? withBase(p.href) : p.href} class="font-medium hover:text-primary" {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {p.where}
                {p.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="contact-title">
      <h2 id="contact-title" class="text-2xl font-semibold tracking-tight">Want to get hold of the team?</h2>
      <p class="mt-3 text-muted-foreground">
        The team lives primarily in our Discord server; the playground also has its own GitHub Discussions. Before asking, please read how to get support and the <a href={withBase('/docs/misc/support-policy/')} class="underline underline-offset-4 hover:text-foreground">support policy</a>.
      </p>
      <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          contact.map((c) => (
            <li>
              <a
                href={c.href.startsWith('/') ? withBase(c.href) : c.href}
                class="raft-panel flex h-full flex-col gap-3 p-4 text-sm font-medium hover:bg-muted/40"
                {...(c.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener' })}
              >
                <span class="grid size-9 place-items-center rounded-md border border-[var(--raft-hair)] bg-[var(--raft-surface)] text-primary">
                  {c.icon === 'discord' && <Icon name="discord" class="size-4" />}
                  {c.icon === 'discussions' && <MessagesSquare className="size-4" aria-hidden="true" />}
                  {c.icon === 'docs' && <BookOpen className="size-4" aria-hidden="true" />}
                </span>
                {c.name}
                {!c.href.startsWith('/') && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
