---
/**
 * The website editor (/edit/), opened from the Edit, Delete, New post and New page buttons the blog and the docs
 * show to people who can edit the site. Every change is a commit on the change's own branch and a pull request;
 * merging it publishes it. The island does the work against the control plane (control/editor.py); this page hands
 * it what the build knows: authors, tags and images to suggest, and the docs' sidebar for the preview. Not indexed.
 */
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Editor from '@/components/islands/editor/Editor';
import type { EditorData } from '@/components/islands/editor/Workspace';
import { docNav, getSections } from '@/lib/docs';
import { getApps } from '@/lib/images';
import { collectTags, getPosts, slugify } from '@/lib/posts';

const data: EditorData = {
  authors: (await getCollection('authors')).map((a) => ({
    id: a.id,
    name: a.data.name,
    keys: [...new Set([a.id, a.data.name, a.data.github ?? '', ...a.data.aliases].filter(Boolean).map(slugify))],
  })),
  tags: collectTags(await getPosts()).map((t) => t.name),
  containers: getApps().map((i) => i.name),
  sections: (await getSections()).map(docNav),
};
---

<Layout section="none" title="Editor" description="Write and edit the LinuxServer.io documentation and blog. Every change is a pull request; merging it publishes it." noindex>
  <div class="mx-auto w-full max-w-[110rem] px-4 pt-6 pb-16 md:px-6">
    <Editor client:load data={data} />
    <noscript><p class="text-sm text-muted-foreground">The editor needs JavaScript.</p></noscript>
  </div>
</Layout>
