---
import Layout from '@/layouts/Layout.astro';
import BuildRow from '@/components/BuildRow.astro';
import PageHeader from '@/components/PageHeader.astro';
import Panel from '@/components/Panel.astro';
import SectionHead from '@/components/SectionHead.astro';
import StatTile from '@/components/StatTile.astro';
import { withBase } from '@/lib/base';
import { allBuilds, buildUrl } from '@/lib/builds';
import { getBases, getStaleness } from '@/lib/fleet';
import { formatDate, relative, shortDigest } from '@/lib/format';
import { HUB_META, HUB_URL, hubApi } from '@/lib/hub';
import { getImage, getImages, SNAPSHOT_DATE } from '@/lib/images';
import { LINKS } from '@/lib/site';
import { stat } from '@/lib/stats';
import { ArrowUpRight, Check, X } from 'lucide-react';

const bases = getBases();
const staleness = getStaleness();
const builds = allBuilds();
const images = getImages();
const byFamily = new Map<string, number>();
for (const i of images) byFamily.set(i.base ?? 'unknown', (byFamily.get(i.base ?? 'unknown') ?? 0) + 1);
const families = [...byFamily].sort((a, b) => b[1] - a[1]);
const famMax = families[0]?.[1] ?? 1;
const status = HUB_META.status;
const crumbs = [{ name: 'Fleet', href: '/fleet/' }];
---

<Layout
  section="fleet"
  title="Fleet"
  description="The LinuxServer.io playground fleet: base images and their digests, builds that are behind their base, every retained build and the hub's own health."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Fleet"
    title="What the fleet is built on"
    lede="Every image starts from one of a few base images. The hub records which digest each build used, so it can tell which images are behind their base and need a rebuild."
    crumbs={crumbs}
  >
    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
      {
        [stat.images, stat.builds, stat.updatedThisWeek].map((x) => (
          <div class="flex items-baseline gap-2">
            <dt class="sr-only">{x.label}</dt>
            <dd class="text-foreground">{x.value}</dd>
            <dd class="text-muted-foreground" aria-hidden="true">{x.label}</dd>
          </div>
        ))
      }
      <div class="flex items-baseline gap-2">
        <dt class="text-muted-foreground">hub data</dt>
        <dd><time datetime={SNAPSHOT_DATE.toISOString()}>{formatDate(SNAPSHOT_DATE)}</time></dd>
      </div>
    </dl>
  </PageHeader>

  <section class="raft-container pt-12" aria-labelledby="bases-title">
    <SectionHead eyebrow="Base images" title={`${bases.length} base ${bases.length === 1 ? 'reference' : 'references'} in use`} id="bases-title" description="From /api/v1/fleet/bases.json: the FROM reference of each image's newest build, the images on it, and every digest the hub has seen a build use." />
    <div class="mt-8 grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="space-y-3">
        {
          bases.map((b) => (
            <article class="raft-panel p-5">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-mono text-base font-semibold break-all">{b.image}</h3>
                  <p class="mt-1 text-sm text-muted-foreground">
                    family <span class="font-mono text-foreground">{b.family}</span> · {b.images.length} {b.images.length === 1 ? 'image' : 'images'}
                    {b.newest_seen && (
                      <>
                        {' '}· newest digest first used <time datetime={b.newest_seen}>{formatDate(b.newest_seen)}</time>
                      </>
                    )}
                  </p>
                </div>
                <a href={`https://${b.image.split(':')[0]}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground hover:text-foreground">
                  registry <ArrowUpRight className="size-3.5" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
                </a>
              </div>
              <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`Images on ${b.image}`}>
                {b.images.map((name) => (
                  <li>
                    {getImage(name) ? (
                      <a href={withBase(`/images/${name}/`)} class="rounded-md border border-[var(--raft-hair)] px-2 py-0.5 font-mono text-xs hover:border-[var(--raft-hair-strong)] hover:text-primary">
                        {name}
                      </a>
                    ) : (
                      <span class="rounded-md border border-[var(--raft-hair)] px-2 py-0.5 font-mono text-xs text-muted-foreground">{name}</span>
                    )}
                  </li>
                ))}
              </ul>
              <details class="mt-3">
                <summary class="cursor-pointer font-mono text-xs text-muted-foreground hover:text-foreground">
                  {b.digests.length} digest{b.digests.length === 1 ? '' : 's'} seen
                </summary>
                <ol class="mt-2 divide-y divide-[var(--raft-hair)] text-xs">
                  {b.digests.map((d) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-1.5">
                      <span class="font-mono" title={d.digest}>
                        {shortDigest(d.digest)}
                        {d.digest === b.newest_digest && <span class="ml-2 rounded border border-primary/40 px-1 py-px text-[0.6875rem] text-primary">newest</span>}
                      </span>
                      <span class="font-mono text-muted-foreground">
                        <time datetime={d.first_seen}>{formatDate(d.first_seen)}</time>
                        {d.last_seen !== d.first_seen && (
                          <>
                            {' '}– <time datetime={d.last_seen}>{formatDate(d.last_seen)}</time>
                          </>
                        )}{' '}
                        · {d.images.join(', ')}
                      </span>
                    </li>
                  ))}
                </ol>
              </details>
            </article>
          ))
        }
        {bases.length === 0 && <p class="raft-panel p-5 text-sm text-muted-foreground">The hub has not ingested a build yet.</p>}
      </div>
      <Panel title="images per base family" bodyClass="p-5">
        <ol class="space-y-2.5">
          {
            families.map(([fam, n]) => (
              <li>
                <span class="flex items-baseline justify-between text-sm">
                  <span class="font-mono">{fam}</span>
                  <span class="font-mono text-xs text-muted-foreground tabular-nums">{n}</span>
                </span>
                <span class="mt-1 block h-1.5 rounded-full bg-[var(--raft-bar-track)]" aria-hidden="true">
                  <span class="block h-full rounded-full bg-[var(--raft-bar)] opacity-80" style={`width:${(n / famMax) * 100}%`} />
                </span>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 border-t border-[var(--raft-hair)] pt-4 text-xs text-muted-foreground">
          Base images are pulled read-only from <span class="font-mono">ghcr.io/linuxserver/baseimage-*</span> until a base image repository joins the playground.
        </p>
      </Panel>
    </div>
  </section>

  <section class="raft-container pt-20" aria-labelledby="stale-title">
    <SectionHead
      eyebrow="Staleness"
      title={staleness.stale.length ? `${staleness.stale.length} ${staleness.stale.length === 1 ? 'build is' : 'builds are'} behind their base` : 'No build is behind its base'}
      id="stale-title"
      description={`From /api/v1/fleet/staleness.json: ${staleness.checked} newest builds checked against the newest digest seen for their base image.`}
    />
    {
      staleness.stale.length > 0 ? (
        <div class="raft-panel mt-8 relative overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-[var(--raft-hair)] bg-[var(--raft-surface)] font-mono text-[0.6875rem] text-muted-foreground uppercase">
              <tr>
                <th scope="col" class="px-4 py-2.5 font-normal">Image</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Build</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Base used</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Newer base since</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Why</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--raft-hair)]">
              {staleness.stale.map((s) => (
                <tr class="align-top">
                  <th scope="row" class="px-4 py-3 font-mono text-[0.8125rem] font-normal">
                    <a href={withBase(`/images/${s.image}/`)} class="hover:text-primary">{s.image}</a>
                  </th>
                  <td class="px-4 py-3 font-mono text-xs">
                    <a href={withBase(buildUrl(s.image, s.tag))} class="underline-offset-4 hover:text-primary hover:underline">{s.tag}</a>
                    <span class="block text-muted-foreground">{s.branch} · <time datetime={s.built}>{formatDate(s.built)}</time></span>
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-muted-foreground" title={s.base_digest ?? undefined}>
                    {s.base}
                    <span class="block">{shortDigest(s.base_digest)}</span>
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-muted-foreground" title={s.newest_base_digest ?? undefined}>
                    <time datetime={s.newest_base_built}>{formatDate(s.newest_base_built)}</time>
                    <span class="block">{shortDigest(s.newest_base_digest)}</span>
                  </td>
                  <td class="px-4 py-3 text-xs text-muted-foreground">{s.reason}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="raft-panel mt-8 flex items-center gap-2 p-5 text-sm text-muted-foreground">
          <Check className="size-4 text-[var(--raft-ok)]" aria-hidden="true" /> Every newest build used the newest base digest the hub has seen.
        </p>
      )
    }
  </section>

  <section class="raft-container pt-20" aria-labelledby="builds-title" id="builds">
    <SectionHead eyebrow="Builds" title={`${builds.length} retained ${builds.length === 1 ? 'build' : 'builds'}`} id="builds-title" description="Every build the hub currently holds, newest first. Each one has a page with its layers, files, packages, init graph and diff." link={{ label: 'Build history on the hub', href: `${HUB_URL}/builds/` }} />
    <div class="raft-panel mt-8 p-2">
      <ol class="divide-y divide-[var(--raft-hair)]">
        {builds.map((b) => <li><BuildRow build={b} /></li>)}
      </ol>
      {builds.length === 0 && <p class="p-4 text-sm text-muted-foreground">No build has been ingested yet.</p>}
    </div>
  </section>

  <section class="raft-container pt-20" aria-labelledby="hub-title">
    <SectionHead eyebrow="Data source" title="The hub" id="hub-title" description="This site is built from the hub's static API; live build status lives on the control plane and is only linked." link={{ label: 'Live builds', href: LINKS.control }} />
    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <StatTile stat={stat.images} />
      <StatTile stat={stat.builds} />
      <StatTile stat={stat.readonly} />
      <StatTile stat={stat.nonroot} />
    </div>
    {
      status && (
        <div class="raft-panel mt-3 p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="raft-eyebrow">Hub sources</h3>
            <span class:list={['inline-flex items-center gap-1 font-mono text-xs', status.health === 'Success' ? 'text-[var(--raft-ok)]' : 'text-destructive']}>
              {status.health === 'Success' ? <Check className="size-3.5" aria-hidden="true" /> : <X className="size-3.5" aria-hidden="true" />}
              {status.health === 'Success' ? 'healthy' : 'degraded'}
            </span>
          </div>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-4">
            {Object.entries(status.sources).map(([name, s]) => (
              <div class="flex items-baseline justify-between gap-3 border-t border-[var(--raft-hair)] pt-2">
                <dt class="font-mono text-xs">{name}</dt>
                <dd class:list={['font-mono text-xs', s.ok ? 'text-muted-foreground' : 'text-destructive']} title={s.error ?? undefined}>
                  {s.ok ? (s.fetched_at ? relative(s.fetched_at, SNAPSHOT_DATE) : 'ok') : 'error'}
                </dd>
              </div>
            ))}
          </dl>
          {Object.keys(status.rejected).length > 0 && (
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer font-mono text-xs text-destructive">{Object.keys(status.rejected).length} rejected release(s)</summary>
              <ul class="mt-2 space-y-1 font-mono text-xs text-muted-foreground">
                {Object.entries(status.rejected).map(([k, r]) => (
                  <li>
                    <span class="text-foreground">{k}</span>: {r.error}
                  </li>
                ))}
              </ul>
            </details>
          )}
          <p class="mt-4 font-mono text-[0.6875rem] text-muted-foreground">
            <a href={hubApi('status.json')} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">api/v1/status.json</a>
          </p>
        </div>
      )
    }
  </section>
</Layout>
