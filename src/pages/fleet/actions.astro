---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Actions } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Actions', href: '/fleet/actions/' },
];
---

<Layout section="fleet" title="Actions" description="Member actions on LinuxServer.io builds: re-runs, cancellations, dispatches, package checks and skip flags." breadcrumbs={crumbs}>
  <FleetShell current="actions" title="Member actions" lede="Re-runs, cancellations, dispatches and skip flags by team members, newest first." crumbs={crumbs} controlPath="/management">
    <Actions client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/management`} />
  </FleetShell>
</Layout>
