---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Actions } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Actions', href: '/fleet/actions/' },
];
---

<Layout section="fleet" title="Actions" description="The public log of member actions on the LinuxServer.io playground's control plane: re-runs, cancellations, dispatches, package checks, skip flags and reconciliations, live." breadcrumbs={crumbs}>
  <FleetShell current="actions" title="Member actions" lede="Everything an organisation member did through the control plane, newest first. Every attempt that passed sign-in is logged, whether GitHub accepted it or not." crumbs={crumbs} controlPath="/management">
    <Actions client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/management`} />
    <p class="mt-4 text-xs text-muted-foreground">
      Members sign in with GitHub through the control plane (the Sign in button in the header); organisation membership is checked on every action. Actions are rate-limited to 30 per member per hour.
    </p>
  </FleetShell>
</Layout>
