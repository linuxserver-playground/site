---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import BuildRow from '@/components/BuildRow.astro';
import SectionHead from '@/components/SectionHead.astro';
import { Builds } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { allBuilds, knownBuildTags } from '@/lib/builds';
import { CONTROL_URL } from '@/lib/control';
import { HUB_URL } from '@/lib/hub';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Builds', href: '/fleet/builds/' },
];
const builds = allBuilds();
const known = knownBuildTags();
---

<Layout section="fleet" title="Builds" description="Recent build summaries from the control plane and every retained build the hub holds, each with a page showing its CI report, layers, files, packages, init graph and diff." breadcrumbs={crumbs}>
  <FleetShell current="builds" title="Builds" lede="What the shared workflow reported for each build as it finished, live; below, every build the hub still holds, each with its own page." crumbs={crumbs} controlPath="/releases">
    <Builds client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} known={known} fallback={`${CONTROL_URL}/releases`} />

    <section class="pt-16" aria-labelledby="builds-title" id="retained">
      <SectionHead eyebrow="From the hub" title={`${builds.length} retained ${builds.length === 1 ? 'build' : 'builds'}`} id="builds-title" description="Every build the hub currently holds, newest first. Each one has a page with its CI report, layers, files, packages, init graph and diff." link={{ label: 'Build history on the hub', href: `${HUB_URL}/builds/` }} />
      <div class="raft-panel mt-8 p-2">
        <ol class="divide-y divide-[var(--raft-hair)]">
          {builds.map((b) => <li><BuildRow build={b} /></li>)}
        </ol>
        {builds.length === 0 && <p class="p-4 text-sm text-muted-foreground">No build has been ingested yet.</p>}
      </div>
    </section>
  </FleetShell>
</Layout>
