---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import BuildRow from '@/components/BuildRow.astro';
import SectionHead from '@/components/SectionHead.astro';
import { Builds } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { allBuilds, knownBuildTags } from '@/lib/builds';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Builds', href: '/fleet/builds/' },
];
const builds = allBuilds();
const known = knownBuildTags();
---

<Layout section="fleet" title="Builds" description="Recent LinuxServer.io builds with their CI report, layers, files, packages, init graph and diff." breadcrumbs={crumbs}>
  <FleetShell current="builds" title="Builds" lede="Recent builds and their results." crumbs={crumbs} controlPath="/releases">
    <Builds client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} known={known} fallback={`${CONTROL_URL}/releases`} />

    <section class="pt-16" aria-labelledby="builds-title" id="retained">
      <SectionHead eyebrow="History" title={`${builds.length} retained ${builds.length === 1 ? 'build' : 'builds'}`} id="builds-title" description="Newest first." />
      <div class="raft-panel mt-8 p-2">
        <ol class="divide-y divide-[var(--raft-hair)]">
          {builds.map((b) => <li><BuildRow build={b} /></li>)}
        </ol>
        {builds.length === 0 && <p class="p-4 text-sm text-muted-foreground">No builds yet.</p>}
      </div>
    </section>
  </FleetShell>
</Layout>
