---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Issues } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Issues', href: '/fleet/issues/' },
];
---

<Layout section="fleet" title="Issues" description="Open issues across LinuxServer.io repositories." breadcrumbs={crumbs}>
  <FleetShell current="issues" title="Issues" lede="Open issues across our repositories." crumbs={crumbs} controlPath="/issues">
    <Issues client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/issues`} />
  </FleetShell>
</Layout>
