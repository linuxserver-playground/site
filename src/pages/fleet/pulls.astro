---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Pulls } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Pull requests', href: '/fleet/pulls/' },
];
---

<Layout section="fleet" title="Pull requests" description="Open pull requests across the LinuxServer.io playground with their build status, quarantined image tag, review state and age, live from the control plane." breadcrumbs={crumbs}>
  <FleetShell current="pulls" title="Pull requests" lede="Every open pull request in the organisation, the run that built it and the quarantined image tag it produced." crumbs={crumbs} controlPath="/pulls">
    <Pulls client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/pulls`} />
  </FleetShell>
</Layout>
