---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Pulls } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Pull requests', href: '/fleet/pulls/' },
];
---

<Layout section="fleet" title="Pull requests" description="Open pull requests across LinuxServer.io repositories with their build status and image tag." breadcrumbs={crumbs}>
  <FleetShell current="pulls" title="Pull requests" lede="Open pull requests, their builds and test images." crumbs={crumbs} controlPath="/pulls">
    <Pulls client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/pulls`} />
  </FleetShell>
</Layout>
