---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Queue } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Queue', href: '/fleet/queue/' },
];
---

<Layout section="fleet" title="Queue" description="Queued and running LinuxServer.io build jobs." breadcrumbs={crumbs}>
  <FleetShell current="queue" title="Queue and capacity" lede="Jobs waiting for a runner and jobs in progress." crumbs={crumbs} controlPath="/queue">
    <Queue client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/queue`} />
  </FleetShell>
</Layout>
