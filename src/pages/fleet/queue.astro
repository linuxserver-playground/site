---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Queue } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Queue', href: '/fleet/queue/' },
];
---

<Layout section="fleet" title="Queue" description="Queued and in-progress GitHub Actions jobs across the LinuxServer.io playground against the organisation's concurrency limit, with runner labels, live from the control plane." breadcrumbs={crumbs}>
  <FleetShell current="queue" title="Queue and capacity" lede="What is waiting for a runner and what is running, measured against the organisation's concurrent job limit." crumbs={crumbs} controlPath="/queue">
    <Queue client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/queue`} />
  </FleetShell>
</Layout>
