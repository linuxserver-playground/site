---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Releases } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { knownBuildTags } from '@/lib/builds';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Releases', href: '/fleet/releases/' },
];
const known = knownBuildTags();
---

<Layout section="fleet" title="Releases" description="LinuxServer.io releases, newest first, with upstream version and CI results." breadcrumbs={crumbs}>
  <FleetShell current="releases" title="Releases" lede="Releases, newest first." crumbs={crumbs} controlPath="/releases">
    <Releases client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} known={known} fallback={`${CONTROL_URL}/releases`} />
  </FleetShell>
</Layout>
