---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Releases } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { knownBuildTags } from '@/lib/builds';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Releases', href: '/fleet/releases/' },
];
const known = knownBuildTags();
---

<Layout section="fleet" title="Releases" description="GitHub Releases across the LinuxServer.io playground, newest first, with the build's reason, upstream version and CI results, live from the control plane." breadcrumbs={crumbs}>
  <FleetShell current="releases" title="Releases" lede="Every Release the organisation published, newest first, with the build that made it and a link to its CI results page." crumbs={crumbs} controlPath="/releases">
    <Releases client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} known={known} fallback={`${CONTROL_URL}/releases`} />
  </FleetShell>
</Layout>
