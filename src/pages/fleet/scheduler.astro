---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Scheduler } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Scheduler', href: '/fleet/scheduler/' },
];
---

<Layout section="fleet" title="Scheduler" description="Upstream, release and package checks for LinuxServer.io images, upcoming checks and active skip flags." breadcrumbs={crumbs}>
  <FleetShell
    current="scheduler"
    title="Scheduler"
    lede="Upstream checks run hourly, package checks weekly."
    crumbs={crumbs}
    controlPath="/scheduler"
  >
    <Scheduler client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/scheduler`} />
  </FleetShell>
</Layout>
