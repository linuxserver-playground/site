---
import Layout from '@/layouts/Layout.astro';
import FleetShell from '@/components/FleetShell.astro';
import { Scheduler } from '@/components/islands/fleet/Lists';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';

const crumbs = [
  { name: 'Fleet', href: '/fleet/' },
  { name: 'Scheduler', href: '/fleet/scheduler/' },
];
---

<Layout section="fleet" title="Scheduler" description="The control plane's scheduler: every upstream, release and package-check decision with its reason, the next 24 hours of checks and the active skip flags, live." breadcrumbs={crumbs}>
  <FleetShell
    current="scheduler"
    title="Scheduler"
    lede="Every live branch is checked for a new upstream version once an hour and for packages once a week. This is the decision log, filterable, with what comes next and which flags hold builds back."
    crumbs={crumbs}
    controlPath="/scheduler"
  >
    <Scheduler client:load runsBase={withBase('/fleet/runs/')} buildsBase={withBase('/images/')} fallback={`${CONTROL_URL}/scheduler`} />
    <p class="mt-4 text-xs text-muted-foreground">
      Outcomes: <span class="font-mono">unchanged</span> released equals upstream; <span class="font-mono">dispatch</span> a build was started; <span class="font-mono">skipped</span> a flag, a running build, the two-hour cooldown or the version source held it back; <span class="font-mono">error</span> the resolver or GitHub failed. Filters are kept in the URL.
    </p>
  </FleetShell>
</Layout>

<script>
  // The island reads its initial filters from the URL once it mounts; nothing to do here without JS.
</script>
