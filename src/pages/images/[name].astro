---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BuildRow from '@/components/BuildRow.astro';
import ClassBadge from '@/components/ClassBadge.astro';
import ImageTile from '@/components/ImageTile.astro';
import Panel from '@/components/Panel.astro';
import PostCard from '@/components/PostCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import ImageLogo from '@/components/ImageLogo.astro';
import AnchorHeading from '@/components/AnchorHeading.astro';
import CopyButton from '@/components/islands/CopyButton';
import HeroScreenshot from '@/components/islands/HeroScreenshot';
import ContributeCallout from '@/components/ContributeCallout.astro';
import NewerBuilds from '@/components/islands/NewerBuilds';
import ImageFleet, { type SnapshotBranch } from '@/components/islands/fleet/ImageFleet';
import InstallMenu from '@/components/islands/InstallMenu';
import ConfigLab from '@/components/islands/ConfigLab';
import ProxyTabs from '@/components/islands/ProxyTabs';
import { withBase } from '@/lib/base';
import { buildResult, buildUrl, getBuildRecord, getBuilds, getHistory, getImageExtras, reasonLabel } from '@/lib/builds';
import { dependents, installOptions, modPath, modsForImage } from '@/lib/fleet';
import { bytes, formatDate, grouped, isoDate, relative, shortSha } from '@/lib/format';
import { CONTROL_URL, controlImageUrl } from '@/lib/control';
import { hubApi, hubFilesUrl, hubHistoryUrl, hubReportFileUrl, HUB_URL, type Arch } from '@/lib/hub';
import { getAllImages, hasRealSummary, hubDate, IMAGE_KINDS, relatedImages, SNAPSHOT_DATE, type Image } from '@/lib/images';
import { getCollection, render } from 'astro:content';
import { buildLabModel } from '@/lib/lab';
import { getProotApps, supportsProotApps } from '@/lib/proot-apps';
import type { ProxySample } from '@/lib/proxy';
import { imageJsonLd } from '@/lib/jsonld';
import { blockMarkdown, inlineMarkdown } from '@/lib/markdown/inline';
import { getPosts, postsForImage } from '@/lib/posts';
import { LINKS, SUPPORT_CHANNELS } from '@/lib/site';
import { imagePrompts } from '@/lib/contribute';
import { toPostViews } from '@/lib/views';
import { AlertTriangle, AppWindow, ArrowRight, ArrowUpRight, Check, Minus, X } from 'lucide-react';

export function getStaticPaths() {
  return getAllImages().map((image) => ({ params: { name: image.name }, props: { image } }));
}

const { image } = Astro.props as { image: Image };
// Base images and internal tools get the same build data but no config lab, install menu, mods or "similar images":
// they are built on or used by other images, not run as applications.
const app = image.kind === 'app';
const kind = IMAGE_KINDS[image.kind];
const usedBy = app ? [] : dependents(image.name);
const usedByCount = new Set(usedBy.flatMap((d) => d.images)).size;
const kindNote =
  image.kind === 'base'
    ? 'A base image: LinuxServer images are built FROM it. It is not meant to run on its own and is not in the stores.'
    : image.kind === 'tool'
      ? "An internal tool: the project's own tooling runs it, or other images copy from it. It is not an application and is not in the stores."
      : null;
const summary = app || hasRealSummary(image) ? image.summary : kindNote!;
const related = app ? relatedImages(image, 4) : [];
const posts = await toPostViews(postsForImage(image.name, await getPosts(), 3));
const extras = getImageExtras(image.name);
const builds = getBuilds(image.name);
const history = getHistory(image.name);
const historyCount = Object.values(history).reduce((a, b) => a + b.length, 0);
const mods = modsForImage(image.name);
const c = image.config ?? {};

const lab = buildLabModel(image, extras, [...mods.own, ...mods.curated, ...mods.universal]);
const listedMods = [...mods.own, ...mods.curated];
const labSources = {
  compose: hubApi(`catalog/${image.name}/docker-compose.yml`),
  kubernetes: image.links.kubernetes ?? undefined,
  quadlet: image.links.quadlet ?? undefined,
};
const proxySample: ProxySample | null = extras.proxy?.subdomain
  ? {
      image: image.name,
      subdomain: extras.proxy.subdomain.trimEnd(),
      subfolder: extras.proxy.subfolder?.trimEnd() ?? null,
      port: extras.proxy.port,
      scheme: extras.proxy.scheme,
      name: extras.proxy.subdomain.match(/set \$upstream_app (\S+);/)?.[1] ?? image.name,
      baseUrlNote: extras.proxy.base_url_note ?? null,
    }
  : null;

// The latest live build: the newest build of the branch that publishes `latest`, else the newest of all.
const latestTag = image.releases.find((r) => r.release_tag === 'latest')?.tag;
const latest = (latestTag && builds.find((b) => b.tag === latestTag)) || builds[0];
const latestRecord = latest ? getBuildRecord(image.name, latest.tag) : undefined;
const latestArches = latest ? (latest.platforms.filter((p) => p.result === 'success').map((p) => p.arch) as Arch[]) : [];
const latestFiles: Partial<Record<Arch, string[]>> = {};
for (const a of latestArches) {
  const urls = [latest!.links.files[a], latest!.links.files_release?.[a], hubFilesUrl(image.name, latest!.tag, a)].filter((u): u is string => !!u);
  if (urls.length) latestFiles[a] = [...new Set(urls)];
}
const latestHasFiles = latestArches.some((a) => (latestFiles[a]?.length ?? 0) > 0) && !!latestRecord;
const latestResult = latest ? buildResult(latest) : null;
// The CI screenshot of the latest build, x86-64 first, shown in the header so readers see the app before reading about it.
const shotArch = (['amd64', 'arm64'] as Arch[]).find((a) => latestRecord?.tests?.reports?.[a]?.files?.screenshot);
const heroShot =
  latest && shotArch
    ? {
        url: hubReportFileUrl(image.name, latest.tag, shotArch, latestRecord!.tests!.reports![shotArch]!.files!.screenshot!),
        alt: `Screenshot of ${image.name} ${latest.tag}, taken by the test harness on ${shotArch}`,
        caption: `${latest.tag} · ${shotArch} · CI screenshot`,
        buildUrl: withBase(`${buildUrl(image.name, latest.tag)}#ci`),
      }
    : null;
const latestFacts: { label: string; value: string; mono?: boolean; title?: string }[] = latest
  ? [
      { label: 'Base image', value: latest.base.image.replace('ghcr.io/linuxserver/', ''), mono: true, title: latest.base.image },
      { label: 'Upstream version', value: latest.upstream_version, mono: true },
      ...latest.platforms
        .filter((p) => p.result === 'success')
        .map((p) => ({ label: `${p.arch} compressed`, value: `${bytes(p.size)}${p.layers ? ` · ${p.layers} layers` : ''}`, mono: true })),
      ...Object.entries(latestRecord?.build.packages ?? {}).map(([a, s]) => ({ label: `${a} packages`, value: `${grouped(s.count)} · ${s.distro}`, mono: true })),
      { label: 'Tests', value: latest.test_success === null || latest.test_success === undefined ? 'not run' : latest.test_success ? 'passed' : 'failed' },
      { label: 'Built', value: relative(latest.created, SNAPSHOT_DATE), title: formatDate(latest.created) },
      { label: 'Reason', value: reasonLabel(latest.reason) },
    ]
  : [];

// Section B: the hub's view of each live branch, server-rendered under the live fleet panel.
const fleetSnapshot: SnapshotBranch[] = image.releases.map((r) => ({
  branch: r.branch,
  release_tag: r.release_tag,
  tag: r.tag ?? null,
  upstream: r.upstream_version ?? null,
  created: r.created ?? null,
  test_success: r.test_success ?? null,
}));
const knownTags = builds.map((b) => b.tag);

const install = installOptions(image.name, { kubernetes: !!extras.kubernetes, quadlet: !!extras.quadlet, proxy: !!extras.proxy?.subdomain });

const crumbs = [
  { name: 'Images', href: '/images/' },
  ...(app ? [] : [{ name: kind.label, href: kind.href }]),
  { name: image.name, href: image.url },
];
// Base images and tools often publish no `latest`; pull the default branch's tag then.
const pullTag = image.releases.some((r) => r.release_tag === 'latest') ? 'latest' : (image.releases[0]?.release_tag ?? 'latest');
const pull = `docker pull ${image.ref}:${pullTag}`;
const built = hubDate(image.version_timestamp);
// The image's README, section by section (src/content/imagedocs/, from the hub's docs.json). Sections the page
// already builds natively from structured data are skipped; everything else is shown in README order, so a section
// added to the builder templates appears here without a site change.
const NATIVE_DOC_SECTIONS = new Set(['supported-architectures', 'version-tags', 'usage', 'parameters', 'docker-mods', 'versions']);
const docEntries = (await getCollection('imagedocs', (e) => e.data.image === image.name)).sort((a, b) => a.data.order - b.data.order);
const docSection = async (entry: (typeof docEntries)[number]) => ({ id: entry.data.section, title: entry.data.title, Content: (await render(entry)).Content });
const setupDoc = docEntries.find((e) => e.data.section === 'application-setup');
const supportDoc = docEntries.find((e) => e.data.section === 'support-info');
const SetupContent = setupDoc ? (await docSection(setupDoc)).Content : null;
const SupportContent = supportDoc ? (await docSection(supportDoc)).Content : null;
const moreDocs = await Promise.all(
  docEntries.filter((e) => !NATIVE_DOC_SECTIONS.has(e.data.section) && e !== setupDoc && e !== supportDoc).map(docSection),
);
const DOC_PROSE =
  'post-body prose mt-3 max-w-none text-[0.9375rem] text-muted-foreground prose-p:my-2 prose-a:text-foreground prose-headings:text-foreground prose-h3:mt-6 prose-h3:mb-2 prose-h3:text-base prose-h4:text-sm prose-code:text-foreground dark:prose-invert';
const description = summary.length > 155 ? summary.slice(0, 152).replace(/\s+\S*$/, '') + '…' : summary;

const tables = [
  {
    id: 'ports',
    title: 'Ports',
    head: ['Port', 'Function'],
    rows: (c.networking === 'host' ? [] : (c.ports ?? [])).map((p) => ({ key: `${p.external}:${p.internal}`, desc: p.desc, optional: p.optional })),
  },
  { id: 'env', title: 'Environment variables', head: ['Variable', 'Function'], rows: (c.env_vars ?? []).map((e) => ({ key: `${e.name}=${e.value}`, desc: e.desc, optional: e.optional })) },
  { id: 'volumes', title: 'Volumes', head: ['Path', 'Function'], rows: (c.volumes ?? []).map((v) => ({ key: v.path, desc: v.desc, optional: v.optional })) },
  { id: 'devices', title: 'Devices', head: ['Device', 'Function'], rows: (c.devices ?? []).map((d) => ({ key: d.path, desc: d.desc, optional: d.optional })) },
  {
    id: 'misc',
    title: 'Other settings',
    head: ['Setting', 'Function'],
    rows: [
      ...(c.caps ?? []).map((x) => ({ key: `cap_add: ${x.cap_add}`, desc: x.desc, optional: x.optional })),
      ...(c.security_opt ?? []).map((x) => ({ key: `security_opt: ${x.compose_var}`, desc: x.desc, optional: x.optional })),
      ...(c.custom ?? []).map((x) => ({ key: `${x.name_compose}: ${Array.isArray(x.value) ? x.value.join(', ') : x.value}`, desc: x.desc, optional: x.optional })),
      ...(c.networking ? [{ key: `network_mode: ${c.networking}`, desc: 'Runs on the host network.', optional: false }] : []),
      ...(c.privileged ? [{ key: 'privileged: true', desc: 'Needs privileged mode.', optional: false }] : []),
      ...(c.hostname ? [{ key: `hostname: ${c.hostname.hostname}`, desc: c.hostname.desc, optional: c.hostname.optional }] : []),
      ...(c.mac_address ? [{ key: `mac_address: ${c.mac_address.mac_address}`, desc: c.mac_address.desc, optional: c.mac_address.optional }] : []),
    ],
  },
].filter((t) => t.rows.length);

// Version tags with their latest build: image.tags lists the published tags; releases says what each publishes.
const tagRows = image.tags.map((t) => {
  const release = image.releases.find((r) => r.release_tag === t.tag);
  const build = release?.tag ? builds.find((b) => b.tag === release.tag) : undefined;
  return { ...t, release, build };
});

// The upstream release the latest build packages, when its notes came from a page we can link (not a command).
const upstreamUrl = /^https?:\/\//.test(latestRecord?.build.notes?.upstream_url ?? '') ? latestRecord!.build.notes!.upstream_url! : undefined;
const facts: { label: string; value: string; title?: string; href?: string; external?: string }[] = [
  ...(image.upstream_version ? [{ label: 'Upstream version', value: image.upstream_version, external: upstreamUrl }] : []),
  { label: 'GitHub stars', value: grouped(image.stars) },
  { label: 'Last build', value: relative(built, SNAPSHOT_DATE), title: formatDate(built) },
  ...(image.initial_date ? [{ label: 'First build', value: formatDate(image.initial_date) }] : []),
  ...(image.base ? [{ label: 'Base', value: image.base, href: '/fleet/' }] : []),
  { label: 'Release channels', value: String(image.releases.length) },
  ...(builds.length ? [{ label: 'Retained builds', value: `${builds.length} of ${historyCount}` }] : []),
];
const support = [
  { label: 'Read-only root filesystem', ok: !!c.readonly_supported },
  { label: 'Runs as non-root user', ok: !!c.nonroot_supported },
  { label: 'arm64 build', ok: image.arm64 },
];
const links = [
  ...(c.application_setup ? [{ label: 'Application setup', href: c.application_setup }] : []),
  { label: 'Source on GitHub', href: image.github_url },
  { label: 'Package on GHCR', href: image.registries.packages_url },
  ...(image.project_url ? [{ label: `${image.title} project`, href: image.project_url }] : []),
  { label: 'Build status', href: controlImageUrl(image.name) },
  { label: 'Hub API record', href: hubApi(`catalog/${image.name}.json`) },
];
const changelog = image.changelog ?? [];
// The sidebar's "On this page": every section this page renders, in order.
const pageNav: { id: string; label: string; sub?: boolean }[] = [
  { id: 'quick-start', label: app ? 'Quick start' : image.kind === 'base' ? 'Build on it' : 'Used by' },
  { id: 'tags', label: 'Version tags' },
  { id: 'arch', label: 'Architectures' },
  ...(latest ? [{ id: 'inside', label: 'Inside the latest image' }] : []),
  { id: 'fleet', label: 'In the fleet' },
  ...(SetupContent || image.setup_instructions ? [{ id: 'setup', label: 'Application setup' }] : []),
  ...(tables.length > 0 ? [{ id: 'parameters', label: 'Parameters' }] : []),
  // The README's other sections, indented under Parameters.
  ...moreDocs.map((d) => ({ id: d.id, label: d.title, sub: true })),
  { id: 'builds', label: 'Builds' },
  ...(app && (listedMods.length > 0 || mods.universal.length > 0) ? [{ id: 'mods', label: 'Mods' }] : []),
  ...(proxySample ? [{ id: 'proxy', label: 'Reverse proxy' }] : []),
  ...(changelog.length > 0 ? [{ id: 'changelog', label: 'Changelog' }] : []),
  { id: 'support', label: 'Support' },
  ...(image.deprecated || image.archived ? [] : [{ id: 'contribute', label: 'Improve this image' }]),
];
---

<Layout
  section="images"
  title={`${image.name} Docker image`}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[imageJsonLd(image, Astro.site)]}
>
  <header class="relative overflow-hidden border-b border-[var(--raft-hair)]" data-pagefind-body>
    <div class="raft-aurora pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="raft-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class:list={['raft-container relative py-10 md:py-14', heroShot && 'grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-center']}>
      <div class="min-w-0">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-8 flex flex-col gap-6 md:flex-row md:items-center">
        <span class="grid size-20 shrink-0 place-items-center rounded-xl border border-[var(--raft-hair-strong)] bg-card p-3 shadow-[var(--raft-shadow)]">
          <ImageLogo image={image} size={56} class="size-14" loading="eager" />
        </span>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{image.name}</h1>
            <span class="rounded-md border border-[var(--raft-hair-strong)] px-2 py-0.5 font-mono text-xs">{image.version}</span>
            {!app && <a href={withBase(kind.href)} class="rounded-md bg-primary/10 px-2 py-0.5 font-mono text-xs text-foreground hover:bg-primary/20">{kind.singular}</a>}
            {image.deprecated && <span class="rounded-md bg-destructive/15 px-2 py-0.5 font-mono text-xs text-destructive">deprecated</span>}
            {image.archived && <span class="rounded-md border border-[var(--raft-hair-strong)] px-2 py-0.5 font-mono text-xs text-muted-foreground">archived</span>}
          </div>
          <p class="mt-3 max-w-3xl text-lg text-muted-foreground">{summary}</p>
          {!app && summary !== kindNote && <p class="mt-2 max-w-3xl text-sm text-muted-foreground">{kindNote}</p>}
          {
            app && image.categories.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Categories">
                {image.categories.map((cat) => (
                  <li>
                    <a
                      href={withBase(`/images/?category=${encodeURIComponent(cat)}`)}
                      class="rounded-md border border-[var(--raft-hair)] bg-background/50 px-2 py-0.5 text-xs text-muted-foreground hover:border-[var(--raft-hair-strong)] hover:text-foreground"
                    >
                      {cat}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
      <div class="mt-8 flex max-w-2xl items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] bg-[var(--raft-code-bg)] py-1 pr-1 pl-4 font-mono text-sm">
        <span class="min-w-0 flex-1 truncate"><span class="text-primary" aria-hidden="true">$ </span>{pull}</span>
        <CopyButton client:visible text={pull} label="Copy docker pull command" variant="secondary" />
      </div>
      </div>
      {heroShot && <HeroScreenshot client:load {...heroShot} className="max-w-xl lg:max-w-none" />}
    </div>
  </header>

  <div class="raft-container mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_19rem]">
    <div class="min-w-0 space-y-12" data-pagefind-body>
      {
        image.deprecated && (
          <div role="note" class="flex gap-3 rounded-[var(--radius)] border border-destructive/40 bg-destructive/10 p-4">
            <AlertTriangle className="mt-0.5 size-5 shrink-0 text-destructive" aria-hidden="true" />
            <div>
              <p class="font-semibold">This image is deprecated</p>
              {image.deprecation_message ? (
                <p class="mt-1 text-sm text-muted-foreground" set:html={inlineMarkdown(image.deprecation_message)} />
              ) : (
                <p class="mt-1 text-sm text-muted-foreground">
                  It is no longer maintained and receives no further updates. The details below are kept for reference; you can find{' '}
                  <a href={withBase('/images/')} class="font-medium text-foreground underline underline-offset-4">maintained alternatives</a> in the catalogue.
                </p>
              )}
            </div>
          </div>
        )
      }

      {
        app ? (
        <section aria-labelledby="quick-start">
          <AnchorHeading id="quick-start">Quick start · configure</AnchorHeading>
          <p class="mt-2 text-sm text-muted-foreground">
            Pick the optional settings and mods you want, set your paths, ports and values, then copy the result.
          </p>
          <Panel class="mt-4">
            <ConfigLab client:visible model={lab} sources={labSources} />
          </Panel>
          {
            install.length > 0 && (
              <div class="mt-5">
                <h3 class="raft-eyebrow">Install on …</h3>
                <div class="mt-3">
                  <InstallMenu client:visible image={image.name} options={install} />
                </div>
                <p class="mt-3 text-xs text-muted-foreground">
                  <a href={withBase('/stores/')} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">Adding a store to your platform</a>
                </p>
              </div>
            )
          }
        </section>
        ) : (
          <section aria-labelledby="quick-start">
            <AnchorHeading id="quick-start">{image.kind === 'base' ? 'Build on it' : 'Used by'}</AnchorHeading>
            {image.kind === 'base' && (
              <>
                <p class="mt-2 text-sm text-muted-foreground">Start a Dockerfile from the tag of the release you want:</p>
                <ul class="mt-4 space-y-2">
                  {image.releases.map((r) => (
                    <li class="flex max-w-2xl items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] bg-[var(--raft-code-bg)] py-1 pr-1 pl-4 font-mono text-sm">
                      <span class="min-w-0 flex-1 truncate">FROM {image.ref}:{r.release_tag}</span>
                      <CopyButton client:visible text={`FROM ${image.ref}:${r.release_tag}`} label={`Copy FROM line for ${r.release_tag}`} variant="secondary" />
                    </li>
                  ))}
                </ul>
              </>
            )}
            {usedBy.length > 0 ? (
              <>
                <p class="mt-4 text-sm text-muted-foreground">
                  {usedByCount} {usedByCount === 1 ? 'image is' : 'images are'} built FROM {image.name}, by the newest build of each:
                </p>
                <dl class="raft-panel mt-3 divide-y divide-[var(--raft-hair)]">
                  {usedBy.map((d) => (
                    <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:gap-4">
                      <dt class="w-32 shrink-0 font-mono text-sm">
                        {d.tag} <span class="text-xs text-muted-foreground">· {d.images.length}</span>
                      </dt>
                      <dd class="min-w-0 text-sm">
                        <ul class="flex flex-wrap gap-x-3 gap-y-1">
                          {d.images.map((n) => (
                            <li>
                              <a href={withBase(`/images/${n}/`)} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">{n}</a>
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  ))}
                </dl>
              </>
            ) : (
              <p class="raft-panel mt-4 px-4 py-4 text-sm text-muted-foreground">No image in the fleet is built FROM {image.name} yet.</p>
            )}
          </section>
        )
      }

      <section aria-labelledby="tags">
        <AnchorHeading id="tags">Version tags</AnchorHeading>
        <div class="raft-panel mt-4 relative overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-[var(--raft-hair)] bg-[var(--raft-surface)] font-mono text-[0.6875rem] text-muted-foreground uppercase">
              <tr>
                <th scope="col" class="px-4 py-2.5 font-normal">Tag</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Latest build</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Built</th>
                <th scope="col" class="px-4 py-2.5 font-normal">Tests</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--raft-hair)]">
              {
                tagRows.map((t) => (
                  <tr class="align-top">
                    <th scope="row" class="px-4 py-3 font-normal">
                      <code class="font-mono text-[0.8125rem] text-foreground">:{t.tag}</code>
                      <span class="mt-0.5 block text-xs text-muted-foreground">{t.desc}</span>
                      {t.release && <span class="mt-0.5 block font-mono text-[0.6875rem] text-muted-foreground">branch {t.release.branch} · {t.release.channel}</span>}
                    </th>
                    <td class="px-4 py-3 font-mono text-xs">
                      {t.release?.tag ? (
                        t.build ? (
                          <a href={withBase(buildUrl(image.name, t.build.tag))} class="text-foreground underline-offset-4 hover:text-primary hover:underline">
                            {t.release.tag}
                          </a>
                        ) : (
                          <span>{t.release.tag}</span>
                        )
                      ) : (
                        <span class="text-muted-foreground">no build yet</span>
                      )}
                      {t.release?.platforms.length ? <span class="mt-0.5 block text-muted-foreground">{t.release.platforms.join(' · ')}</span> : null}
                    </td>
                    <td class="px-4 py-3 font-mono text-xs text-muted-foreground whitespace-nowrap">
                      {t.release?.created ? <time datetime={t.release.created}>{formatDate(t.release.created)}</time> : '–'}
                    </td>
                    <td class="px-4 py-3 text-xs whitespace-nowrap">
                      {t.release?.test_success === true && <span class="inline-flex items-center gap-1 text-[var(--raft-ok)]"><Check className="size-3.5" aria-hidden="true" /> passed</span>}
                      {t.release?.test_success === false && <span class="inline-flex items-center gap-1 text-destructive"><X className="size-3.5" aria-hidden="true" /> failed</span>}
                      {(t.release?.test_success ?? null) === null && <span class="text-muted-foreground">–</span>}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="arch">
        <AnchorHeading id="arch">Architectures</AnchorHeading>
        <p class="mt-2 text-sm text-muted-foreground">Pulling <code class="font-mono text-foreground">:latest</code> picks the right one for your host automatically.</p>
        <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            image.architectures.map((a) => (
              <li class="raft-panel flex items-baseline justify-between gap-4 px-4 py-3">
                <span class="font-mono text-[0.8125rem]">{a.arch}</span>
                <code class="font-mono text-xs text-muted-foreground">{a.tag}</code>
              </li>
            ))
          }
        </ul>
      </section>

      {
        latest && (
          <section aria-labelledby="inside">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <AnchorHeading id="inside">Inside the latest image</AnchorHeading>
                <p class="mt-2 text-sm text-muted-foreground">
                  <span class="font-mono text-foreground">{image.ref}:{latest.tag}</span>
                </p>
              </div>
              <a
                href={withBase(buildUrl(image.name, latest.tag))}
                class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md bg-primary px-3.5 text-sm font-medium text-primary-foreground hover:bg-primary/80 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
              >
                Explore this build <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
            <Panel class="mt-4">
              <dl class="grid grid-cols-2 gap-x-4 gap-y-3 border-b border-[var(--raft-hair)] p-4 text-sm sm:grid-cols-3 lg:grid-cols-4">
                {latestFacts.map((f) => (
                  <div class="min-w-0">
                    <dt class="font-mono text-[0.6875rem] text-muted-foreground uppercase">{f.label}</dt>
                    <dd class:list={['mt-0.5 truncate', f.mono ? 'font-mono text-xs' : '', f.label === 'Tests' ? (latestResult === 'success' ? 'text-[var(--raft-ok)]' : latestResult === 'failure' ? 'text-destructive' : '') : '']} title={f.title}>
                      {f.value}
                    </dd>
                  </div>
                ))}
              </dl>
              <ul class="flex flex-wrap gap-x-5 gap-y-2 px-4 py-3 text-sm">
                {[
                  ...(latestHasFiles ? [{ label: 'File tree and packages', hash: 'explorer' }] : []),
                  { label: 'Tests, screenshot and logs', hash: 'ci' },
                  { label: 'Dockerfile and layer sizes', hash: 'dockerfile' },
                  { label: 'Init graph', hash: 'init' },
                ].map((l) => (
                  <li>
                    <a href={withBase(`${buildUrl(image.name, latest.tag)}#${l.hash}`)} class="inline-flex items-center gap-1 underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </Panel>
          </section>
        )
      }

      <section aria-labelledby="fleet">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <AnchorHeading id="fleet">In the fleet</AnchorHeading>
            <p class="mt-2 text-sm text-muted-foreground">
              Live branches, their latest release, upstream version and next scheduled check.
            </p>
          </div>
          <a href={withBase(`/fleet/?image=${encodeURIComponent(image.name)}`)} class="inline-flex items-center gap-1 text-sm font-medium hover:text-primary">
            {image.name} on the fleet board <ArrowRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>
        <Panel class="mt-4">
          <ImageFleet client:visible image={image.name} snapshot={fleetSnapshot} runsBase={withBase('/fleet/runs/')} buildsBase={withBase(`/images/${image.name}/builds/`)} knownTags={knownTags} fallback={`${CONTROL_URL}/images/${image.name}`} />
        </Panel>
      </section>

      {
        (SetupContent || image.setup_instructions) && (
          <section aria-labelledby="setup">
            <AnchorHeading id="setup">Application setup</AnchorHeading>
            {/* The README's own links point at #application-setup. */}
            <span id="application-setup" aria-hidden="true"></span>
            {SetupContent ? (
              <div class={DOC_PROSE}>
                <SetupContent />
              </div>
            ) : (
              <div class={DOC_PROSE} set:html={blockMarkdown(image.setup_instructions!)} />
            )}
          </section>
        )
      }

      {
        tables.length > 0 && (
          <section aria-labelledby="parameters" class="space-y-6">
            <AnchorHeading id="parameters">Parameters</AnchorHeading>
            {tables.map((t) => (
              <div class="raft-panel relative overflow-x-auto" id={t.id}>
                <table class="w-full text-left text-sm">
                  <caption class="border-b border-[var(--raft-hair)] bg-[var(--raft-surface)] px-4 py-2.5 text-left font-mono text-xs text-muted-foreground uppercase">
                    <span class="group/anchor inline-flex items-center">
                      {t.title}
                      <a href={`#${t.id}`} class="heading-anchor normal-case" aria-label={`Copy link to ${t.title}`} data-anchor>#</a>
                    </span>
                  </caption>
                  <thead class="sr-only">
                    <tr>
                      <th scope="col">{t.head[0]}</th>
                      <th scope="col">{t.head[1]}</th>
                      <th scope="col">Required</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[var(--raft-hair)]">
                    {t.rows.map((r) => (
                      <tr class="align-top">
                        <th scope="row" class="w-[40%] px-4 py-3 font-mono text-[0.8125rem] font-normal break-all text-foreground">
                          {r.key}
                        </th>
                        <td class="px-4 py-3 text-muted-foreground" set:html={inlineMarkdown(r.desc)} />
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                          <span
                            class:list={[
                              'rounded px-1.5 py-0.5 font-mono text-[0.6875rem]',
                              r.optional ? 'border border-[var(--raft-hair)] text-muted-foreground' : 'bg-accent text-accent-foreground',
                            ]}
                          >
                            {r.optional ? 'optional' : 'required'}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </section>
        )
      }

      {
        moreDocs.map(({ id, title, Content }) => (
          <section aria-labelledby={id}>
            <AnchorHeading id={id}>{title}</AnchorHeading>
            <div class={DOC_PROSE}>
              <Content />
            </div>
          </section>
        ))
      }

      <section aria-labelledby="builds">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <AnchorHeading id="builds">Builds</AnchorHeading>
            <p class="mt-2 text-sm text-muted-foreground">
              The newest ten builds per branch{historyCount > builds.length && `; ${historyCount - builds.length} older ${historyCount - builds.length === 1 ? 'release is' : 'releases are'} on GitHub`}.
            </p>
          </div>
          {
            builds.length > 0 && (
              <a href={hubHistoryUrl(image.name)} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground">
                CI history <ArrowUpRight className="size-3.5" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
              </a>
            )
          }
        </div>
        <!-- client:idle: the island renders nothing on the server, so client:visible would never hydrate it. -->
        <NewerBuilds client:idle image={image.name} known={knownTags} buildsBase={withBase(`/images/${image.name}/builds/`)} />
        {
          builds.length === 0 ? (
            <p class="raft-panel mt-4 px-4 py-6 text-sm text-muted-foreground">No builds yet.</p>
          ) : (
            <div class="raft-panel mt-4 relative overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-[var(--raft-hair)] bg-[var(--raft-surface)] font-mono text-[0.6875rem] text-muted-foreground uppercase">
                  <tr>
                    <th scope="col" class="px-4 py-2.5 font-normal">Tag</th>
                    <th scope="col" class="px-4 py-2.5 font-normal">Built</th>
                    <th scope="col" class="px-4 py-2.5 font-normal">Reason</th>
                    <th scope="col" class="px-4 py-2.5 font-normal">Change</th>
                    <th scope="col" class="px-4 py-2.5 font-normal">Result</th>
                    <th scope="col" class="px-4 py-2.5 text-right font-normal">Size</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--raft-hair)]">
                  {builds.map((b) => {
                    const result = buildResult(b);
                    return (
                      <tr class="align-top">
                        <th scope="row" class="px-4 py-3 font-normal">
                          <a href={withBase(buildUrl(image.name, b.tag))} class="font-mono text-[0.8125rem] text-foreground underline-offset-4 hover:text-primary hover:underline">
                            {b.tag}
                          </a>
                          <span class="mt-0.5 block font-mono text-[0.6875rem] text-muted-foreground">
                            {b.branch} · {shortSha(b.commit)}
                          </span>
                        </th>
                        <td class="px-4 py-3 font-mono text-xs text-muted-foreground whitespace-nowrap">
                          <time datetime={b.created} title={b.created}>
                            {formatDate(b.created)}
                          </time>
                        </td>
                        <td class="px-4 py-3 text-xs text-muted-foreground">{reasonLabel(b.reason)}</td>
                        <td class="px-4 py-3 text-xs">
                          <ClassBadge classification={b.classification} />
                        </td>
                        <td class="px-4 py-3 text-xs whitespace-nowrap">
                          <span class:list={['inline-flex items-center gap-1', result === 'success' ? 'text-[var(--raft-ok)]' : result === 'failure' ? 'text-destructive' : 'text-muted-foreground']}>
                            {result === 'success' ? <Check className="size-3.5" aria-hidden="true" /> : result === 'failure' ? <X className="size-3.5" aria-hidden="true" /> : <Minus className="size-3.5" aria-hidden="true" />}
                            {result}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right font-mono text-xs whitespace-nowrap text-muted-foreground tabular-nums">
                          {b.platforms.map((p) => (
                            <span class="block">
                              <span class="text-foreground">{bytes(p.size)}</span> {p.arch}
                            </span>
                          ))}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      {
        app && (listedMods.length > 0 || mods.universal.length > 0) && (
          <section aria-labelledby="mods">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <AnchorHeading id="mods">Mods</AnchorHeading>
                <p class="mt-2 text-sm text-muted-foreground">
                  Add a mod with <code class="font-mono text-foreground">DOCKER_MODS=&lt;image&gt;</code>; separate several with <code class="font-mono text-foreground">|</code>.
                </p>
              </div>
              <a href={withBase(`/mods/?image=${encodeURIComponent(image.name)}`)} class="inline-flex items-center gap-1 text-sm font-medium hover:text-primary">
                All mods for {image.name} <ArrowRight className="size-3.5" aria-hidden="true" />
              </a>
            </div>
            {listedMods.length > 0 ? (
              <ul class="raft-panel mt-4 divide-y divide-[var(--raft-hair)]">
                {listedMods.map((m) => (
                  <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0">
                      <a href={withBase(modPath(m))} class="font-medium hover:text-primary">
                        {m.title}
                      </a>
                      {m.target === 'universal' && <span class="ml-2 font-mono text-[0.6875rem] text-muted-foreground">universal</span>}
                      <p class="mt-0.5 text-sm text-muted-foreground" set:html={inlineMarkdown(m.summary)} />
                    </div>
                    <div class="flex min-w-0 shrink-0 items-center gap-1 rounded-md border border-[var(--raft-hair)] bg-[var(--raft-code-bg)] py-0.5 pr-0.5 pl-2.5 font-mono text-xs">
                      <span class="truncate">{m.image}</span>
                      <CopyButton client:visible text={m.image} label={`Copy ${m.title} mod image`} />
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="raft-panel mt-4 px-4 py-4 text-sm text-muted-foreground">
                No mod targets {image.name} specifically; the {mods.universal.length} universal mods work with every image.
              </p>
            )}
            {listedMods.length > 0 && mods.universal.length > 0 && (
              <p class="mt-3 text-xs text-muted-foreground">
                Plus <a href={withBase(`/mods/?image=${encodeURIComponent(image.name)}`)} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">{mods.universal.length} other universal mods</a> that work with every image.
              </p>
            )}
          </section>
        )
      }

      {
        proxySample && (
          <section aria-labelledby="proxy">
            <AnchorHeading id="proxy">Reverse proxy</AnchorHeading>
            <p class="mt-2 text-sm text-muted-foreground">
              {image.name} listens on <span class="font-mono text-foreground">{proxySample.scheme}://{proxySample.name}:{proxySample.port}</span>.
            </p>
            <Panel class="mt-4">
              <ProxyTabs client:visible sample={proxySample} caddy={extras.proxy?.caddy?.trimEnd() ?? null} traefik={extras.proxy?.traefik?.trimEnd() ?? null} source={image.links.proxy ?? undefined} />
            </Panel>
          </section>
        )
      }

      {
        changelog.length > 0 && (
          <section aria-labelledby="changelog">
            <AnchorHeading id="changelog">Changelog</AnchorHeading>
            <ol class="relative mt-6 space-y-5 border-l border-[var(--raft-hair-strong)] pl-6">
              {changelog.slice(0, 8).map((e, i) => (
                <li class="relative">
                  <span
                    class:list={['absolute top-1.5 -left-[1.6rem] size-2.5 rounded-full border-2 border-background', i === 0 ? 'bg-primary' : 'bg-[var(--raft-hair-strong)]']}
                    aria-hidden="true"
                  />
                  <time datetime={e.date} class="font-mono text-xs text-muted-foreground tabular-nums">
                    {formatDate(e.date)}
                  </time>
                  <p class="mt-0.5 text-sm" set:html={inlineMarkdown(e.desc)} />
                </li>
              ))}
            </ol>
            {changelog.length > 8 && (
              <details class="mt-5 pl-6">
                <summary class="cursor-pointer font-mono text-xs text-muted-foreground hover:text-foreground">{changelog.length - 8} earlier entries</summary>
                <ol class="mt-4 space-y-3">
                  {changelog.slice(8).map((e) => (
                    <li class="text-sm">
                      <time datetime={e.date} class="mr-3 font-mono text-xs text-muted-foreground tabular-nums">
                        {e.date}
                      </time>
                      <span set:html={inlineMarkdown(e.desc)} />
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </section>
        )
      }

      <section aria-labelledby="support">
        <AnchorHeading id="support">Support</AnchorHeading>
        <p class="mt-2 text-sm text-muted-foreground">Questions about running {image.name}? Start with the documentation and the community; open an issue for bugs.</p>
        {
          SupportContent && (
            <div class={DOC_PROSE}>
              <SupportContent />
            </div>
          )
        }
        <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            [
              ...SUPPORT_CHANNELS.map((c) => ({ label: c.name, href: c.href, note: c.bestFor })),
              { label: `Issues for ${image.name}`, href: `${image.github_url.replace(/\/$/, '')}/issues`, note: 'Bugs in this image, with your compose and logs.' },
              { label: 'Mastodon', href: LINKS.mastodon, note: 'Release announcements and news.' },
            ].map((l) => (
              <li>
                <a href={l.href.startsWith('/') ? withBase(l.href) : l.href} {...(l.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener' })} class="raft-panel flex items-start justify-between gap-3 px-4 py-3 text-sm hover:bg-muted/40">
                  <span>
                    <span class="font-medium">{l.label}</span>
                    <span class="mt-0.5 block text-xs text-muted-foreground">{l.note}</span>
                  </span>
                  {!l.href.startsWith('/') && (
                    <>
                      <ArrowUpRight className="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                      <span class="sr-only">(opens in a new tab)</span>
                    </>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        !image.deprecated && !image.archived && (
          <ContributeCallout
            id="contribute"
            title={`Improve ${image.name}`}
            body={`This image is kept up by volunteers, and you can be one of them. You don't need to know how the pipeline works: point an AI agent at the harness and describe what you want. It reproduces the problem in your Docker, tests the change and drafts the pull request for you to check.`}
            prompts={imagePrompts(image.name, app)}
            guide={{ label: 'Contributing an image', href: '/docs/contribute/contributing-an-image/' }}
          />
        )
      }
    </div>

    <aside class="space-y-4" aria-label={`About ${image.name}`}>
      <div class="raft-panel p-5">
        <h2 class="raft-eyebrow">At a glance</h2>
        <dl class="mt-4 space-y-3 text-sm">
          {
            facts.map((f) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-muted-foreground">{f.label}</dt>
                <dd class="min-w-0 truncate font-mono text-foreground tabular-nums" title={f.title ?? f.value}>
                  {f.external ? (
                    <a href={f.external} target="_blank" rel="noopener" class="underline decoration-[var(--raft-hair-strong)] underline-offset-4 hover:text-primary hover:decoration-current">
                      {f.value}<span class="sr-only"> (upstream release, opens in a new tab)</span>
                    </a>
                  ) : f.href ? (
                    <a href={withBase(f.href)} class="underline-offset-4 hover:text-primary hover:underline">{f.value}</a>
                  ) : (
                    f.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <ul class="mt-5 space-y-2 border-t border-[var(--raft-hair)] pt-4 text-sm">
          {
            support.map((x) => (
              <li class="flex items-center gap-2">
                {x.ok ? <Check className="size-4 text-[var(--raft-ok)]" aria-hidden="true" /> : <Minus className="size-4 text-muted-foreground" aria-hidden="true" />}
                <span class={x.ok ? 'text-foreground' : 'text-muted-foreground'}>{x.label}</span>
                <span class="sr-only">: {x.ok ? 'yes' : 'no'}</span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        supportsProotApps(image) && (
          <a href={withBase('/proot-apps/')} class="raft-panel group flex items-start gap-3 p-4 text-sm hover:bg-muted/40">
            <AppWindow className="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
            <span class="min-w-0">
              <span class="block font-medium text-foreground group-hover:text-primary">This image supports PRoot Apps</span>
              <span class="mt-1 block text-muted-foreground">
                Install {getProotApps().length > 0 ? `any of ${getProotApps().length}` : 'more'} desktop apps from its terminal, kept in /config across updates.
              </span>
            </span>
          </a>
        )
      }
      {
        builds.length > 0 && (
          <nav class="raft-panel p-2" aria-label="Latest builds">
            <h2 class="raft-eyebrow px-3 pt-2 pb-1">Latest builds</h2>
            <ol>
              {builds.slice(0, 3).map((b) => (
                <li>
                  <BuildRow build={{ image: image.name, summary: b, url: buildUrl(image.name, b.tag) }} compact />
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="space-y-4 lg:sticky lg:top-20 lg:max-h-[calc(100dvh-6rem)] lg:overflow-y-auto">
      <nav class="raft-panel hidden p-2 lg:block" aria-labelledby="page-nav-title" data-page-nav>
        <h2 id="page-nav-title" class="raft-eyebrow px-3 pt-2 pb-1">On this page</h2>
        <ol class="text-sm">
          {
            pageNav.map((n) => (
              <li>
                <a
                  href={`#${n.id}`}
                  class:list={[
                    'block truncate rounded-md border-l-2 border-transparent text-muted-foreground hover:bg-muted hover:text-foreground aria-[current=location]:border-primary aria-[current=location]:text-foreground',
                    n.sub ? 'py-1 pr-3 pl-6 text-xs leading-4' : 'px-3 py-1',
                  ]}
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <nav class="raft-panel p-2" aria-label="Resources">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener" class="flex items-center justify-between gap-2 rounded-md px-3 py-2 text-sm hover:bg-muted">
                  <span class="truncate">{l.label}</span>
                  <ArrowUpRight className="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="px-1 font-mono text-[0.6875rem] text-muted-foreground">
        Data from <a href={HUB_URL + '/'} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">the hub</a>, <time datetime={isoDate(SNAPSHOT_DATE)}>{formatDate(SNAPSHOT_DATE)}</time>
      </p>
      </div>
    </aside>
  </div>

  {
    posts.length > 0 && (
      <section class="raft-container pt-20" aria-labelledby="posts-title">
        <SectionHead eyebrow="Writing" title={`Posts about ${image.name}`} id="posts-title" />
        <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-3">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="raft-container pt-20" aria-labelledby="related-title">
        <SectionHead eyebrow="Related" title="Similar images" id="related-title" link={{ label: 'Browse all', href: withBase('/images/') }} />
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => <ImageTile image={r} />)}
        </div>
      </section>
    )
  }
</Layout>

<script>
  // "On this page": mark the section being read (the last heading above the top quarter of the viewport).
  const nav = document.querySelector('[data-page-nav]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el): el is HTMLElement => !!el);
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = window.innerHeight / 4;
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t;
      for (const a of links) {
        if (a.hash.slice(1) === current?.id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    const schedule = () => (frame ||= requestAnimationFrame(update));
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>
