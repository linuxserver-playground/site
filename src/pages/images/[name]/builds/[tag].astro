---
/**
 * A build page, for every build the snapshots hold. The non-interactive parts are the React components in
 * components/build/BuildParts.tsx, rendered here at build time without JavaScript; the 404 fallback renders the
 * same parts in the browser from the hub's API for a build newer than the site (LiveBuildPage).
 */
import Layout from '@/layouts/Layout.astro';
import ImageLogo from '@/components/ImageLogo.astro';
import Panel from '@/components/Panel.astro';
import AnchorHeading from '@/components/AnchorHeading.astro';
import { BuildHeader, BuildRecordSection, CiHeading, NotesAndData } from '@/components/build/BuildParts';
import CopyButton from '@/components/islands/CopyButton';
import CiReport from '@/components/islands/explorer/CiReport';
import Vulns from '@/components/islands/explorer/Vulns';
import DiffViewer from '@/components/islands/explorer/DiffViewer';
import DockerfileView from '@/components/islands/explorer/DockerfileView';
import Explorer from '@/components/islands/explorer/Explorer';
import InitGraph from '@/components/islands/explorer/InitGraph';
import { withBase } from '@/lib/base';
import { buildPage } from '@/lib/build-page';
import { allBuildRecords, buildUrl, getBuilds, type BuildRecord } from '@/lib/builds';
import { hubReportUrl, hubTestsUrl, hubVulnsUrl } from '@/lib/hub';
import { getImage, SNAPSHOT_DATE, type Image } from '@/lib/images';
import { githubRepo, renderNotes } from '@/lib/markdown/notes';

export function getStaticPaths() {
  return allBuildRecords()
    .filter(({ image }) => getImage(image))
    .map(({ image, tag, record }) => ({ params: { name: image, tag }, props: { image: getImage(image)!, record } }));
}

const { image, record } = Astro.props as { image: Image; record: BuildRecord };
const page = buildPage({ name: image.name, url: image.url, ref: image.ref, github_url: image.github_url }, record, getBuilds(image.name));
const { b, tag, prev, arches, filesUrls, packagesUrls, packagesFallback, packagesSummary, layersUrls } = page;
// Release notes as GitHub would show them: the LinuxServer section is generated from this image's repository; the
// upstream section links GitHub references only when its source is a GitHub repository.
const upstreamRepo = githubRepo(b.notes?.upstream_url);
const notesHtml = {
  linuxserver: b.notes?.linuxserver ? renderNotes(b.notes.linuxserver, { github: true, repo: githubRepo(image.github_url) }) : '',
  upstream: b.notes?.upstream ? renderNotes(b.notes.upstream, { github: !!upstreamRepo, repo: upstreamRepo }) : '',
};
const units = b.init_graph?.units ?? [];
// Section C: the CI report. tests.json is in the snapshot when the hub had it at refresh time; the island
// fetches it otherwise and loads the screenshot, logs and package diff on demand.
const tests = record.tests ?? null;
const controlBuild = page.controlBuild;
---

<Layout section="images" title={`${image.name} ${tag}`} description={page.description} breadcrumbs={page.crumbs}>
  <BuildHeader page={page} now={SNAPSHOT_DATE}>
    <ImageLogo slot="logo" image={image} size={44} class="size-11" loading="eager" />
    <CopyButton slot="copy" client:visible text={page.pull} label="Copy docker pull command" variant="secondary" />
  </BuildHeader>
  <div class="raft-container mt-10 space-y-12" data-pagefind-body>
    <BuildRecordSection page={page} />

    <!-- CI report -->
    <section aria-labelledby="ci" id="ci-section">
      <CiHeading page={page} />
      <Panel class="mt-4">
        <CiReport client:load image={image.name} tag={tag} tests={tests} testEnabled={b.test.enabled} reportDir={hubReportUrl(image.name, tag)} testsUrl={hubTestsUrl(image.name, tag)} runUrl={b.workflow.run_url} controlUrl={controlBuild} />
      </Panel>
    </section>

    <!-- Vulnerabilities: only when the hub serves vulns.json for this build. client:idle, not client:visible: the island
         renders nothing on the server, so it has no box for the intersection observer and would never hydrate. -->
    <Vulns client:idle url={hubVulnsUrl(image.name, tag)} image={image.name} tag={tag} />

    <!-- Explorer -->
    <section aria-labelledby="explorer">
      <AnchorHeading id="explorer">Explore the image</AnchorHeading>
      <p class="mt-2 text-sm text-muted-foreground">Every file and package in the image.</p>
      <Panel class="mt-4">
        <Explorer
          client:visible
          image={image.name}
          tag={tag}
          arches={arches}
          filesUrls={filesUrls}
          packagesUrls={packagesUrls}
          packagesFallback={packagesFallback}
          packagesSummary={packagesSummary}
          layers={record.layers}
          config={b.config}
          labels={b.labels}
          packagesBase={withBase('/packages/')}
        />
      </Panel>
    </section>

    <!-- Diff -->
    <section aria-labelledby="diff">
      <AnchorHeading id="diff">Changes since the previous build</AnchorHeading>
      <Panel class="mt-4">
        {
          record.diff ? (
            <DiffViewer client:visible diff={record.diff} previousUrl={prev ? withBase(buildUrl(image.name, prev.tag)) : undefined} />
          ) : (
            <p class="px-4 py-6 text-sm text-muted-foreground">No diff for this build.</p>
          )
        }
      </Panel>
    </section>

    <!-- Dockerfile -->
    <section aria-labelledby="dockerfile">
      <AnchorHeading id="dockerfile">Dockerfile, annotated</AnchorHeading>
      <p class="mt-2 text-sm text-muted-foreground">Each instruction shows the compressed and on-disk size of the layer it produced.</p>
      <Panel class="mt-4">
        <DockerfileView client:visible dockerfile={b.dockerfile} layers={record.layers} base={b.base.image} layersUrls={layersUrls} initialArch={arches[0]} />
      </Panel>
    </section>

    <!-- Init graph -->
    {
      units.length > 0 && (
        <section aria-labelledby="init">
          <AnchorHeading id="init">Init graph</AnchorHeading>
          <p class="mt-2 text-sm text-muted-foreground">The s6-rc units that run when the container starts. Select a unit for its dependencies and run script.</p>
          <Panel class="mt-4">
            <InitGraph client:visible units={units} image={image.name} />
          </Panel>
        </section>
      )
    }

    <NotesAndData page={page} notesHtml={notesHtml} dataAsOf={{ label: 'Snapshot', date: SNAPSHOT_DATE }} />
  </div>
</Layout>
