---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ImageKindList from '@/components/ImageKindList.astro';
import ImageKindTabs from '@/components/ImageKindTabs.astro';
import { IMAGE_KINDS } from '@/lib/images';

const crumbs = [
  { name: 'Images', href: '/images/' },
  { name: IMAGE_KINDS.base.label, href: IMAGE_KINDS.base.href },
];
---

<Layout section="images" title="Base images" description="LinuxServer.io base images: the Alpine, Ubuntu, Debian, Fedora, Arch, KasmVNC and Selkies foundations every image is built on, with their tags and the images that use them." breadcrumbs={crumbs}>
  <PageHeader eyebrow="Catalogue · Base images" title="Base images" lede="The foundations every LinuxServer image is built FROM: s6-overlay, the PUID/PGID user and the shared init, on each distribution. Build on them; you don't run them on their own, so they are not in the stores." crumbs={crumbs} />
  <ImageKindTabs current="base" />
  <div class="raft-container pt-10">
    <ImageKindList kind="base" />
  </div>
</Layout>
