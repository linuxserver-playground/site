---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ImageKindList from '@/components/ImageKindList.astro';
import ImageKindTabs from '@/components/ImageKindTabs.astro';
import { IMAGE_KINDS } from '@/lib/images';

const crumbs = [
  { name: 'Images', href: '/images/' },
  { name: IMAGE_KINDS.tool.label, href: IMAGE_KINDS.tool.href },
];
---

<Layout section="images" title="Internal tools" description="LinuxServer.io internal tools: build helpers, the API and binaries other images copy in, with their tags and the images that use them." breadcrumbs={crumbs}>
  <PageHeader eyebrow="Catalogue · Internal tools" title="Internal tools" lede="Images the project's own tooling runs: build helpers, the API and binaries other images copy in. They build, test and release like any image, but they are not applications and are not in the stores." crumbs={crumbs} />
  <ImageKindTabs current="tool" />
  <div class="raft-container pt-10">
    <ImageKindList kind="tool" />
  </div>
</Layout>
