---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ImageKindList from '@/components/ImageKindList.astro';
import ImageKindTabs from '@/components/ImageKindTabs.astro';
import { IMAGE_KINDS } from '@/lib/images';

const crumbs = [
  { name: 'Images', href: '/images/' },
  { name: IMAGE_KINDS.tool.label, href: IMAGE_KINDS.tool.href },
];
---

<Layout section="images" title="Tools" description="LinuxServer.io tools: images that are not long-running containers, commands and internal tools, with their tags and the images that use them." breadcrumbs={crumbs}>
  <PageHeader eyebrow="Catalogue · Tools" title="Tools" lede="Images that are not long-running containers: commands you run and remove, and internal tools the project's own builds use. They build, test and release like any image, but there is nothing to deploy and leave running, so they are not in the stores." crumbs={crumbs} />
  <ImageKindTabs current="tool" />
  <div class="raft-container pt-10">
    <ImageKindList kind="tool" />
  </div>
</Layout>
