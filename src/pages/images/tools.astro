---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ImageKindList from '@/components/ImageKindList.astro';
import ImageKindTabs from '@/components/ImageKindTabs.astro';
import { IMAGE_KINDS } from '@/lib/images';

const crumbs = [
  { name: 'Images', href: '/images/' },
  { name: IMAGE_KINDS.tool.label, href: IMAGE_KINDS.tool.href },
];
---

<Layout section="images" title="Tools" description="LinuxServer.io tools: images you run once as a command, build helpers, the API and binaries other images copy in, with their tags and the images that use them." breadcrumbs={crumbs}>
  <PageHeader eyebrow="Catalogue · Tools" title="Tools" lede="Images that are not a long-running application: commands you run once and throw away, like ffmpeg and qemu-static, helpers the project's own tooling runs, and binaries other images copy in. They build, test and release like any image, but there is nothing to deploy and leave running, so they are not in the stores." crumbs={crumbs} />
  <ImageKindTabs current="tool" />
  <div class="raft-container pt-10">
    <ImageKindList kind="tool" />
  </div>
</Layout>
