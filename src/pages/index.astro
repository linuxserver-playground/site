---
/**
 * The home page: the main fleet's, or in Labs mode (the Labs site, PUBLIC_SITE_MODE=labs) the Labs one. Only the one
 * rendered runs its front matter, so the main home's spotlight never looks for images the Labs hub does not have.
 */
import LabsHome from '@/components/home/LabsHome.astro';
import MainHome from '@/components/home/MainHome.astro';
import { LABS } from '@/lib/site';
---

{LABS ? <LabsHome /> : <MainHome />}
