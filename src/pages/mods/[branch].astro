---
/**
 * One mod: what it does, the DOCKER_MODS value, the images it is for (each linking to that image's config lab
 * with the mod ticked), its settings and its documentation (the moddocs collection, from mod.yml `docs`).
 */
import { getCollection, render } from 'astro:content';
import { AlertTriangle, ArrowRight, ExternalLink } from 'lucide-react';
import Layout from '@/layouts/Layout.astro';
import AnchorHeading from '@/components/AnchorHeading.astro';
import PageHeader from '@/components/PageHeader.astro';
import CopyButton from '@/components/islands/CopyButton';
import { withBase } from '@/lib/base';
import { getMods } from '@/lib/fleet';
import { getAllImages } from '@/lib/images';
import { inlineMarkdown } from '@/lib/markdown/inline';

export function getStaticPaths() {
  return getMods().map((mod) => ({ params: { branch: mod.branch }, props: { mod } }));
}

const { mod } = Astro.props;
const known = new Set(getAllImages().map((i) => i.name));
const universal = mod.target === 'universal';
// The images the mod is for that have a page here; a universal mod's target is not an image.
const forImages = mod.applies_to.filter((i) => i !== 'universal' && known.has(i));
const unknownImages = mod.applies_to.filter((i) => i !== 'universal' && !known.has(i));
const labLink = (image: string) => `${withBase(`/images/${image}/`)}#lab:m=${encodeURIComponent(mod.branch)}`;

const [docEntry] = await getCollection('moddocs', (e) => e.data.branch === mod.branch);
const Docs = docEntry ? (await render(docEntry)).Content : null;

const example = universal ? (forImages[0] ?? 'sonarr') : known.has(mod.target) ? mod.target : (forImages[0] ?? mod.target);
const envLines = [`DOCKER_MODS=${mod.image}`, ...mod.env.filter((e) => e.required || e.default != null).map((e) => `${e.name}=${e.default ?? ''}`)];
const compose = ['services:', `  ${example}:`, `    image: ghcr.io/linuxserver-playground/${example}:latest`, '    environment:', ...envLines.map((l) => `      - ${l}`)].join('\n');

const crumbs = [
  { name: 'Mods', href: '/mods/' },
  { name: mod.title, href: `/mods/${mod.branch}/` },
];
const DOC_PROSE =
  'post-body prose mt-3 max-w-none text-[0.9375rem] text-muted-foreground prose-p:my-2 prose-a:text-foreground prose-headings:text-foreground prose-h2:mt-6 prose-h2:text-lg prose-h3:mt-6 prose-h3:mb-2 prose-h3:text-base prose-h4:text-sm prose-code:text-foreground dark:prose-invert';
const LINK = 'underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current';
const description = mod.summary.length > 155 ? mod.summary.slice(0, 152).replace(/\s+\S*$/, '') + '…' : mod.summary;
---

<Layout section="mods" title={`${mod.title} mod${universal ? '' : ` for ${mod.target}`}`} description={description} breadcrumbs={crumbs}>
  <PageHeader eyebrow={universal ? 'Universal mod' : `Mod for ${mod.target}`} title={mod.title} crumbs={crumbs}>
    <p class="mt-4 max-w-2xl text-lg text-muted-foreground" set:html={inlineMarkdown(mod.summary)} />
    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
      <div class="flex items-baseline gap-2">
        <dt class="text-muted-foreground">branch</dt>
        <dd>
          <a href={mod.url} target="_blank" rel="noopener" class={LINK}>
            {mod.branch}<span class="sr-only"> on GitHub (opens in a new tab)</span>
          </a>
        </dd>
      </div>
      <div class="flex items-baseline gap-2">
        <dt class="text-muted-foreground">arch</dt>
        <dd>{mod.platforms.join(', ')}</dd>
      </div>
      {
        mod.maintainers.length > 0 && (
          <div class="flex items-baseline gap-2">
            <dt class="text-muted-foreground">maintainers</dt>
            <dd>
              {mod.maintainers.map((m, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`https://github.com/${m}`} target="_blank" rel="noopener" class={LINK}>
                    {m}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </>
              ))}
            </dd>
          </div>
        )
      }
    </dl>
  </PageHeader>

  <div class="raft-container space-y-12 pt-10">
    {
      mod.deprecated && (
        <div role="note" class="flex max-w-3xl gap-3 rounded-[var(--radius)] border border-destructive/40 bg-destructive/10 p-4">
          <AlertTriangle className="mt-0.5 size-5 shrink-0 text-destructive" aria-hidden="true" />
          <div>
            <p class="font-semibold">This mod is deprecated</p>
            {mod.deprecation_message && <p class="mt-1 text-sm text-muted-foreground" set:html={inlineMarkdown(mod.deprecation_message)} />}
          </div>
        </div>
      )
    }

    <section aria-labelledby="use">
      <AnchorHeading id="use">Use it</AnchorHeading>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Set <code class="font-mono text-foreground">DOCKER_MODS</code> on {universal ? 'any LinuxServer.io container' : <>the <code class="font-mono text-foreground">{mod.target}</code> container</>} and recreate it. The mod is pulled on every start; several mods are separated with <code class="font-mono text-foreground">|</code>.
      </p>
      <div class="mt-4 flex max-w-3xl items-center gap-1 rounded-md border border-[var(--raft-hair)] bg-[var(--raft-code-bg)] py-1 pr-1 pl-3 font-mono text-sm">
        <span class="min-w-0 flex-1 break-all"><span class="text-muted-foreground">DOCKER_MODS=</span>{mod.image}</span>
        <CopyButton client:visible text={mod.image} label={`Copy the ${mod.title} mod image`} />
      </div>
      <div class="relative mt-4 max-w-3xl">
        <pre class="overflow-x-auto rounded-md border border-[var(--raft-hair)] bg-[var(--raft-code-bg)] p-4 pr-14 font-mono text-[0.8125rem] leading-relaxed" tabindex="0" aria-label={`Compose example for ${example}`}><code>{compose}</code></pre>
        <CopyButton client:visible text={compose} label="Copy the compose example" className="absolute top-2 right-2" variant="secondary" />
      </div>
      {
        forImages.length > 0 && (
          <div class="mt-6">
            <h3 class="raft-eyebrow">{universal ? 'Suggested for' : 'For'}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {forImages.map((image) => (
                <li>
                  <a href={labLink(image)} class="raft-panel inline-flex items-center gap-1.5 px-3 py-1.5 font-mono text-sm hover:text-primary">
                    {image} <ArrowRight className="size-3.5" aria-hidden="true" />
                    <span class="sr-only">: configure {image} with this mod</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        unknownImages.length > 0 && (
          <p class="mt-4 text-xs text-muted-foreground">
            Also for <span class="font-mono text-foreground">{unknownImages.join(', ')}</span>.
          </p>
        )
      }
    </section>

    {
      mod.env.length > 0 && (
        <section aria-labelledby="settings">
          <AnchorHeading id="settings">Settings</AnchorHeading>
          <div class="raft-panel mt-4 max-w-3xl overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-[var(--raft-hair)] text-xs text-muted-foreground">
                <tr>
                  <th scope="col" class="px-4 py-2 font-medium">Variable</th>
                  <th scope="col" class="px-4 py-2 font-medium">Default</th>
                  <th scope="col" class="px-4 py-2 font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--raft-hair)]">
                {mod.env.map((e) => (
                  <tr>
                    <td class="px-4 py-2 align-top font-mono text-xs">{e.name}</td>
                    <td class="px-4 py-2 align-top font-mono text-xs text-muted-foreground">{e.default ?? (e.required ? 'required' : '')}</td>
                    <td class="px-4 py-2 align-top text-muted-foreground" set:html={inlineMarkdown(e.description)} />
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      Docs && (
        <section aria-labelledby="details" class="max-w-3xl">
          <AnchorHeading id="details">Details</AnchorHeading>
          <div class={DOC_PROSE}>
            <Docs />
          </div>
        </section>
      )
    }

    <p class="text-xs text-muted-foreground">
      Source:{' '}
      <a href={mod.url} target="_blank" rel="noopener" class={`inline-flex items-center gap-1 font-mono ${LINK}`}>
        {mod.branch} branch<ExternalLink className="size-3" aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span>
      </a>. <a href={withBase('/mods/')} class={LINK}>Every mod</a>
    </p>
  </div>
</Layout>
