---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ImageKindTabs from '@/components/ImageKindTabs.astro';
import PackageSearch from '@/components/islands/PackageSearch';
import { BASE } from '@/lib/base';
import { getPackageIndex, packageEcosystems } from '@/lib/fleet';
import { formatDate } from '@/lib/format';
import { hubApi } from '@/lib/hub';
import { SNAPSHOT_DATE } from '@/lib/images';

const index = getPackageIndex();
const ecosystems = packageEcosystems();
const crumbs = [{ name: 'Packages', href: '/packages/' }];
---

<Layout
  section="packages"
  title="Packages"
  description={`Which LinuxServer.io image ships which package: ${index.length.toLocaleString('en-GB')} packages across the fleet, with versions per release tag and architecture.`}
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Packages"
    title="Who ships what"
    lede="Search for a package to see which images ship it, in which version and on which architecture."
    crumbs={crumbs}
  >
    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
      <div class="flex items-baseline gap-2">
        <dt class="sr-only">Packages</dt>
        <dd class="text-foreground">{index.length.toLocaleString('en-GB')}</dd>
        <dd class="text-muted-foreground" aria-hidden="true">packages</dd>
      </div>
      {
        ecosystems.slice(0, 5).map((e) => (
          <div class="flex items-baseline gap-2">
            <dt class="sr-only">{e.type} packages</dt>
            <dd class="text-foreground">{e.count.toLocaleString('en-GB')}</dd>
            <dd class="text-muted-foreground" aria-hidden="true">{e.type}</dd>
          </div>
        ))
      }
      <div class="flex items-baseline gap-2">
        <dt class="text-muted-foreground">updated</dt>
        <dd><time datetime={SNAPSHOT_DATE.toISOString()}>{formatDate(SNAPSHOT_DATE)}</time></dd>
      </div>
    </dl>
  </PageHeader>
  <ImageKindTabs current="packages" />

  <div class="raft-container pt-10">
    <PackageSearch client:load index={index} ecosystems={ecosystems} apiBase={hubApi('packages/')} base={BASE} />
    <p class="mt-6 text-xs text-muted-foreground">
      Source: <a href={hubApi('packages.json')} class="font-mono underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">api/v1/packages.json</a>
    </p>
  </div>
</Layout>
