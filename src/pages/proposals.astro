---
/**
 * The Labs site's proposals page (workspace docs/labs.md): the images in review, public (Labs repositories with the
 * `labs-pending` topic, `src/lib/pending.ts`), then the open proposals for signed-in team members only (the
 * `Proposals` island, live from Labs control; scripts/labs-check.mjs tests it). Labs only: the main site's build
 * replaces this route with a redirect to the Labs site's (astro.config.mjs).
 */
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHead from '@/components/SectionHead.astro';
import Proposals from '@/components/islands/Proposals';
import { withBase } from '@/lib/base';
import { CONTROL_URL } from '@/lib/control';
import { formatDate } from '@/lib/format';
import { getPending } from '@/lib/pending';
import { LABS_PROPOSALS_REPO } from '@/lib/site';
import { ArrowRight, ArrowUpRight, GitPullRequest } from 'lucide-react';

const pending = getPending();
const crumbs = [{ name: 'Proposals', href: '/proposals/' }];
const description =
  'LinuxServer Labs images in review: apps a team member has tried from their proposal and put forward, each with a pull request holding the image and its test report.';
---

<Layout section="proposals" title="Proposals" description={description} breadcrumbs={crumbs}>
  <PageHeader eyebrow="Proposals" title="Apps on their way into Labs" crumbs={crumbs}>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted-foreground">
      Every Labs image starts as a proposal on GitHub. A workflow checks it against the bar, a team member tries it in a sandbox, and the ones that work get
      a repository and a first pull request that holds the image. Those are the images in review below: pull one, run it and say how it went on its pull
      request.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase('/propose/')} class="inline-flex h-11 items-center gap-2 rounded-md bg-foreground px-5 font-medium text-background hover:opacity-90">
        Propose an app <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>
  </PageHeader>

  <section class="raft-container pt-16" aria-labelledby="pending">
    <SectionHead
      eyebrow="In review"
      title={pending.length === 0 ? 'Images in review' : pending.length === 1 ? 'One image in review' : `${pending.length} images in review`}
      id="pending"
      description="A team member tried each of these from its proposal and put it forward. Its first pull request holds the image, with the build's test report, screenshots and a pull command for the team to review."
    />
    {
      pending.length ? (
        <ul class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
          {pending.map((p) => (
            <li class="raft-panel flex flex-col gap-3 p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <p class="font-mono text-base font-semibold">{p.name}</p>
                <span class="rounded-md border border-[var(--raft-amber)]/35 px-1.5 font-mono text-[0.6875rem] text-[var(--raft-amber)]">in review</span>
              </div>
              {p.description && <p class="text-sm text-muted-foreground">{p.description}</p>}
              {p.pull ? (
                <p class="text-sm">
                  <a href={p.pull.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:decoration-current">
                    <GitPullRequest className="size-4 shrink-0" aria-hidden="true" />
                    <span class="[overflow-wrap:anywhere]">#{p.pull.number} {p.pull.title}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                  <span class="mt-1 block font-mono text-[0.6875rem] text-muted-foreground">
                    {p.pull.author ? `by ${p.pull.author}, ` : ''}opened <time datetime={p.pull.created_at}>{formatDate(p.pull.created_at)}</time>
                  </span>
                </p>
              ) : (
                <p class="text-sm text-muted-foreground">The pull request with the image is not open yet.</p>
              )}
              <a href={p.url} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground">
                {p.repo.split('/').pop()} on GitHub <ArrowUpRight className="size-3.5" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="raft-panel mt-8 p-5 text-muted-foreground">Nothing is in review right now.</p>
      )
    }
  </section>

  <Proposals client:idle repo={LABS_PROPOSALS_REPO} fallback={`${CONTROL_URL}/issues`} />

  <section class="raft-container pt-16" aria-labelledby="how">
    <div class="raft-panel flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-2xl">
        <h2 id="how" class="font-semibold">How a proposal becomes an image</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          What qualifies and why, building your app's image locally first, using the harness with an AI agent, and every step from the form to a published
          image.
        </p>
      </div>
      <a href={withBase('/propose/')} class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium hover:text-primary">
        Read the guide <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>
  </section>
</Layout>
