---
/**
 * The Labs site's guide to getting an app into Labs (workspace docs/labs.md): what Labs is, what qualifies and why,
 * proving the image locally with docker-template, the harness, the proposal form, what happens after, contributing,
 * staying and graduating. The text is Markdown (`components/labs/propose.md`), so it reads and renders like the docs.
 * Labs only: the main site's build replaces this route with a redirect to the Labs site's (astro.config.mjs), and its
 * contribute pages link here.
 */
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostBody from '@/components/PostBody.astro';
import { Content, getHeadings } from '@/components/labs/propose.md';
import { withBase } from '@/lib/base';
import { HARNESS_REPO } from '@/lib/contribute';
import { LABS_PROPOSE_URL } from '@/lib/site';
import { ArrowRight, ArrowUpRight, GitPullRequest } from 'lucide-react';

const crumbs = [{ name: 'Propose an app', href: '/propose/' }];
const title = 'Get your app into Labs';
const description =
  'How an open-source, self-hosted app becomes a LinuxServer Labs image: what qualifies and why, how to prove it works locally, using the harness with an AI agent, the proposal form, and what happens after.';
const toc = getHeadings().filter((h) => h.depth === 2 || h.depth === 3);
const sections = toc.filter((h) => h.depth === 2);
---

<Layout section="propose" title={title} description={description} breadcrumbs={crumbs}>
  <PageHeader eyebrow="Propose an app" title={title} crumbs={crumbs}>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted-foreground">
      Labs publishes container images of open-source, self-hosted software that is new or not yet well known, on the LinuxServer.io pipeline. This page is
      the whole process: what qualifies and why, how to prove your app works in a container on your own machine, how an AI agent can help, and what happens
      from the proposal to a published image.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={LABS_PROPOSE_URL} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-md bg-foreground px-5 font-medium text-background hover:opacity-90">
        <GitPullRequest className="size-4" aria-hidden="true" /> Open the proposal form <span class="sr-only">(opens in a new tab)</span>
      </a>
      <a href="#what-qualifies" class="inline-flex h-11 items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] bg-background/60 px-5 font-medium backdrop-blur hover:bg-muted">
        Check what qualifies <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>
  </PageHeader>

  <div class="raft-container pt-10 lg:pt-12">
    <div class="grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,1fr)_15rem] xl:gap-14">
      <div class="min-w-0">
        <details class="raft-panel group p-2 xl:hidden">
          <summary class="cursor-pointer list-none rounded-md px-2.5 py-1.5 text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="inline-flex items-center gap-2">
              <ArrowRight className="size-3.5 transition-transform group-open:rotate-90" aria-hidden="true" />
              On this page
            </span>
          </summary>
          <nav aria-label="On this page (sections)" class="mt-2 border-t border-[var(--raft-hair)] pt-2">
            <ol class="space-y-0.5">
              {
                sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="block rounded-md px-2.5 py-1.5 text-sm text-muted-foreground hover:bg-muted hover:text-foreground">
                      {h.text}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </details>

        <article class="mt-8 w-full max-w-[46rem] min-w-0 xl:mt-0">
          <PostBody>
            <Content />
          </PostBody>
        </article>

        <section class="raft-panel mt-14 max-w-[46rem] p-6 md:p-8" aria-labelledby="ready">
          <h2 id="ready" class="text-xl font-semibold tracking-tight">Ready?</h2>
          <p class="mt-2 text-muted-foreground">
            File the proposal, or start the harness and let an agent check the bar and fill the form in with you. Proposals already in review are on the
            <a href={withBase('/proposals/')} class="font-medium text-foreground underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:decoration-current">Proposals page</a>.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={LABS_PROPOSE_URL} target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 rounded-md bg-foreground px-4 text-sm font-medium text-background hover:opacity-90">
              <GitPullRequest className="size-4" aria-hidden="true" /> Open the proposal form <span class="sr-only">(opens in a new tab)</span>
            </a>
            <a href={HARNESS_REPO} target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] px-4 text-sm font-medium hover:bg-muted">
              The harness <ArrowUpRight className="size-4" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
            </a>
            <a href="https://github.com/linuxserverlabs-playground/docker-template" target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] px-4 text-sm font-medium hover:bg-muted">
              docker-template <ArrowUpRight className="size-4" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        </section>
      </div>

      <aside aria-label="On this page" class="hidden xl:block xl:sticky xl:top-20 xl:max-h-[calc(100dvh-6rem)] xl:self-start xl:overflow-y-auto">
        <nav aria-labelledby="toc-title">
          <h2 id="toc-title" class="raft-eyebrow">On this page</h2>
          <ol class="mt-3 space-y-1.5 border-l border-[var(--raft-hair)] text-sm">
            {
              toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class:list={['-ml-px block border-l border-transparent py-0.5 text-muted-foreground hover:border-primary hover:text-foreground', h.depth === 3 ? 'pl-6' : 'pl-3']}>
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>
    </div>
  </div>
</Layout>
