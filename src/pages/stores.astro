---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CopyButton from '@/components/islands/CopyButton';
import { withBase } from '@/lib/base';
import { getStores } from '@/lib/fleet';
import { formatDate } from '@/lib/format';
import { hubApi } from '@/lib/hub';
import { SNAPSHOT_DATE } from '@/lib/images';
import { ArrowUpRight } from 'lucide-react';

const stores = getStores();

/** The six app stores, in this order, with the steps the hub's one-line how-to doesn't carry. */
const GUIDE: Record<string, { title: string; action: string; steps: string[] }> = {
  unraid: {
    title: 'Unraid',
    action: 'Open the template repository',
    steps: [
      'Community Applications lists template repositories once its moderators have added them; until this one is, use a template by hand.',
      "Copy the image's <name>.xml from the repository into /boot/config/plugins/dockerMan/templates-user/ on the flash drive.",
      'Docker → Add Container → Template: pick it. Its TemplateURL points back at the repository, so updates follow.',
    ],
  },
  portainer: {
    title: 'Portainer',
    action: 'Open templates.json',
    steps: ['Settings → App Templates → URL: paste the templates.json URL and save.', 'App Templates lists every image as a container template.', 'Edit the volume paths and environment before deploying.'],
  },
  casaos: {
    title: 'CasaOS',
    action: 'Download linuxserver.zip',
    steps: ['App Store → More apps → Add source: paste the linuxserver.zip URL.', 'The store shows one app per image with its compose file.', 'Install, then adjust volumes in the app settings.'],
  },
  umbrel: {
    title: 'Umbrel',
    action: 'Open the store repository',
    steps: ['App Store → Community App Stores: add the repository URL.', 'The store appears as LinuxServer.io (id lsio); each app is lsio-<image>.', 'Data lives under the app data directory Umbrel manages.'],
  },
  runtipi: {
    title: 'Runtipi',
    action: 'Open the store repository',
    steps: ['Settings → App Stores → Add App Store: paste the repository URL.', 'Each image is an app with its description page and compose file.', 'Runtipi wants logo files; some clients show a placeholder for these.'],
  },
  cosmos: {
    title: 'Cosmos Cloud',
    action: 'Open index.json',
    steps: ['Market → Sources: add the index.json URL.', 'Every image is a ServApp with its description and compose file.', 'Install from the market like any other source.'],
  },
  arcane: {
    title: 'Arcane',
    action: 'Open registry.json',
    steps: [
      'Customization → Templates → Add Registry: paste the registry.json URL.',
      'Every image is a template with a compose file and an env file holding its paths, ports and settings.',
      'Edit the values before deploying; each template links back to its image page.',
    ],
  },
};
const list = Object.keys(GUIDE)
  .map((p) => stores.find((s) => s.platform === p))
  .filter((s): s is NonNullable<typeof s> => !!s);
const crumbs = [{ name: 'Stores', href: '/stores/' }];
---

<Layout
  section="stores"
  title="App stores"
  description="Add every LinuxServer.io image to Unraid, Portainer, CasaOS, Umbrel, Runtipi, Cosmos Cloud or Arcane. One URL per store."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Stores"
    title="One manifest, every app store"
    lede="The hub generates the store template for each platform from the same image manifest that builds the image, so every store gets the same parameters, the same defaults and the same update the moment a release lands."
    crumbs={crumbs}
  >
    <p class="mt-6 font-mono text-xs text-muted-foreground">
      From <a href={hubApi('stores/index.json')} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">api/v1/stores/index.json</a> · <time datetime={SNAPSHOT_DATE.toISOString()}>{formatDate(SNAPSHOT_DATE)}</time>
    </p>
  </PageHeader>

  <div class="raft-container pt-10">
    <ul class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {
        list.map((s) => {
          const g = GUIDE[s.platform]!;
          return (
            <li class="raft-panel flex flex-col p-5" id={s.platform}>
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-semibold">{g.title}</h2>
              </div>
              <p class="mt-1 text-sm text-muted-foreground">{s.name}</p>
              <div class="mt-4 flex items-center gap-2 rounded-md border border-[var(--raft-hair)] bg-[var(--raft-code-bg)] py-1 pr-1 pl-3 font-mono text-xs">
                <span class="min-w-0 flex-1 truncate" title={s.url}>{s.url.replace(/^https?:\/\//, '')}</span>
                <CopyButton client:visible text={s.url} label={`Copy ${s.name} URL`} />
              </div>
              <p class="mt-3 text-sm">{s.how_to}</p>
              <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-muted-foreground">
                {g.steps.map((step) => <li>{step}</li>)}
              </ol>
              <a href={s.url} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium hover:text-primary">
                {g.action} <ArrowUpRight className="size-3.5" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-8 text-sm text-muted-foreground">
      Looking for one image? Its page has an "Install on…" row with the file for each platform, including Docker Compose, Kubernetes, Podman quadlets and the SWAG proxy conf, and the <a href={withBase('/images/')} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">catalogue</a> lists them all.
    </p>
  </div>
</Layout>
