---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CopyButton from '@/components/islands/CopyButton';
import { withBase } from '@/lib/base';
import { getStores } from '@/lib/fleet';
import { formatDate } from '@/lib/format';
import { hubApi, HUB_URL } from '@/lib/hub';
import { SNAPSHOT_DATE } from '@/lib/images';
import { ArrowUpRight } from 'lucide-react';

const stores = getStores();

/** Platform-specific detail that the one-line how-to from the hub doesn't carry. */
const GUIDE: Record<string, { title: string; steps: string[]; note?: string }> = {
  unraid: {
    title: 'Unraid',
    steps: ['Community Applications reads the templates from the stores repository, one XML per image.', 'Search for the image in Apps; the LinuxServer.io template appears with its icon, WebUI and defaults.', 'Images marked deprecated live in deprecated/ and are hidden by default.'],
  },
  portainer: {
    title: 'Portainer',
    steps: ['Settings → App Templates → URL: paste the templates.json link.', 'Save, then open App Templates: every image is a type 1 (container) template.', 'Edit the volume paths and environment before deploying.'],
  },
  casaos: {
    title: 'CasaOS',
    steps: ['App Store → More apps → Add source: paste the linuxserver.zip link.', 'The store shows one app per image with its compose file and x-casaos metadata.', 'Install, then adjust volumes in the app settings.'],
  },
  umbrel: {
    title: 'Umbrel',
    steps: ['App Store → Community App Stores → add the stores repository URL (the umbrel/ folder is the store, id lsio).', 'Each app is lsio-<image> with its umbrel-app.yml and a compose file wired to app_proxy.', 'Data lives under APP_DATA_DIR as set by Umbrel.'],
  },
  runtipi: {
    title: 'Runtipi',
    steps: ['Settings → App Stores → add the stores repository (runtipi/ folder).', 'Each app has config.json, a compose file with x-runtipi (schema version 2) and a description page.', 'Logos are referenced by URL (logo_url); Runtipi normally wants a file, so some clients show a placeholder.'],
  },
  cosmos: {
    title: 'Cosmos Cloud',
    steps: ['Market → Sources → add the index.json link.', 'Every image is a ServApp with its description and cosmos-compose.json.', 'Matches the community source format fetched on 2026-10-24.'],
  },
  proxy: {
    title: 'SWAG proxy confs',
    steps: ['Pick the sample for your app: <name>.subdomain.conf.sample (recommended) or <name>.subfolder.conf.sample.', 'Copy it into /config/nginx/proxy-confs/ without the .sample suffix and restart SWAG.', 'The container name must match the sample and both containers must share a Docker network.'],
    note: 'Every image page shows its generated sample inline.',
  },
  kubernetes: {
    title: 'Kubernetes',
    steps: ['kubectl apply -f <url>/<name>.yaml after reviewing storage sizes (placeholders) and secrets.', 'Each manifest has a ConfigMap, a PVC per persistent volume, a Deployment or StatefulSet and a Service.', 'Security notes (read-only root, non-root) are comments at the top of the file.'],
  },
  quadlet: {
    title: 'Podman quadlets',
    steps: ['Copy <name>.container to ~/.config/containers/systemd/ (or /etc/containers/systemd/ for root).', 'systemctl --user daemon-reload, then systemctl --user start <name>.', 'Optional parameters are present as comments to uncomment.'],
  },
  docs: {
    title: 'Documentation pages',
    steps: ['The hub renders docs.linuxserver.io image pages from the same manifest.', 'The docs repository copies images/*.md into its docs/images/ folder.'],
  },
  mods: {
    title: 'Legacy mod list',
    steps: ['The legacy mod-list.yml shape, for tools that still read it.', 'Prefer the structured /api/v1/mods.json, which this site uses for its Mods page.'],
  },
  builds: {
    title: 'CI build reports',
    steps: ['One page per build at /builds/<image>/<tag>/ with the per-arch test table, screenshot and logs.', 'This site links there from every build page.'],
  },
};
const ordered = ['unraid', 'portainer', 'casaos', 'umbrel', 'runtipi', 'cosmos', 'proxy', 'kubernetes', 'quadlet', 'docs', 'mods', 'builds'];
const list = ordered.map((p) => stores.find((s) => s.platform === p)).filter((s): s is NonNullable<typeof s> => !!s);
const extra = stores.filter((s) => !ordered.includes(s.platform));
const crumbs = [{ name: 'Stores', href: '/stores/' }];
---

<Layout
  section="stores"
  title="App stores"
  description="Import every LinuxServer.io image into Unraid, Portainer, CasaOS, Umbrel, Runtipi or Cosmos, or take the generated Kubernetes manifests, Podman quadlets and SWAG proxy confs. One URL per platform."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Stores"
    title="One manifest, every app store"
    lede="The hub generates the store template for each platform from the same image manifest that builds the image, so every store gets the same parameters, the same defaults and the same update the moment a release lands."
    crumbs={crumbs}
  >
    <p class="mt-6 font-mono text-xs text-muted-foreground">
      From <a href={hubApi('stores/index.json')} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">api/v1/stores/index.json</a> · <time datetime={SNAPSHOT_DATE.toISOString()}>{formatDate(SNAPSHOT_DATE)}</time>
    </p>
  </PageHeader>

  <div class="raft-container pt-10">
    <ul class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {
        [...list, ...extra].map((s) => {
          const g = GUIDE[s.platform];
          return (
            <li class="raft-panel flex flex-col p-5" id={s.platform}>
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-semibold">{g?.title ?? s.name}</h2>
                <span class="shrink-0 font-mono text-[0.6875rem] text-muted-foreground">{s.platform}</span>
              </div>
              <p class="mt-1 text-sm text-muted-foreground">{s.name}</p>
              <div class="mt-4 flex items-center gap-2 rounded-md border border-[var(--raft-hair)] bg-[var(--raft-code-bg)] py-1 pr-1 pl-3 font-mono text-xs">
                <span class="min-w-0 flex-1 truncate" title={s.url}>{s.url.replace(/^https?:\/\//, '')}</span>
                <CopyButton client:visible text={s.url} label={`Copy ${s.name} URL`} />
              </div>
              <p class="mt-3 text-sm">{s.how_to}</p>
              {g && (
                <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-muted-foreground">
                  {g.steps.map((step) => <li>{step}</li>)}
                </ol>
              )}
              {g?.note && <p class="mt-2 text-xs text-muted-foreground">{g.note}</p>}
              <a href={s.url} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium hover:text-primary">
                Open <ArrowUpRight className="size-3.5" aria-hidden="true" /><span class="sr-only">{s.name} (opens in a new tab)</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-8 text-sm text-muted-foreground">
      Looking for one image? Its page has an "Install on…" row with the per-image file for each platform, and the <a href={withBase('/images/')} class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">catalogue</a> lists them all.
      The generated output is also pushed to the <a href="https://github.com/linuxserver-playground/stores" class="underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">stores repository</a> for platforms that clone git, and the whole tree is browsable at <a href={`${HUB_URL}/stores/`} class="font-mono underline underline-offset-4 decoration-[var(--raft-hair-strong)] hover:text-foreground hover:decoration-current">{HUB_URL.replace('https://', '')}/stores/</a>.
    </p>
  </div>
</Layout>
